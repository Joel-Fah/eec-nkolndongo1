# Pexels placeholders with people: dev-only, never committed or deployed (scripts/pexels/import.ts)
apps/web/public/placeholders/

# Storyset illustrations: licence forbids redistributing the files (decision 0024) — fetched by pnpm illos:fetch
apps/web/public/illustrations/
apps/admin/public/illustrations/

# Shared + module messages merged before compiling (packages/i18n/src/merge.ts)
packages/i18n/messages/merged/
docs/content/PENDING.md
