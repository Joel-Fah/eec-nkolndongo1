{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "root": true,
  "extends": ["./packages/config/biome.json"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/src/paraglide",
      "!**/routeTree.gen.ts",
      "!**/worker-configuration.d.ts",
      "!packages/ui/fonts",
      "!packages/ui/brand/**/*.svg",
      "!packages/ui/illustrations/**/*.svg"
    ]
  }
}
