---
/**
 * Verse — our way to show a quotation, a verse, a testimony.
 * A soft rounded panel with an oversized gold opening mark peeking out of its corner, the words in
 * Fraunces italic, and the reference in a small rounded tag. No side rule, no one-sided border.
 */
interface Props {
  /** Opening mark: « for French, “ for English. */
  mark?: string
  /** Reference: « Matthieu 11 : 28 », a name, a place. */
  cite?: string
  class?: string
}
const { mark = '«', cite, class: className } = Astro.props
---

<figure class:list={['eec-verse', className]}>
  <span class="eec-verse-mark" aria-hidden="true">{mark}</span>
  <blockquote class="eec-verse-text"><slot /></blockquote>
  {cite && <figcaption class="eec-verse-ref">{cite}</figcaption>}
</figure>

<style is:global>
  .eec-verse {
    position: relative;
    display: grid;
    gap: 1rem;
    justify-items: start;
    padding: 2.25rem 1.5rem 1.5rem;
    border-radius: var(--radius-xl);
    background: var(--gold-soft);
    color: var(--ink);
    isolation: isolate;
  }
  .eec-verse-mark {
    position: absolute;
    inset-block-start: -0.35em;
    inset-inline-start: 0.7rem;
    z-index: -1;
    font-family: var(--font-display);
    font-size: 6.5rem;
    font-weight: 600;
    line-height: 1;
    color: var(--gold);
    pointer-events: none;
    user-select: none;
  }
  .eec-verse-text {
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: var(--text-xl);
    line-height: 1.35;
    text-wrap: pretty;
  }
  .eec-verse-ref {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    padding-inline: 0.625rem;
    border-radius: var(--radius-xs);
    background: var(--surface);
    color: var(--gold-ink);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.01em;
  }
</style>
