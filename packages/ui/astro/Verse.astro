---
/**
 * Verse — our way to show a quotation, a verse, a testimony.
 * A soft rounded panel framed all the way round by a dotted ornament border (the ornament's dots), with a
 * wave on the bottom edge; the gold opening mark sits inside, top-left; the words in Fraunces italic; the
 * reference in a small rounded tag. A complete frame — never a side rule.
 */
interface Props {
  /** Opening mark: « for French, “ for English. */
  mark?: string
  /** Reference: « Matthieu 11 : 28 », a name, a place. */
  cite?: string
  class?: string
}
const { mark = '«', cite, class: className } = Astro.props
---

<figure class:list={['eec-verse', className]}>
  <svg class="eec-verse-frame" aria-hidden="true" focusable="false"><rect x="1.5" y="1.5" rx="26" /></svg>
  <svg class="eec-verse-wave" viewBox="0 0 132 16" width="132" height="16" fill="none" aria-hidden="true" focusable="false">
    <circle cx="6" cy="8" r="2.5" fill="currentColor" />
    <path d="M18 8c9-9 16 9 25 0s16 9 25 0 16 9 25 0 12 4 21 0" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
    <circle cx="126" cy="8" r="2.5" fill="currentColor" />
  </svg>
  <span class="eec-verse-mark" aria-hidden="true">{mark}</span>
  <blockquote class="eec-verse-text"><slot /></blockquote>
  {cite && <figcaption class="eec-verse-ref">{cite}</figcaption>}
</figure>

<style is:global>
  .eec-verse {
    position: relative;
    display: grid;
    gap: 0.75rem;
    justify-items: start;
    padding: 1.5rem 2rem 1.75rem;
    border-radius: var(--radius-xl);
    background: var(--gold-soft);
    color: var(--ink);
  }
  .eec-verse-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .eec-verse-frame rect {
    width: calc(100% - 3px);
    height: calc(100% - 3px);
    fill: none;
    stroke: var(--gold);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-dasharray: 0.1 10;
  }
  .eec-verse-wave {
    position: absolute;
    inset-block-end: -8px;
    inset-inline-start: 50%;
    translate: -50% 0;
    padding-inline: 0.5rem;
    background: var(--bg);
    color: var(--gold);
    box-sizing: content-box;
    pointer-events: none;
  }
  .eec-verse-mark {
    font-family: var(--font-display);
    font-size: 4.5rem;
    font-weight: 600;
    line-height: 0.7;
    height: 2.25rem;
    color: var(--gold);
    pointer-events: none;
    user-select: none;
  }
  .eec-verse-text {
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: var(--text-xl);
    line-height: 1.35;
    text-wrap: pretty;
  }
  .eec-verse-ref {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    padding-inline: 0.625rem;
    border-radius: var(--radius-xs);
    background: var(--surface);
    color: var(--gold-ink);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.01em;
  }
</style>
