---
/**
 * Horizontal lockup: the EEC mark + the parish name, in live text (Fraunces).
 *   one    → mark + « EEC NKOLNDONGO 1 » (single line, tightest spaces)
 *   two    → mark + « EEC » / « Paroisse de Nkolndongo 1 »
 *   three  → mark + « EEC » / « Paroisse de » / « Nkolndongo 1 »  (smaller spaces)
 *   auto   → three in narrow slots, two from 15 rem wide (container query)
 * "EEC" stays abbreviated in every variant. The slot (parent) sets the width; the font-size sets the
 * scale. Clear space is the caller's job. Mark ≥ 24 px tall.
 */
import Mark from './Mark.astro'

interface Props {
  variant?: 'auto' | 'one' | 'two' | 'three'
  /** Mark variant: `halo` on dark backgrounds, `mono` for one colour. */
  mark?: 'mark' | 'halo' | 'mono'
  /** Localised text (FR/EN), from packages/i18n — the lockup itself has no strings. */
  one: string
  eec: string
  parish: string
  parishLead: string
  parishPlace: string
  class?: string
}

const {
  variant = 'auto',
  mark = 'mark',
  one,
  eec,
  parish,
  parishLead,
  parishPlace,
  class: className,
} = Astro.props
---

<span class:list={['eec-lockup', className]} data-variant={variant}>
  <Mark variant={mark} class="eec-lockup-mark" />
  <span class="eec-lockup-one">{one}</span>
  <span class="eec-lockup-two">
    <span class="eec-lockup-eec">{eec}</span>
    <span class="eec-lockup-parish">{parish}</span>
  </span>
  <span class="eec-lockup-three">
    <span class="eec-lockup-eec">{eec}</span>
    <span class="eec-lockup-parish">{parishLead}</span>
    <span class="eec-lockup-parish eec-lockup-place">{parishPlace}</span>
  </span>
</span>

<style is:global>
  .eec-lockup {
    container-type: inline-size;
    /* Size containment: needs a width. Fill the slot the caller gives it. */
    width: 100%;
    display: flex;
    align-items: center;
    gap: 0.7em;
    min-width: 0;
    font-family: var(--font-display);
    color: inherit;
    --lockup-mark: 2.7em;
  }
  .eec-lockup-mark {
    flex: none;
    width: auto;
    height: var(--lockup-mark);
  }
  .eec-lockup-one {
    font-size: 1.1em;
    font-weight: 600;
    letter-spacing: 0.03em;
    line-height: 1;
    min-width: 0;
    text-wrap: balance;
  }
  .eec-lockup-two,
  .eec-lockup-three {
    display: grid;
    gap: 0.04em;
    min-width: 0;
    line-height: 1.05;
  }
  .eec-lockup-eec {
    font-size: 1.3em;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .eec-lockup-parish {
    font-size: 0.98em;
    font-weight: 500;
    min-width: 0;
  }
  .eec-lockup-three .eec-lockup-eec {
    font-size: 1.15em;
  }
  .eec-lockup-three .eec-lockup-parish {
    font-size: 0.8em;
    color: var(--ink-muted);
  }
  .eec-lockup-three .eec-lockup-place {
    font-size: 1em;
    font-weight: 600;
    color: inherit;
  }

  .eec-lockup[data-variant="one"] :is(.eec-lockup-two, .eec-lockup-three),
  .eec-lockup[data-variant="two"] :is(.eec-lockup-one, .eec-lockup-three),
  .eec-lockup[data-variant="three"] :is(.eec-lockup-one, .eec-lockup-two),
  .eec-lockup[data-variant="auto"] :is(.eec-lockup-one, .eec-lockup-two) {
    display: none;
  }
  @container (min-width: 15rem) {
    .eec-lockup[data-variant="auto"] .eec-lockup-three {
      display: none;
    }
    .eec-lockup[data-variant="auto"] .eec-lockup-two {
      display: grid;
    }
  }
</style>
