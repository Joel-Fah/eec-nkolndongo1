---
/**
 * Segmented choice between a few views of the same page (paper size, list / grid…). Each option is a link, so it works without
 * JavaScript and the choice lives in the address. Same look as the admin's segmented switch: a tinted track, the chosen one raised.
 */
interface Props {
  label: string
  current: string
  options: { value: string; label: string; href: string }[]
}
const { label, current, options } = Astro.props
---

<nav class="segmented" aria-label={label}>
  {
    options.map((o) => (
      <a href={o.href} class="segmented-btn" aria-current={o.value === current ? 'true' : undefined}>
        {o.label}
      </a>
    ))
  }
</nav>

<style>
  .segmented {
    display: inline-flex;
    gap: 0.125rem;
    padding: 0.25rem;
    border-radius: var(--radius-lg);
    background: var(--surface-2);
  }
  .segmented-btn {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 1rem;
    border-radius: var(--radius-md);
    color: var(--ink);
    text-decoration: none;
    transition:
      background var(--dur-ui, 0.28s) var(--ease-out, ease),
      box-shadow var(--dur-ui, 0.28s) var(--ease-out, ease);
  }
  .segmented-btn:hover {
    background: var(--surface);
  }
  .segmented-btn[aria-current='true'] {
    background: var(--surface);
    box-shadow: var(--elevation-1);
    font-weight: 600;
  }
  @media (prefers-reduced-motion: reduce) {
    .segmented-btn {
      transition: none;
    }
  }
</style>
