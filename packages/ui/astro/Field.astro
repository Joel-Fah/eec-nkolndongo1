---
import type { IconName } from '../src/icons.ts'
import Icon from './Icon.astro'
import Select from './Select.astro'

/**
 * Label + control + hint + error. `kind`: input | textarea | select (custom list, see Select.astro).
 * Pass `options` for a select. Pass localised strings.
 */
interface Props {
  id: string
  label: string
  kind?: 'input' | 'textarea' | 'select'
  type?: string
  name?: string
  hint?: string
  error?: string
  required?: boolean
  disabled?: boolean
  /** Required: an example of the expected answer, never a repeat of the label. */
  placeholder: string
  value?: string
  rows?: number
  autocomplete?: string
  /** For kind="select". */
  options?: { value: string; label: string }[]
  /** An icon inside the field, at the start. */
  icon?: IconName
  /** For type="password": labels of the show/hide eye button. */
  toggle?: { show: string; hide: string }
}
const {
  id,
  label,
  kind = 'input',
  type = 'text',
  name = id,
  hint,
  error,
  required,
  disabled,
  placeholder,
  value,
  rows,
  autocomplete,
  options = [],
  icon,
  toggle,
} = Astro.props
const eye = type === 'password' && !!toggle
const inset = !!icon || eye
const describedby =
  [hint && `${id}-hint`, error && `${id}-error`].filter(Boolean).join(' ') || undefined
const common = {
  id,
  name,
  required,
  disabled,
  'aria-invalid': error ? 'true' : undefined,
  'aria-describedby': describedby,
}
---

<div class="field">
  <label class="field-label" for={id}>{label}{required && <span aria-hidden="true"> *</span>}</label>
  {
    kind === 'textarea' ? (
      <textarea class="textarea" rows={rows} placeholder={placeholder} {...common}>{value}</textarea>
    ) : kind === 'select' ? (
      <Select id={id} name={name} options={options} value={value} placeholder={placeholder} disabled={disabled} invalid={!!error} describedby={describedby} />
    ) : (
      inset ? (
        <div class="input-wrap">
          {icon && <span class="input-icon" aria-hidden="true"><Icon name={icon} size={20} /></span>}
          <input class="input" type={type} placeholder={placeholder} value={value} autocomplete={autocomplete} data-icon={icon ? '' : undefined} data-end={eye ? '' : undefined} {...common} />
          {eye && toggle && (
            <button type="button" class="input-end input-toggle" data-pw-toggle={id} data-show={toggle.show} data-hide={toggle.hide} aria-label={toggle.show} aria-pressed="false">
              <span class="pw-eye"><Icon name="eye" size={20} /></span>
              <span class="pw-eye-off"><Icon name="eyeOff" size={20} /></span>
            </button>
          )}
        </div>
      ) : (
        <input class="input" type={type} placeholder={placeholder} value={value} autocomplete={autocomplete} {...common} />
      )
    )
  }
  {hint && <p class="field-hint" id={`${id}-hint`}>{hint}</p>}
  {error && <p class="field-error" id={`${id}-error`} role="alert"><span aria-hidden="true">⚠</span>{error}</p>}
</div>
