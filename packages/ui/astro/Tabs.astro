---
/** Tabs: pass `tabs` ({id,label}); panels go in named slots matching each id. Arrow keys, Home/End. */
interface Props {
  id: string
  label: string
  tabs: { id: string; label: string }[]
}
const { id, label, tabs } = Astro.props
---

<div>
  <div class="tabs-list" role="tablist" aria-label={label}>
    <span class="tabs-indicator" aria-hidden="true"></span>
    {tabs.map((tab, i) => <button type="button" class="tab" role="tab" id={`${id}-${tab.id}-tab`} aria-controls={`${id}-${tab.id}`} aria-selected={i === 0} tabindex={i === 0 ? 0 : -1}>{tab.label}</button>)}
  </div>
  {tabs.map((tab, i) => <div class="tab-panel" role="tabpanel" id={`${id}-${tab.id}`} aria-labelledby={`${id}-${tab.id}-tab`} hidden={i !== 0} tabindex="0"><slot name={tab.id} /></div>)}
</div>
