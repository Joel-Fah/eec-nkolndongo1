---
/**
 * A Storyset (Cuate) illustration, recoloured to our palette (decision 0024). Two files per illustration,
 * light and dark, fetched by `pnpm illos:fetch` into /illustrations/ (never committed: licence). Only the
 * one for the current theme is displayed, and `loading="lazy"` means a hidden one is never downloaded.
 * Decorative unless `title` is given. No idle animation: movement, if any, comes from the container.
 */
import manifest from '../illustrations/storyset.json'

interface Props {
  name: string
  title?: string
  class?: string
  /** Above the fold: load at once. */
  eager?: boolean
}
const { name, title, class: className, eager = false } = Astro.props
if (!manifest.some((m) => m.name === name))
  throw new Error(`Unknown illustration: ${name} (packages/ui/illustrations/storyset.json)`)
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const loading = eager ? 'eager' : 'lazy'
---

<span class:list={['illo', className]} role={title ? 'img' : undefined} aria-label={title} aria-hidden={title ? undefined : 'true'}>
  <img class="illo-light" src={`${base}/illustrations/${name}-light.svg`} alt="" width="500" height="500" loading={loading} decoding="async" />
  <img class="illo-dark" src={`${base}/illustrations/${name}-dark.svg`} alt="" width="500" height="500" loading={loading} decoding="async" />
</span>
