---
/**
 * Inline illustration from packages/ui/illustrations. Ids become `data-part` attributes (unique
 * per page, still targetable by GSAP). Decorative unless `title` is given.
 */
const files = import.meta.glob<string>('../illustrations/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
})

interface Props {
  name: string
  title?: string
  class?: string
  /** Opt in to the idle animation (apps/web/src/scripts/illustration-idle.ts). */
  animate?: boolean
}

const { name, title, class: className, animate = false } = Astro.props
const source = files[`../illustrations/${name}.svg`]
if (!source) throw new Error(`Unknown illustration: ${name}`)

const a11y = title ? 'role="img"' : 'aria-hidden="true" focusable="false"'
const svg = source
  .replace(/\sid="/g, ' data-part="')
  .replace(
    '<svg ',
    `<svg ${a11y} data-illustration="${name}"${animate ? ' data-animate' : ''}${className ? ` class="${className}"` : ''} `,
  )
  .replace(/(<svg[^>]*>)/, title ? `$1<title>${title}</title>` : '$1')
---

<Fragment set:html={svg} />
