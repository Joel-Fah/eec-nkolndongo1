{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eec-nkolndongo1",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Non-secret config. Secrets (AUTH_SECRET, DATABASE_URL_UNPOOLED, S3 keys) are set with
  // `wrangler secret put` or the dashboard — never here, never in git.
  "vars": { "APP_ORIGIN": "http://localhost:8080" }
}
