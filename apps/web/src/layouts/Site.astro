---
import { ClientRouter } from 'astro:transitions'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import SiteLockup from '../components/SiteLockup.astro'
import { alternates } from '../lib/nav'
import Base from './Base.astro'

interface Props {
  title: string
  description?: string
  noindex?: boolean
  image?: string
  imageAlt?: string
  type?: 'website' | 'article'
  /** The printed letterhead (mark + full names). Off for a page that prints its own inside a named @page. */
  letterhead?: boolean
}
const { title, description, noindex, image, imageAlt, type, letterhead = true } = Astro.props
---

<Base title={title} description={description} noindex={noindex} alternates={alternates(Astro.url.pathname)} image={image} imageAlt={imageAlt} type={type}>
  <Fragment slot="head">
    <ClientRouter />
    <slot name="head" />
  </Fragment>
  <Header />
  {
    letterhead && (
      <div class="print-letterhead" aria-hidden="true">
        <SiteLockup variant="two" class="text-[1.1rem]" />
      </div>
    )
  }
  <main id="main" class="page" tabindex="-1">
    <slot />
  </main>
  <Footer />
</Base>

<style is:global>
  /* Anything printed or saved as PDF carries the parish's mark and full names, and none of the site's navigation. */
  .print-letterhead {
    display: none;
  }
  @media print {
    .print-letterhead {
      display: block;
      width: min(100%, 26rem);
      margin: 0 0 1.25rem;
      color: #000;
    }
    .skip-link,
    .site-ribbon,
    .site-header,
    header.site-header,
    .site-cta,
    .site-footer,
    .site-playground,
    #mobile-menu,
    #search-dialog {
      display: none !important;
    }
  }
  /* Page turn: the old page slides away a little and fades, the new one arrives from the other side. */
  @keyframes eec-page-out {
    to {
      opacity: 0;
      transform: translateX(calc(var(--rise) * -2));
    }
  }
  @keyframes eec-page-in {
    from {
      opacity: 0;
      transform: translateX(calc(var(--rise) * 2));
    }
  }
  ::view-transition-old(root) {
    animation: eec-page-out var(--duration-micro) var(--ease-in-out) both;
  }
  ::view-transition-new(root) {
    animation: eec-page-in var(--duration-ui) var(--ease-out) both;
  }
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation-name: eec-fade;
      animation-duration: 0.12s;
    }
    @keyframes eec-fade {
      from {
        opacity: 0;
      }
    }
  }
  .page:focus {
    outline: none;
  }
</style>
