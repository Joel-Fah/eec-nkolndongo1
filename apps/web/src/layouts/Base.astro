---
import { getSeason } from '@eec/core'
import { locales } from '@eec/i18n'
import erode from '@eec/ui/fonts/fontshare/erode/Erode-Variable.woff2?url'
import switzer from '@eec/ui/fonts/fontshare/switzer/Switzer-Variable.woff2?url'
import '../styles.css'
import Preloader from '../components/Preloader.astro'
import { localeOf, useT } from '../lib/i18n'
import { themeHeadScript } from '../lib/theme'

interface Props {
  title: string
  description?: string
  noindex?: boolean
  /** Path of this page in each locale, for hreflang and the language switcher. */
  alternates?: Partial<Record<(typeof locales)[number], string>>
  season?: string
}

const { title, description, noindex: asked = false, alternates = {}, season } = Astro.props
// Until launch (SITE_INDEXABLE=1 at build time) nothing is indexable, and a small ribbon says so.
const launched = import.meta.env.PUBLIC_SITE_INDEXABLE === '1'
const noindex = asked || !launched
// Computed when the page is built; `moissons` will come from an admin-set range (Phase 02).
const currentSeason = season ?? getSeason()
const locale = localeOf(Astro.currentLocale)
const t = useT(locale)
const siteName = t('site.name')
const canonical = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang={locale} data-season={currentSeason}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline data-astro-rerun set:html={themeHeadScript} />
    <title>{title === siteName ? title : `${title} · ${siteName}`}</title>
    {description && <meta name="description" content={description} />}
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
    {
      Object.entries(alternates).map(([lang, path]) => (
        <link rel="alternate" hreflang={lang} href={new URL(path, Astro.site)} />
      ))
    }
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={switzer} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={erode} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body>
    <Preloader />
    <a class="skip-link" href="#main">{t('common.skip_to_content')}</a>
    <slot />
    {!launched && <p class="site-ribbon" role="note">{t('site.noindex_ribbon')}</p>}
    <script>
      import { initPrimitives } from '@eec/ui/primitives'
      initPrimitives()
    </script>
  </body>
</html>

<style>
  .site-ribbon {
    position: fixed;
    inset-block-end: 0.75rem;
    inset-inline-start: 0.75rem;
    z-index: 30;
    margin: 0;
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-md);
    background: var(--warning-soft);
    color: var(--warning);
    font-size: var(--text-xs);
    font-weight: 600;
    pointer-events: none;
  }
  .skip-link {
    position: absolute;
    inset-inline-start: 1rem;
    inset-block-start: -4rem;
    z-index: 100;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    background: var(--surface-raised);
    color: var(--ink);
    box-shadow: var(--elevation-2);
  }
  .skip-link:focus-visible {
    inset-block-start: 1rem;
  }
</style>
