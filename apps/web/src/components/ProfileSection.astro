---
/**
 * « Mon espace » → the profile: a completion card, the member card, and the full-profile panel (consent, optional details, a private
 * photo). Everything here is the signed-in person's own (decision 0047). Behaviour: scripts/profile.ts. Texts: member.profile.*.
 */
import Button from '@eec/ui/astro/Button.astro'
import Choice from '@eec/ui/astro/Choice.astro'
import Field from '@eec/ui/astro/Field.astro'
import Icon from '@eec/ui/astro/Icon.astro'
import Mark from '@eec/ui/astro/Mark.astro'
import { localeOf, useT } from '../lib/i18n'
import MemberCard from './MemberCard.astro'

const locale = localeOf(Astro.currentLocale)
const t = useT(locale)
const p = (key: string, vars?: Record<string, string>) =>
  t(`member.profile.${key}` as 'member.profile.title', vars)
const picker = (placeholder: string) =>
  JSON.stringify({
    open: t('picker.open'),
    prev: t('picker.prev'),
    next: t('picker.next'),
    today: t('picker.today'),
    clear: t('picker.clear'),
    chooseMonth: t('picker.choose_month'),
    chooseYear: t('picker.choose_year'),
    prevYears: t('picker.prev_years'),
    nextYears: t('picker.next_years'),
    hour: t('picker.hour'),
    minute: t('picker.minute'),
    done: t('picker.done'),
    placeholder,
  })
const messages = {
  progress: p('progress', { n: '{n}', total: '{total}' }),
  since: p('card_since', { year: '{year}' }),
  code: p('card_code', { code: '{code}' }),
  saved: p('msg_saved'),
  error: p('error'),
  withdrawn: p('withdrawn'),
  photoSaved: p('photo_saved'),
  photoErr: p('photo_err'),
  levelSaved: p('level_saved'),
  srcGoogle: p('photo_google'),
  srcUpload: p('photo_upload'),
  srcNone: p('photo_generated'),
  consentNeed: p('consent_need'),
}
const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Africa/Douala' }).format(new Date())
---

<div class="pf" data-profile data-msgs={JSON.stringify(messages)} data-today={today} data-lang={locale}>
  <!-- Completion: what is left, never a block -->
  <section class="pf-card" data-profile-card hidden aria-labelledby="pf-title" data-todo-title={p('title')} data-done-title={p('done_t')}>
    <div class="pf-card-head">
      <span class="pf-ico" aria-hidden="true"><Icon name="userRoundPlus" size={24} /></span>
      <div class="grid gap-1">
        <h3 id="pf-title" class="text-xl" data-pf-title>{p('title')}</h3>
        <p class="text-sm text-ink-muted" data-pf-lead>{p('lead')}</p>
      </div>
    </div>
    <div class="pf-bar" role="progressbar" aria-valuemin="0" aria-valuemax="6" data-pf-bar><span></span></div>
    <p class="text-sm text-ink-muted" data-pf-progress></p>
    <ol class="pf-steps">
      <li data-step="consent"><span class="pf-tick" aria-hidden="true"></span>{p('step_consent')}</li>
      <li data-step="details"><span class="pf-tick" aria-hidden="true"></span>{p('step_details')}</li>
      <li data-step="photo"><span class="pf-tick" aria-hidden="true"></span>{p('step_photo')}</li>
    </ol>
    <div><Button variant="secondary" data-pf-open>{p('cta')}</Button></div>
  </section>

  <!-- The member card: on screen only, no download -->
  <section class="pf-cardwrap" aria-labelledby="pf-card-t">
    <h3 id="pf-card-t" class="text-xl">{p('card_t')}</h3>
    <MemberCard label={p('card_label')} parish={t('site.parish')} />
    <p class="text-sm text-ink-muted">{p('card_note')}</p>
  </section>

  <details class="acct-panel" data-panel="fullprofile">
    <summary><span>{p('panel')}</span><span class="eec-chevron" aria-hidden="true"></span></summary>
    <div class="acct-fields">
      <!-- Without consent: what and why, then one unticked box -->
      <form data-pf-consent hidden class="acct-fields" novalidate>
        <p class="font-semibold">{p('consent_t')}</p>
        <ul class="pf-why">
          <li>{p('why_birth')}</li>
          <li>{p('why_gender')}</li>
          <li>{p('why_place')}</li>
          <li>{p('why_life')}</li>
        </ul>
        <Choice id="pf-consent" name="consent" label={p('consent_label')} />
        <p class="text-sm text-ink-muted">{p('consent_help')}</p>
        <p class="field-error" data-pf-consent-error hidden role="alert">{p('consent_need')}</p>
        <div><Button type="submit">{p('consent_go')}</Button></div>
      </form>

      <!-- With consent: the optional details, then the photo -->
      <div data-pf-body hidden class="acct-fields">
        <form data-pf-details class="acct-fields" novalidate>
          <label class="field">
            <span class="field-label">{p('birth')}</span>
            <input class="input" type="date" name="birthDate" max={today} min="1900-01-01" data-picker={picker(t('picker.date_ph'))} />
          </label>
          <Field id="pf-gender" kind="select" name="gender" label={p('gender')} placeholder={p('ph_select')} options={[{ value: 'woman', label: p('gender_woman') }, { value: 'man', label: p('gender_man') }]} />
          <Field id="pf-neighbourhood" name="neighbourhood" label={p('neighbourhood')} placeholder={p('ph_neighbourhood')} />
          <Field id="pf-city" name="city" label={p('city')} placeholder={p('ph_city')} />
          <Field id="pf-marital" kind="select" name="maritalStatus" label={p('marital')} placeholder={p('ph_select')} options={[{ value: 'single', label: p('marital_single') }, { value: 'married', label: p('marital_married') }, { value: 'widowed', label: p('marital_widowed') }, { value: 'divorced', label: p('marital_divorced') }]} />
          <Field id="pf-profession" name="profession" label={p('profession')} placeholder={p('ph_profession')} />
          <p class="acct-ok" data-pf-ok hidden role="status"></p>
          <div><Button type="submit" variant="secondary">{p('btn_save')}</Button></div>
        </form>

      </div>
        <div class="pf-photo" data-pf-photo hidden>
          <p class="font-semibold">{p('photo_t')}</p>
          <p class="text-sm text-ink-muted">{p('photo_p')}</p>
          <div class="pf-photo-row">
            <span class="pf-photo-preview" data-pf-preview aria-hidden="true"></span>
            <div class="grid gap-2">
              <input type="file" accept="image/*" hidden data-pf-file />
              <div class="acct-row">
                <Button variant="secondary" data-pf-choose><Icon name="imageUp" size={20} />{p('photo_choose')}</Button>
                <Button variant="ghost" data-pf-remove hidden data-label-delete={p('photo_remove')} data-label-back={p('photo_back_google')}>{p('photo_remove')}</Button>
              </div>
              <p class="text-sm text-ink-muted" data-pf-source></p>
            </div>
          </div>
          <fieldset class="pf-level" data-pf-level hidden>
            <legend class="field-label">{p('photo_level')}</legend>
            <Choice kind="radio" id="pf-level-private" name="photoLevel" value="private" label={p('level_private')} checked />
            <Choice kind="radio" id="pf-level-staff" name="photoLevel" value="staff" label={p('level_staff')} />
          </fieldset>
        </div>

        <div class="pf-withdraw" data-pf-withdraw-zone hidden>
          <Button variant="ghost" data-pf-withdraw>{p('withdraw')}</Button>
          <p class="text-sm text-ink-muted">{p('withdraw_help')}</p>
        </div>
    </div>
  </details>
</div>

<style is:global>
  .pf {
    display: grid;
    gap: 1.25rem;
  }
  .pf-card {
    display: grid;
    gap: 0.875rem;
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    background: color-mix(in oklab, var(--gold) 16%, var(--surface));
    box-shadow: var(--elevation-1);
  }
  .pf-card[data-state='done'] {
    background: color-mix(in oklab, var(--primary) 10%, var(--surface));
  }
  .pf-card-head {
    display: flex;
    gap: 0.875rem;
    align-items: flex-start;
  }
  .pf-ico {
    display: grid;
    flex: none;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-md);
    background: color-mix(in oklab, var(--gold) 32%, transparent);
    color: var(--gold-ink, var(--ink));
  }
  .pf-bar {
    height: 0.5rem;
    overflow: hidden;
    border-radius: var(--radius-xs);
    background: color-mix(in oklab, var(--ink) 10%, transparent);
  }
  .pf-bar > span {
    display: block;
    width: var(--pf, 0%);
    height: 100%;
    background: var(--primary);
    transition: width var(--duration-ui) var(--ease-out);
  }
  .pf-steps {
    display: grid;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }
  .pf-steps li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .pf-tick {
    display: grid;
    flex: none;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px var(--line-strong);
  }
  .pf-steps li[data-done='true'] .pf-tick {
    background: var(--primary);
    box-shadow: none;
  }
  .pf-steps li[data-done='true'] .pf-tick::after {
    content: '✓';
    color: var(--bg);
    font-size: 0.75rem;
    line-height: 1;
  }
  .pf-why {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding-inline-start: 1.25rem;
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  .pf-photo {
    display: grid;
    gap: 0.75rem;
  }
  .pf-photo-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }
  .pf-photo-preview {
    display: block;
    width: 5rem;
    height: 5rem;
    overflow: hidden;
    border-radius: var(--radius-lg);
    box-shadow: 0 0 0 1.5px var(--line-strong);
  }
  .pf-photo-preview > svg,
  .pf-photo-preview > img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pf-level {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .pf-withdraw {
    display: grid;
    gap: 0.25rem;
    justify-items: start;
  }
</style>
