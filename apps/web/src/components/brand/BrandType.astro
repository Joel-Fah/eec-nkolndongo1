---
import { formatBytes, formatDate, formatTime, formatXAF } from '@eec/i18n'
import Verse from '@eec/ui/astro/Verse.astro'
import { localeOf, useT } from '../../lib/i18n'
import Section from './Section.astro'

const locale = localeOf(Astro.currentLocale)
const t = useT(locale)

// File sizes, read at build time through Vite (works in dev and build, whatever the runtime).
const files = import.meta.glob<string>(
  [
    '../../../../../packages/ui/fonts/fontshare/switzer/Switzer-Variable.woff2',
    '../../../../../packages/ui/fonts/fontshare/erode/Erode-Variable.woff2',
  ],
  { query: '?inline', import: 'default', eager: true },
)
const kb = (file: string) => {
  const entry = Object.entries(files).find(([path]) => path.endsWith(file))
  if (!entry) return '—'
  const base64 = entry[1].slice(entry[1].indexOf(',') + 1).replace(/=+$/, '')
  return formatBytes(Math.floor((base64.length * 3) / 4), locale)
}

const sizes = `Switzer ${kb('Switzer-Variable.woff2')} + Erode ${kb('Erode-Variable.woff2')}`

// A typographic sample only: Sunday 25 October 2026, 09:00 in Yaoundé.
const sample = new Date('2026-10-25T08:00:00Z')
const dateLine = `${formatDate(sample, locale)} · ${formatTime(sample, locale)}`
const amount = formatXAF(5000, locale)
const scale = [
  ['4xl', 'brand.type.h1'],
  ['3xl', 'brand.type.h2'],
  ['2xl', 'brand.type.h3'],
  ['xl', 'brand.type.h4'],
  ['lg', 'brand.type.lead_text'],
  ['base', 'brand.type.scale_base'],
  ['sm', 'brand.type.small'],
  ['xs', 'brand.type.scale_xs'],
] as const
const nav = ['nav.discover', 'nav.live', 'nav.calendar', 'nav.news', 'nav.give'] as const
---

<Section id="type" title={t('brand.type.title')} lead={t('brand.type.lead')}>
  <p class="text-sm text-ink-muted">{t('brand.type.sample_label')}</p>
  <div class="grid grid-cols-[minmax(0,1fr)] gap-6 lg:grid-cols-2">
    <article class="specimen grid min-w-0 content-start gap-5 rounded-xl bg-surface p-6 shadow-1 md:p-8">
      <header class="flex flex-wrap items-center justify-between gap-2 rounded-md bg-surface-2 px-4 py-3">
        <h3 class="font-sans text-base font-semibold">{t('brand.type.pairing')}</h3>
        <p class="w-full text-xs text-ink-muted">{t('brand.type.weight', { size: sizes })}</p>
      </header>
      <p class="specimen-h1">{t('brand.type.h1')}</p>
      <p class="specimen-h2">{t('brand.type.h2')}</p>
      <p class="font-display text-2xl font-medium">{t('brand.type.h3')}</p>
      <p class="font-display text-xl font-medium">{t('brand.type.h4')}</p>
      <p class="text-lg text-ink-muted">{t('brand.type.lead_text')}</p>
      <p>{t('brand.type.body')}</p>
      <Verse mark={locale === 'fr' ? '«' : '“'} cite={t('brand.type.quote_ref')}>{t('brand.type.quote')}</Verse>
      <p>{t('brand.type.punctuation')}</p>
      <p class="text-sm text-ink-muted">{t('brand.type.small')}</p>
      <div class="grid gap-1">
        <p class="text-xs font-medium uppercase tracking-wide text-ink-muted">{t('brand.type.numbers')}</p>
        <p class="font-display text-xl font-medium tabular-nums">{dateLine}</p>
        <p class="text-lg font-medium tabular-nums">{amount}</p>
      </div>
      <nav class="flex flex-wrap gap-x-5 gap-y-2 text-[0.9375rem] font-medium" aria-label={t('brand.type.pairing')}>
        {nav.map((key) => <span>{t(key)}</span>)}
      </nav>
      <div>
        <span class="inline-flex min-h-11 items-center rounded-md bg-primary px-5 font-medium text-on-primary">
          {t('brand.type.button')}
        </span>
      </div>
    </article>
    <div class="grid min-w-0 content-start gap-4 rounded-xl bg-surface-2 p-6 md:p-8">
      <h3 class="text-xl">{t('brand.type.scale')}</h3>
      <dl class="grid gap-3">
        {
          scale.map(([token, key]) => (
            <div class="grid grid-cols-[4.5rem_minmax(0,1fr)] items-baseline gap-3 rounded-md bg-surface px-3 py-2">
              <dt class="text-xs text-ink-muted tabular-nums">{token}</dt>
              <dd class="min-w-0 font-display font-medium" style={`font-size:var(--text-${token});line-height:1.15`}>{t(key)}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
  <div class="grid gap-3">
    <h3 class="text-xl">{t('brand.type.rules_title')}</h3>
    <ul class="grid max-w-[72ch] list-disc gap-2 ps-6">
      {(['brand.type.rule1', 'brand.type.rule2', 'brand.type.rule3', 'brand.type.rule4'] as const).map((key) => <li>{t(key)}</li>)}
    </ul>
  </div>
</Section>

<style>
  .specimen {
    container-type: inline-size;
    min-width: 0;
  }
  .specimen-h1,
  .specimen-h2 {
    font-family: var(--font-display);
    font-weight: 500;
  }
  .specimen-h1 {
    font-size: min(var(--text-4xl), 15cqi);
    line-height: 1.05;
  }
  .specimen-h2 {
    font-size: min(var(--text-3xl), 10.5cqi);
    line-height: 1.12;
  }
</style>
