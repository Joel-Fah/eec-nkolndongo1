---
interface Props {
  id: string
  title: string
  lead?: string
}
const { id, title, lead } = Astro.props
---

<section id={id} class="scroll-mt-6 border-t border-line py-14 md:py-20" aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`} class="text-3xl">{title}</h2>
  {lead && <p class="mt-3 max-w-[62ch] text-lg text-ink-muted">{lead}</p>}
  <div class="mt-10 grid grid-cols-[minmax(0,1fr)] gap-12">
    <slot />
  </div>
</section>
