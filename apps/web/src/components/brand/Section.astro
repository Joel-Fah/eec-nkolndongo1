---
import Ornament from '@eec/ui/astro/Ornament.astro'

interface Props {
  id: string
  title: string
  lead?: string
  /** First section of the page has no ornament above it. */
  first?: boolean
}
const { id, title, lead, first = false } = Astro.props
---

<section id={id} class="scroll-mt-20 pb-16 md:pb-24" aria-labelledby={`${id}-title`}>
  {!first && <Ornament class="my-14 md:my-20" />}
  <h2 id={`${id}-title`} class="text-3xl">{title}</h2>
  {lead && <p class="mt-3 max-w-[62ch] text-lg text-ink-muted">{lead}</p>}
  <div class="mt-10 grid grid-cols-[minmax(0,1fr)] gap-12">
    <slot />
  </div>
</section>
