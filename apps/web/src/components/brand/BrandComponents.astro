    <DocBlock {...doc('segmented')}>
      <Segmented
        label={t('brand.components.segmented.name')}
        current="a4"
        options={[
          { value: 'a4', label: 'A4', href: '#components' },
          { value: 'a5', label: 'A5', href: '#components' },
        ]}
