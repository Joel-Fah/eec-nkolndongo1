    <DocBlock {...doc('sharecard')}>
      <img class="max-w-md rounded-lg ring-1 ring-line" src={`/og/default-${locale}.jpg`} width="1200" height="630" alt={t('site.parish')} loading="lazy" />
    </DocBlock>

    <DocBlock {...doc('tooltip')}>
      <div class="flex flex-wrap gap-4 py-6">
        <button type="button" class="btn btn-ghost btn-icon" aria-label={t('nav.search')} data-tip={t('nav.search')}><Icon name="search" /></button>
        <button type="button" class="btn btn-secondary btn-icon" aria-label={t('nav.account')} data-tip={t('nav.account')}><Icon name="account" /></button>
