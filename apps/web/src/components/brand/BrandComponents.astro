    <DocBlock {...doc('notificationbell')}><p class="text-sm text-ink-muted">{t('brand.components.notificationbell.use')}</p></DocBlock>

    <DocBlock {...doc('validatecard')}><p class="text-sm text-ink-muted">{t('brand.components.validatecard.use')}</p></DocBlock>

    <DocBlock {...doc('helplayout')}><p class="text-sm text-ink-muted">{t('brand.components.helplayout.use')}</p></DocBlock>

