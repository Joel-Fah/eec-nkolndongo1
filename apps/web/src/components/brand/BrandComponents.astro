    <DocBlock {...doc('deptcard')}><p class="text-sm text-ink-muted">{t('brand.components.deptcard.use')}</p></DocBlock>

    <DocBlock {...doc('guidechecklist')}><p class="text-sm text-ink-muted">{t('brand.components.guidechecklist.use')}</p></DocBlock>

