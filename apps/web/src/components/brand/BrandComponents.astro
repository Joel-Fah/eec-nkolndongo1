      <div class="grid gap-4">
        <Pagination page={5} pages={12} href="#p{n}" label={t('ui.pagination_label')} prevLabel={t('ui.pagination_prev')} nextLabel={t('ui.pagination_next')} pageLabel={t('ui.pagination_page', { n: '{n}' })} />
        <Pagination page={1} pages={3} href="#p{n}" label={t('ui.pagination_label')} prevLabel={t('ui.pagination_prev')} nextLabel={t('ui.pagination_next')} pageLabel={t('ui.pagination_page', { n: '{n}' })} />
      </div>
    </DocBlock>

    <DocBlock {...doc('contentcard')}>
      <div class="grid max-w-md gap-4">
        <ContentCard href="#c-contentcard" item={{ id: 'demo', slug: 'demo', title: t('brand.components.contentcard.demo_title'), excerpt: t('brand.components.contentcard.demo_text'), fallback: false, publishedAt: '2026-10-15T00:00:00Z', pinned: true, group: null, cover: null }} />
      </div>
    </DocBlock>

    <DocBlock {...doc('unavailable')}><UnavailableState /></DocBlock>

    <DocBlock {...doc('langfallback')}><LangFallbackNote /></DocBlock>

    <DocBlock {...doc('editor')}><p class="text-sm text-ink-muted">{t('brand.components.editor.demo')}</p></DocBlock>

