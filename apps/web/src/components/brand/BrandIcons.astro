---
import Icon from '@eec/ui/astro/Icon.astro'
import Illustration from '@eec/ui/astro/Illustration.astro'
import { icons } from '@eec/ui/icons'
import storyset from '@eec/ui/illustrations/storyset.json'
import { localeOf, useT } from '../../lib/i18n'
import Section from './Section.astro'

const locale = localeOf(Astro.currentLocale)
const t = useT(locale)
const names = Object.keys(icons) as (keyof typeof icons)[]
---

<Section id="icons" title={t('brand.icons.title')} lead={t('brand.icons.lead')}>
  <ul class="grid grid-cols-3 gap-2 sm:grid-cols-5 lg:grid-cols-8" role="list">
    {
      names.map((name) => (
        <li class="grid justify-items-center gap-2 rounded-md bg-surface px-2 py-4 text-center">
          <span class="flex items-end gap-3 text-ink">
            <Icon name={name} size={16} />
            <Icon name={name} size={20} />
            <Icon name={name} size={24} />
          </span>
          <code class="text-xs text-ink-muted">{name}</code>
        </li>
      ))
    }
  </ul>

  <div class="grid gap-5">
    <div>
      <h3 class="text-xl">{t('brand.icons.illustration')}</h3>
      <p class="mt-1 max-w-[62ch] text-ink-muted">{t('brand.icons.illustration_lead')}</p>
    </div>
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4" role="list">
      {
        storyset.map((item) => (
          <li class="grid gap-2 rounded-xl bg-surface p-3 ring-1 ring-line">
            <Illustration name={item.name} />
            <p class="px-1 text-sm"><code>{item.name}</code> · <span class="text-ink-muted">{item.use}</span></p>
          </li>
        ))
      }
    </ul>
    <div class="grid gap-4 md:grid-cols-2">
      {
        (['light', 'dark'] as const).map((theme) => (
          <figure data-theme={theme} class="grid gap-2 rounded-xl bg-bg p-3 text-ink ring-1 ring-line">
            <Illustration name="together" />
            <figcaption class="px-1 text-sm text-ink-muted">{t(`brand.icons.${theme}` as 'brand.icons.light')}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</Section>
