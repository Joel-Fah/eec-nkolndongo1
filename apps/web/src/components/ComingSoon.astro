---
import Badge from '@eec/ui/astro/Badge.astro'
import Button from '@eec/ui/astro/Button.astro'
import EmptyState from '@eec/ui/astro/EmptyState.astro'
import Illustration from '@eec/ui/astro/Illustration.astro'
import { localeOf, useT } from '../lib/i18n'
import { href } from '../lib/nav'

interface Props {
  pageTitle: string
}
const { pageTitle } = Astro.props
const locale = localeOf(Astro.currentLocale)
const t = useT(locale)
---

<section class="mx-auto grid max-w-3xl gap-6 px-4 py-12 md:px-8 md:py-20">
  <h1 class="text-center text-4xl">{pageTitle}</h1>
  <Badge tone="gold" class="mx-auto">{t('soon.badge')}</Badge>
  <EmptyState title={t('soon.title')} text={t('soon.text')}>
    <Illustration slot="art" name="hymn-book-handover" class="h-auto w-full" />
    <Button href={href(locale, '')} variant="primary">{t('soon.home')}</Button>
  </EmptyState>
  <p class="text-center text-sm text-ink-muted">{t('soon.note')}</p>
</section>
