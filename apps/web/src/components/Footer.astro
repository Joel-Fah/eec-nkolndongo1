---
/**
 * Floating footer: lifted off the viewport edges like the header (same 80rem frame, every corner rounded).
 * An invitation, the site map, practical links, then the parish name set very large and cropped.
 */
import Button from '@eec/ui/astro/Button.astro'
import Icon from '@eec/ui/astro/Icon.astro'
import { localeOf, useT } from '../lib/i18n'
import { alternates, href, labelKey, pages, tabKey, tabs } from '../lib/nav'
import SiteLockup from './SiteLockup.astro'
import ThemeToggle from './ThemeToggle.astro'

const locale = localeOf(Astro.currentLocale)
const t = useT(locale)
const other = locale === 'fr' ? 'en' : 'fr'
const switchHref = alternates(Astro.url.pathname)[other]
const pathOf = (id: string) => pages.find((p) => p.id === id)?.path[locale] ?? ''
const legal = ['privacy', 'legal'].map((id) => ({ id, path: pathOf(id) }))
const socials = [
  ['whatsapp', 'WhatsApp'],
  ['chat', 'Facebook'],
  ['play', 'YouTube'],
] as const
const mapTabs = tabs.filter((tab) => tab.children.length)
---

<footer class="site-footer">
  <div class="site-footer-card">
    <div class="footer-invite">
      <div class="grid gap-2">
        <h2 class="text-3xl">{t('footer.invite_title')}</h2>
        <p class="max-w-[48ch] text-ink-muted">{t('footer.invite_text')}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <Button href={href(locale, pathOf('trouver'))} size="lg"><Icon name="location" />{t('footer.invite_find')}</Button>
        <Button href={href(locale, pathOf('account'))} size="lg" variant="secondary">{t('footer.invite_account')}</Button>
      </div>
    </div>

    <div class="footer-grid">
      <div class="grid content-start gap-4">
        <div class="w-[min(100%,18rem)] text-[1.05rem]"><SiteLockup variant="two" /></div>
        <p class="max-w-[34ch] text-ink-muted">{t('footer.about')}</p>
        <ul class="flex gap-2" role="list" aria-label={t('footer.follow')}>
          {
            socials.map(([icon, name]) => (
              <li>
                <span class="footer-social" title={`${name} · ${t('footer.social_pending')}`}>
                  <Icon name={icon} />
                  <span class="sr-only">{`${name} · ${t('footer.social_pending')}`}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
      {
        mapTabs.map((tab) => (
          <nav class="grid content-start gap-3" aria-label={t(tabKey(tab.id))}>
            <h2 class="footer-heading">{t(tabKey(tab.id))}</h2>
            <ul class="grid gap-1" role="list">
              {tab.children.map((child) => (
                <li>
                  <a class="footer-link" href={href(locale, `${tab.slug[locale]}/${child.slug[locale]}`)}>
                    {t(labelKey(child.id))}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="footer-meta">
      <p class="text-sm text-ink-muted">{t('footer.rights')} · {t('footer.credits')} · {t('footer.credits_pending')}</p>
      <ul class="flex flex-wrap items-center gap-x-4" role="list">
        {legal.map((l) => <li><a class="footer-link text-sm" href={href(locale, l.path)}>{t(labelKey(l.id))}</a></li>)}
      </ul>
      <div class="flex items-center gap-2" role="group" aria-label={t('footer.controls')}>
        <a href={switchHref} hreflang={other} lang={other} class="btn btn-ghost btn-sm" aria-label={t('common.language.switch_label')}><Icon name="language" size={16} />{t('common.language.switch_to')}</a>
        <ThemeToggle />
      </div>
    </div>

    <p class="footer-word" aria-hidden="true">Nkolndongo</p>
  </div>
</footer>

<style is:global>
  .site-footer {
    margin-block-start: 6rem;
    padding: 0 0.75rem 0.75rem;
  }
  .site-footer-card {
    position: relative;
    display: grid;
    gap: 3.5rem;
    max-width: 80rem;
    margin-inline: auto;
    padding: 2.5rem 1.25rem 0;
    overflow: hidden;
    border-radius: var(--radius-xl);
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  @media (min-width: 48rem) {
    .site-footer-card {
      padding: 3.5rem 3rem 0;
    }
  }
  .footer-invite {
    display: grid;
    gap: 1.5rem;
    padding: 2rem;
    border-radius: calc(var(--radius-xl) - 0.5rem);
    background: var(--surface);
    box-shadow: var(--elevation-1);
  }
  @media (min-width: 64rem) {
    .footer-invite {
      grid-template-columns: 1fr auto;
      align-items: center;
      padding: 2.5rem 3rem;
    }
  }
  .footer-grid {
    display: grid;
    gap: 2.5rem 2rem;
    grid-template-columns: repeat(2, 1fr);
  }
  .footer-grid > :first-child {
    grid-column: 1 / -1;
  }
  @media (min-width: 48rem) {
    .footer-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  @media (min-width: 64rem) {
    .footer-grid {
      grid-template-columns: 1.6fr repeat(4, 1fr);
    }
    .footer-grid > :first-child {
      grid-column: auto;
    }
  }
  .footer-heading {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--ink);
  }
  .footer-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--ink-muted);
    transition: color var(--duration-micro) var(--ease-out);
  }
  .footer-link:hover {
    color: var(--primary);
  }
  @media (min-width: 64rem) {
    .footer-grid .footer-link {
      min-height: 2.25rem;
    }
  }
  .footer-social {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--ink-muted);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .footer-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }
  /* The parish name, very large, cropped by the card's bottom edge. */
  .footer-word {
    margin-block-start: -1.5rem;
    margin-inline: auto;
    font-family: var(--font-display);
    font-size: clamp(4rem, 17vw, 15.5rem);
    font-weight: 600;
    line-height: 0.72;
    letter-spacing: -0.04em;
    white-space: nowrap;
    color: color-mix(in oklab, var(--primary) 12%, var(--surface-2));
    user-select: none;
  }
</style>
