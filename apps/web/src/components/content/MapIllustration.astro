---
/**
 * A drawn map, not a real one: soft contours for the hill, a stream, a few roads and blocks, and the parish marker, with
 * the Google Maps button on top. Decorative (hidden from assistive tech); the real way there is the button and the address.
 * No tiles, no third party, no data cost.
 */
import Button from '@eec/ui/astro/Button.astro'
import Icon from '@eec/ui/astro/Icon.astro'

interface Props {
  /** The parish name shown on the marker's tag. */
  name?: string
  href?: string
  label: string
}
const { name = '', href, label } = Astro.props
---

<div class="mi" data-map>
  <svg class="mi-svg" viewBox="0 0 400 230" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    <rect width="400" height="230" class="mi-land" />
    <!-- The hill: contour lines, drawn first. -->
    <g class="mi-contour">
      <ellipse class="draw" pathLength="1" style="--d:0s" cx="82" cy="60" rx="82" ry="52" />
      <ellipse class="draw" pathLength="1" style="--d:0.12s" cx="82" cy="60" rx="62" ry="38" />
      <ellipse class="draw" pathLength="1" style="--d:0.24s" cx="82" cy="60" rx="42" ry="25" />
      <ellipse class="draw" pathLength="1" style="--d:0.36s" cx="82" cy="60" rx="22" ry="12" />
    </g>
    <!-- The stream. -->
    <path class="mi-water draw" pathLength="1" style="--d:0.3s" d="M-10 124c40 22 70-18 116-6s60 38 110 24 74-44 120-30 60 22 80 14" />
    <!-- Roads: the main one, two crossing it, a small side street and a roundabout. -->
    <g class="mi-roads">
      <path class="draw" pathLength="1" style="--d:0.5s" d="M-10 78c60 10 110-6 170 8s110 30 250 6" />
      <path class="draw" pathLength="1" style="--d:0.7s" d="M176 -10c-8 50 16 70 8 120s-20 80-12 130" />
      <path class="draw" pathLength="1" style="--d:0.9s" d="M318 -10c-10 40 12 64 4 96" />
      <path class="draw" pathLength="1" style="--d:1s" d="M92 240c6-40 28-70 60-96" />
      <circle class="draw mi-round" pathLength="1" style="--d:1.1s" cx="180" cy="94" r="13" />
    </g>
    <g class="mi-dash fade" style="--d:1.4s">
      <path d="M-10 78c60 10 110-6 170 8s110 30 250 6" />
      <path d="M176 -10c-8 50 16 70 8 120s-20 80-12 130" />
    </g>
    <!-- Green spaces and trees. -->
    <g class="mi-green fade" style="--d:1.2s">
      <path d="M290 150c18-16 52-14 66 4s10 44-14 52-62 2-66-22c-2-12 4-24 14-34Z" />
      <path d="M20 160c14-10 38-8 48 8s0 36-22 38-34-14-30-30c0-6 2-12 4-16Z" />
    </g>
    <g class="mi-trees">
      <circle class="fade" style="--d:1.5s" cx="306" cy="168" r="6" />
      <circle class="fade" style="--d:1.58s" cx="326" cy="182" r="7" />
      <circle class="fade" style="--d:1.66s" cx="338" cy="160" r="5" />
      <circle class="fade" style="--d:1.74s" cx="40" cy="178" r="6" />
      <circle class="fade" style="--d:1.82s" cx="58" cy="190" r="5" />
      <circle class="fade" style="--d:1.9s" cx="226" cy="40" r="5" />
      <circle class="fade" style="--d:1.98s" cx="300" cy="50" r="6" />
    </g>
    <!-- Houses. -->
    <g class="mi-blocks">
      <rect class="fade" style="--d:1.3s" x="196" y="20" width="44" height="26" rx="6" />
      <rect class="fade" style="--d:1.36s" x="248" y="30" width="34" height="22" rx="6" />
      <rect class="fade" style="--d:1.42s" x="332" y="26" width="44" height="30" rx="6" />
      <rect class="fade" style="--d:1.48s" x="100" y="106" width="50" height="28" rx="6" />
      <rect class="fade" style="--d:1.54s" x="40" y="98" width="36" height="22" rx="6" />
      <rect class="fade" style="--d:1.6s" x="200" y="152" width="46" height="26" rx="6" />
      <rect class="fade" style="--d:1.66s" x="112" y="176" width="52" height="30" rx="6" />
      <rect class="fade" style="--d:1.72s" x="346" y="110" width="40" height="26" rx="6" />
      <rect class="fade" style="--d:1.78s" x="132" y="30" width="34" height="22" rx="6" />
    </g>
    <!-- The way in: a footpath leaves the main road and leads to the church. -->
    <path class="mi-path fade" style="--d:2s" d="M214 90c14 4 24 10 36 22" />
    <!-- North arrow. -->
    <g class="mi-north fade" style="--d:2.1s" transform="translate(372 24)">
      <circle r="12" />
      <path d="M0-8 4 4 0 1-4 4Z" />
    </g>
    <!-- The parish itself, standing on the map as a small isometric building: nave, steeple, door and windows. -->
    <g transform="translate(250 112)">
      <ellipse class="mi-pulse" cx="12" cy="24" rx="44" ry="22" />
      <polygon class="mi-ground" points="-30,20 8,42 44,22 6,2" />
      <g class="mi-bld">
        <!-- Nave: the lit wall, the shaded wall with its gable, and the roof. -->
        <polygon class="mi-wall-l" points="-25.98,15 8.66,35 8.66,13 -25.98,-7" />
        <polygon class="mi-wall-r" points="34.64,20 8.66,35 8.66,13 21.65,-6.5 34.64,-2" />
        <polygon class="mi-roof" points="-25.98,-7 8.66,13 21.65,-6.5 -12.99,-26.5" />
        <!-- Steeple: its two walls, a pyramid roof and a cross. -->
        <polygon class="mi-wall-l" points="12.12,33 25.98,41 25.98,-3 12.12,-11" />
        <polygon class="mi-wall-r" points="39.84,33 25.98,41 25.98,-3 39.84,-11" />
        <polygon class="mi-tower-roof" points="12.12,-11 25.98,-3 25.98,-31" />
        <polygon class="mi-tower-roof mi-tower-roof-r" points="25.98,-3 39.84,-11 25.98,-31" />
        <path class="mi-cross" d="M25.98-31v-11M22.5-38h7" />
        <!-- Door and windows. -->
        <polygon class="mi-door" points="-13.86,22 -3.46,28 -3.46,14 -13.86,8" />
        <polygon class="mi-win" points="-21.65,8.5 -17.3,11 -17.3,2 -21.65,-0.5" />
        <polygon class="mi-win" points="3.5,17 7.8,19.5 7.8,10.5 3.5,8" />
        <polygon class="mi-win mi-win-r" points="32.04,12.5 27.7,15 27.7,6 32.04,3.5" />
      </g>
    </g>
  </svg>
  {name && <span class="mi-tag">{name}</span>}
  {
    href && (
      <div class="mi-cta">
        <Button href={href} target="_blank" rel="noopener noreferrer"><Icon name="location" size={20} />{label}<Icon name="external" size={16} /></Button>
      </div>
    )
  }
</div>

<script>
  // The drawing traces itself the first time the map scrolls into view (instantly, if motion is reduced). Once the building has
  // risen, a click on it makes it bounce (the whole map answers, the building bounces; a squash and a hop, once at a time). Decorative: no keyboard role.
  const RISE_MS = 3300
  const run = () => {
    for (const el of document.querySelectorAll<HTMLElement>('[data-map]:not([data-js])')) {
      el.setAttribute('data-js', '')
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches
      const bld = el.querySelector<SVGGElement>('.mi-bld')
      let bouncing = false
      // A click anywhere on the map (not on the directions button) makes the building bounce.
      el.addEventListener('click', (e) => {
        if (!bld || (e.target as Element).closest('.mi-cta, a, button')) return
        if (reduced || bouncing || !el.hasAttribute('data-ready')) return
        bouncing = true
        const a = bld.animate(
          [
            { transform: 'translateY(0) scale(1, 1)' },
            { transform: 'translateY(0) scale(1.08, 0.82)', offset: 0.18 },
            { transform: 'translateY(-9px) scale(0.95, 1.14)', offset: 0.42 },
            { transform: 'translateY(0) scale(1.06, 0.88)', offset: 0.68 },
            { transform: 'translateY(-2px) scale(0.99, 1.03)', offset: 0.84 },
            { transform: 'translateY(0) scale(1, 1)' },
          ],
          { duration: 720, easing: 'cubic-bezier(.3,.7,.4,1)' },
        )
        a.onfinish = a.oncancel = () => {
          bouncing = false
        }
      })
      if (reduced || !('IntersectionObserver' in window)) {
        el.setAttribute('data-in', '')
        continue
      }
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            el.setAttribute('data-in', '')
            io.disconnect()
            setTimeout(() => el.setAttribute('data-ready', ''), RISE_MS)
          }
        },
        { threshold: 0.4 },
      )
      io.observe(el)
    }
  }
  run()
  document.addEventListener('astro:page-load', run)
</script>

<style>
  .mi {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    aspect-ratio: 400 / 230;
    border-radius: var(--radius-lg);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .mi-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .mi-land {
    fill: color-mix(in oklab, var(--primary) 8%, var(--surface-2));
  }
  /* Tracing: lines draw themselves, houses and trees fade in, the pin drops in last. Without script all of it is simply shown. */
  .draw {
    stroke-dasharray: 1;
    transition: stroke-dashoffset 1.3s var(--ease-out) var(--d, 0s);
  }
  .mi[data-js]:not([data-in]) .draw {
    stroke-dashoffset: 1;
  }
  .fade {
    transition:
      opacity 0.6s var(--ease-out) var(--d, 0s),
      transform 0.6s var(--ease-out) var(--d, 0s);
    transform-box: fill-box;
    transform-origin: center;
  }
  .mi[data-js]:not([data-in]) .fade {
    opacity: 0;
    transform: scale(0.85);
  }
  /* The building rises from the ground last. */
  .mi-bld {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    transition:
      transform 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) 2.2s,
      opacity 0.3s ease 2.2s;
  }
  .mi[data-ready] svg {
    cursor: pointer;
  }
  .mi[data-js]:not([data-in]) .mi-bld {
    transform: scaleY(0.05);
    opacity: 0;
  }
  .mi-round {
    fill: var(--surface-2);
  }
  .mi-trees circle {
    fill: color-mix(in oklab, var(--primary) 32%, transparent);
  }
  .mi-path {
    fill: none;
    stroke: var(--primary);
    stroke-width: 2;
    stroke-dasharray: 3 4;
    stroke-linecap: round;
  }
  .mi-north circle {
    fill: var(--surface);
    stroke: var(--line-strong);
  }
  .mi-north path {
    fill: var(--primary);
  }
  .mi-ground {
    fill: color-mix(in oklab, var(--ink) 16%, transparent);
  }
  .mi-bld polygon,
  .mi-cross {
    stroke: color-mix(in oklab, var(--ink) 30%, transparent);
    stroke-width: 0.6;
    stroke-linejoin: round;
  }
  .mi-wall-l {
    fill: color-mix(in oklab, var(--primary) 14%, var(--surface));
  }
  .mi-wall-r {
    fill: color-mix(in oklab, var(--primary) 40%, var(--surface));
  }
  .mi-roof {
    fill: var(--primary);
  }
  .mi-tower-roof {
    fill: var(--gold);
  }
  .mi-tower-roof-r {
    fill: color-mix(in oklab, var(--gold) 70%, var(--clay));
  }
  .mi-cross {
    fill: none;
    stroke: var(--gold-ink);
    stroke-width: 1.6;
    stroke-linecap: round;
  }
  .mi-door {
    fill: color-mix(in oklab, var(--primary) 70%, var(--ink));
  }
  .mi-win {
    fill: color-mix(in oklab, var(--info) 45%, var(--surface));
  }
  .mi-win-r {
    fill: color-mix(in oklab, var(--info) 30%, var(--primary));
  }
  .mi-contour ellipse {
    fill: none;
    stroke: color-mix(in oklab, var(--primary) 30%, transparent);
    stroke-width: 1.5;
  }
  .mi-green {
    fill: color-mix(in oklab, var(--primary) 20%, transparent);
  }
  .mi-water {
    fill: none;
    stroke: color-mix(in oklab, var(--info) 38%, transparent);
    stroke-width: 12;
    stroke-linecap: round;
  }
  .mi-roads path,
  .mi-roads circle {
    fill: none;
    stroke: var(--surface);
    stroke-width: 13;
    stroke-linecap: round;
  }
  .mi-dash path {
    fill: none;
    stroke: color-mix(in oklab, var(--ink) 22%, transparent);
    stroke-width: 1.5;
    stroke-dasharray: 5 7;
    stroke-linecap: round;
  }
  .mi-blocks rect {
    fill: color-mix(in oklab, var(--ink) 8%, transparent);
  }
  .mi-pulse {
    fill: color-mix(in oklab, var(--primary) 22%, transparent);
    transform-box: fill-box;
    transform-origin: center;
    animation: mi-pulse 2.8s ease-out 3s infinite;
  }
  @keyframes mi-pulse {
    from {
      transform: scale(0.5);
      opacity: 1;
    }
    to {
      transform: scale(1.7);
      opacity: 0;
    }
  }
  .mi-tag {
    position: absolute;
    inset-block-start: 18%;
    inset-inline-start: 56%;
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: var(--elevation-2);
    font-size: var(--text-xs);
    font-weight: 700;
    white-space: nowrap;
  }
  .mi-cta {
    position: absolute;
    inset-block-end: 0.75rem;
    inset-inline: 0.75rem;
    display: flex;
    justify-content: flex-start;
    pointer-events: none;
  }
  .mi-cta :global(a) {
    pointer-events: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .draw,
    .fade,
    .mi-bld {
      transition: none;
    }
    .mi-pulse {
      animation: none;
      opacity: 0.6;
    }
  }
</style>
