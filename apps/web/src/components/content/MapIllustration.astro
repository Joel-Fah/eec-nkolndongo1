---
/**
 * A drawn map, not a real one: soft contours for the hill, a stream, a few roads and blocks, and the parish marker, with
 * the Google Maps button on top. Decorative (hidden from assistive tech); the real way there is the button and the address.
 * No tiles, no third party, no data cost.
 */
import Button from '@eec/ui/astro/Button.astro'
import Icon from '@eec/ui/astro/Icon.astro'

interface Props {
  /** The parish name shown on the marker's tag. */
  name?: string
  href?: string
  label: string
}
const { name = '', href, label } = Astro.props
---

<div class="mi">
  <svg class="mi-svg" viewBox="0 0 400 230" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    <rect width="400" height="230" class="mi-land" />
    <!-- The hill: contour lines. -->
    <g class="mi-contour">
      <ellipse cx="78" cy="58" rx="74" ry="46" />
      <ellipse cx="78" cy="58" rx="54" ry="32" />
      <ellipse cx="78" cy="58" rx="34" ry="19" />
      <ellipse cx="78" cy="58" rx="14" ry="8" />
    </g>
    <!-- Green spaces. -->
    <path class="mi-green" d="M290 150c18-16 52-14 66 4s10 44-14 52-62 2-66-22c-2-12 4-24 14-34Z" />
    <path class="mi-green" d="M20 160c14-10 38-8 48 8s0 36-22 38-34-14-30-30c0-6 2-12 4-16Z" />
    <!-- The stream. -->
    <path class="mi-water" d="M-10 120c40 22 70-18 116-6s60 38 110 24 74-44 120-30 60 22 80 14" />
    <!-- Roads: a wide one, two crossing it. -->
    <g class="mi-roads">
      <path d="M-10 78c60 10 110-6 170 8s110 30 250 6" />
      <path d="M176 -10c-8 50 16 70 8 120s-20 80-12 130" />
      <path d="M318 -10c-10 40 12 64 4 96" />
    </g>
    <g class="mi-dash">
      <path d="M-10 78c60 10 110-6 170 8s110 30 250 6" />
      <path d="M176 -10c-8 50 16 70 8 120s-20 80-12 130" />
    </g>
    <!-- Blocks. -->
    <g class="mi-blocks">
      <rect x="196" y="20" width="44" height="26" rx="6" />
      <rect x="248" y="30" width="34" height="22" rx="6" />
      <rect x="330" y="26" width="46" height="30" rx="6" />
      <rect x="100" y="104" width="50" height="28" rx="6" />
      <rect x="40" y="96" width="36" height="22" rx="6" />
      <rect x="196" y="150" width="46" height="26" rx="6" />
      <rect x="104" y="170" width="52" height="30" rx="6" />
      <rect x="340" y="108" width="40" height="26" rx="6" />
    </g>
    <!-- The parish marker. -->
    <g class="mi-pin" transform="translate(262 118)">
      <circle class="mi-pulse" r="22" />
      <ellipse class="mi-shadow" cy="26" rx="12" ry="4" />
      <path class="mi-drop" d="M0 24C-14 8-20 0-20-10a20 20 0 0 1 40 0c0 10-6 18-20 34Z" />
      <circle class="mi-eye" cy="-10" r="7" />
    </g>
  </svg>
  {name && <span class="mi-tag">{name}</span>}
  {
    href && (
      <div class="mi-cta">
        <Button href={href} target="_blank" rel="noopener noreferrer"><Icon name="location" size={20} />{label}<Icon name="external" size={16} /></Button>
      </div>
    )
  }
</div>

<style>
  .mi {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    aspect-ratio: 400 / 230;
    border-radius: var(--radius-lg);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .mi-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .mi-land {
    fill: color-mix(in oklab, var(--primary) 8%, var(--surface-2));
  }
  .mi-contour ellipse {
    fill: none;
    stroke: color-mix(in oklab, var(--primary) 30%, transparent);
    stroke-width: 1.5;
  }
  .mi-green {
    fill: color-mix(in oklab, var(--primary) 20%, transparent);
  }
  .mi-water {
    fill: none;
    stroke: color-mix(in oklab, var(--info) 38%, transparent);
    stroke-width: 12;
    stroke-linecap: round;
  }
  .mi-roads path {
    fill: none;
    stroke: var(--surface);
    stroke-width: 13;
    stroke-linecap: round;
  }
  .mi-dash path {
    fill: none;
    stroke: color-mix(in oklab, var(--ink) 22%, transparent);
    stroke-width: 1.5;
    stroke-dasharray: 5 7;
    stroke-linecap: round;
  }
  .mi-blocks rect {
    fill: color-mix(in oklab, var(--ink) 8%, transparent);
  }
  .mi-pulse {
    fill: color-mix(in oklab, var(--primary) 22%, transparent);
    transform-box: fill-box;
    transform-origin: center;
    animation: mi-pulse 2.8s ease-out infinite;
  }
  .mi-shadow {
    fill: color-mix(in oklab, var(--ink) 25%, transparent);
  }
  .mi-drop {
    fill: var(--primary);
  }
  .mi-eye {
    fill: var(--surface);
  }
  @keyframes mi-pulse {
    from {
      transform: scale(0.5);
      opacity: 1;
    }
    to {
      transform: scale(1.7);
      opacity: 0;
    }
  }
  .mi-tag {
    position: absolute;
    inset-block-start: 18%;
    inset-inline-start: 56%;
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: var(--elevation-2);
    font-size: var(--text-xs);
    font-weight: 700;
    white-space: nowrap;
  }
  .mi-cta {
    position: absolute;
    inset-block-end: 0.75rem;
    inset-inline: 0.75rem;
    display: flex;
    justify-content: center;
  }
  @media (prefers-reduced-motion: reduce) {
    .mi-pulse {
      animation: none;
      opacity: 0.6;
    }
  }
</style>
