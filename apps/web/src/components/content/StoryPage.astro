---
/**
 * The story pages (Notre histoire, Ce que nous croyons, Pasteurs et Conseil): the structure and motion are code,
 * the words and people come from the admin (published only; otherwise the built-in text stays). History = « Gravir la
 * colline »; Council = names only with a recorded consent. Data: cached public API; never a 500 when it is down.
 */
import Button from '@eec/ui/astro/Button.astro'
import Icon from '@eec/ui/astro/Icon.astro'
import Illustration from '@eec/ui/astro/Illustration.astro'
import Site from '../../layouts/Site.astro'
import { publicJson } from '../../lib/content-api'
import { localeOf, useT } from '../../lib/i18n'
import { href, labelKey, pages } from '../../lib/nav'
import type { StoryData } from '../../lib/story-routes'
import PageView from '../PageView.astro'
import Picture from '../Picture.astro'
import PageHero from '../page/PageHero.astro'

interface Props {
  id: 'histoire' | 'croyances' | 'pasteurs'
}
const { id } = Astro.props
const locale = localeOf(Astro.currentLocale)
const t = useT(locale)
const s = (key: string) => t(`story.site.${key}` as 'story.site.invite_t')
const result = await publicJson<StoryData>(Astro, `/api/story/public?locale=${locale}`)
const data: StoryData =
  result.state === 'ok' ? result.data : { slots: {}, milestones: [], council: [] }
const slot = (key: string) => data.slots[id]?.[key]
const path = (pageId: string) =>
  href(locale, pages.find((p) => p.id === pageId)?.path[locale] ?? '')
const milestones = id === 'histoire' ? data.milestones : []
const council = id === 'pasteurs' ? data.council : []
const texts: Record<number, string> =
  id === 'croyances' && slot('intro') ? { 0: slot('intro')?.text ?? '' } : {}
Astro.response.headers.set(
  'cache-control',
  result.state === 'ok' ? 'public, max-age=30, stale-while-revalidate=120' : 'no-store',
)
---

<Site title={t(labelKey(id))}>
  <PageHero id={id} />
  {
    id === 'histoire' && milestones.length > 0 ? (
      <section class="hc" aria-labelledby="hc-title">
        <h2 id="hc-title" class="hc-title">{s('climb_t')}</h2>
        {slot('intro') && <p class="hc-intro">{slot('intro')?.text}</p>}
        <ol class="hc-list" data-climb>
          <svg class="hc-trail" data-trail aria-hidden="true" focusable="false"><path data-trail-path class="hc-path" fill="none" /></svg>
          {
            milestones.map((m, i) => {
              const pics = (m.images ?? []) as never[]
              const chosen = m.layout && m.layout !== 'auto' ? m.layout : ({ 2: 'stack', 3: 'fan', 4: 'bento' } as Record<number, string>)[pics.length] ?? 'scatter'
              const layout = ['fan', 'stack', 'bento', 'scatter'].includes(chosen) ? chosen : 'scatter'
              return (
                <li class="hc-item" data-milestone data-side={i % 2 === 0 ? 'l' : 'r'} data-last={i === milestones.length - 1 ? '' : undefined}>
                  <span class="hc-dot" data-node aria-hidden="true"></span>
                  <div class="hc-card">
                    <h3 class="hc-head">
                      <span class="hc-year">{m.year}</span>
                      <span class="hc-ttl">{m.title}</span>
                    </h3>
                    {m.text && <p class="hc-text">{m.text}</p>}
                    {pics.length > 0 && (
                      <div class="hc-deck" data-layout={pics.length === 1 ? 'one' : layout} style={`--n:${pics.length}`}>
                        {pics.map((pic, j) => {
                          const finale = i === milestones.length - 1 && j === pics.length - 1
                          return (
                            <figure class="hc-pic" data-finale={finale ? '' : undefined} style={`--i:${j};--rx:${(((i * 7 + j * 13) % 11) - 5) * 1.6}deg;--dx:${(((i * 5 + j * 9) % 7) - 3) * 4}%;--dy:${(((i * 3 + j * 5) % 5) - 2) * 5}%`}>
                              <div class="hc-photo"><Picture class="hc-img" media={pic} sizes="(min-width: 48rem) 20rem, 90vw" decorative /></div>
                              {finale && (
                                <span class="hc-cheer" aria-hidden="true">
                                  {Array.from({ length: 14 }, (_, c) => <i style={`--k:${c}`} data-shape={['star', 'dot', 'bar', 'ring'][c % 4]} />)}
                                </span>
                              )}
                            </figure>
                          )
                        })}
                      </div>
                    )}
                  </div>
                </li>
              )
            })
          }
        </ol>
        <div class="hc-end">
          <p class="hc-end-kicker">{s('invite_kicker')}</p>
          <h3 class="hc-end-t">{s('invite_t')}</h3>
          <p class="hc-end-p">{slot('invite')?.text ?? s('invite_p')}</p>
          <ol class="hc-ways">
            {
              [
                { art: 'exploring', t: s('way1_t'), p: s('way1_p') },
                { art: 'solidarity', t: s('way2_t'), p: s('way2_p') },
                { art: 'collecting', t: s('way3_t'), p: s('way3_p') },
              ].map((w, n) => (
                <li class="hc-way" style={`--n:${n};--crop:${['16%', '0%', '30%'][n]}`} data-mid={n === 1 ? '' : undefined}>
                  <div class="hc-way-art"><Illustration name={w.art} /></div>
                  <p class="hc-way-t">{w.t}</p>
                  <p class="hc-way-p">{w.p}</p>
                </li>
              ))
            }
          </ol>
          <p class="hc-actions">
            <Button href={path('trouver')} size="lg"><Icon name="location" size={20} />{s('visit')}</Button>
            <Button href={path('departements')} variant="secondary" size="lg"><Icon name="users" size={20} />{s('groups')}</Button>
            <Button href={path('account')} variant="ghost" size="lg">{s('join')}<Icon name="external" size={20} /></Button>
          </p>
        </div>
      </section>
    ) : id === 'pasteurs' && (council.length > 0 || slot('governance')) ? (
      <section class="co">
        {slot('governance') && <div class="co-gov" set:html={slot('governance')?.html} />}
        {council.length === 0 && <PageView id="pasteurs" hideHeader omit={[0, 2]} />}
        {
          council.map((g) => (
            <section class="co-group">
              <h2 class="co-h">{g.label}</h2>
              <ul class="co-grid">
                {g.people.map((p) => (
                  <li class="co-card">
                    {p.photo ? <Picture class="co-photo" media={p.photo as never} sizes="5rem" decorative /> : <span class="co-ph" aria-hidden="true"></span>}
                    <span class="co-text">
                      {p.name ? <strong>{p.name}</strong> : <strong>{g.label}</strong>}
                      {p.title && <span class="co-sub">{p.title}</span>}
                      {p.term && <span class="co-sub">{p.term}</span>}
                    </span>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </section>
    ) : (
      <PageView id={id} hideHeader texts={texts} />
    )
  }
</Site>

<script>
  import { initClimb } from '../../scripts/history-climb'
  initClimb()
  document.addEventListener('astro:page-load', initClimb)
</script>

<style>
  .hc,
  .co {
    display: grid;
    gap: 1.5rem;
    width: min(100% - 2rem, 64rem);
    margin-inline: auto;
    padding-block: 2rem 4rem;
  }
  .hc-title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
  }
  .hc-intro {
    max-width: 56ch;
    font-size: var(--text-xl);
    color: var(--ink-muted);
  }
  .hc-list {
    position: relative;
    display: grid;
    gap: 2.5rem;
    padding-block: 1rem;
  }
  /* Without script: a straight line down the middle; with script the winding trail replaces it. */
  .hc-list::before {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-start: 50%;
    width: 0.25rem;
    margin-inline-start: -0.125rem;
    border-radius: var(--radius-xs, 0.25rem);
    background: color-mix(in oklab, var(--season) 40%, transparent);
  }
  .hc-list[data-js]::before {
    display: none;
  }
  .hc-trail {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hc-path {
    stroke: var(--primary);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-dasharray: 1 1;
  }
  .hc-item {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .hc-dot {
    position: absolute;
    inset-block-start: 1.5rem;
    inset-inline-start: 50%;
    width: 1.25rem;
    height: 1.25rem;
    margin: -0.625rem 0 0 -0.625rem;
    border-radius: 50%;
    background: var(--surface);
    box-shadow: 0 0 0 0.25rem var(--primary);
  }
  /* The dots step left and right in turn, so the trail winds up the hill instead of running straight. */
  .hc-item[data-side='l'] .hc-dot {
    inset-inline-start: calc(50% - 1.75rem);
  }
  .hc-item[data-side='r'] .hc-dot {
    inset-inline-start: calc(50% + 1.75rem);
  }
  .hc-card {
    grid-column: 1;
    padding-inline-end: 3.75rem;
    text-align: end;
  }
  .hc-item[data-side='r'] .hc-card {
    grid-column: 2;
    padding-inline: 3.75rem 0;
    text-align: start;
  }
  .hc-head {
    display: grid;
    gap: 0.125rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--elevation-1);
  }
  .hc-year {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--primary);
  }
  .hc-ttl {
    font-family: var(--font-display);
    font-size: var(--text-xl);
  }
  .hc-text {
    margin-block-start: 0.75rem;
    color: var(--ink-muted);
  }
  /* A step's pictures as a deck of polaroids, each layout keeping its own arrangement. Every picture grows a little when hovered. */
  .hc-deck {
    --polaroid: #fff;
    position: relative;
    display: grid;
    margin-block-start: 1rem;
    padding: 0.75rem;
    isolation: isolate;
  }
  .hc-pic {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 0.5rem 0.5rem 1.75rem;
    border-radius: var(--radius-xs, 0.25rem);
    background: var(--polaroid);
    box-shadow: var(--elevation-2);
    aspect-ratio: 5 / 4.4;
    transition:
      transform var(--duration-ui, 0.28s) var(--ease-out, ease),
      scale var(--duration-ui, 0.28s) var(--ease-out, ease),
      box-shadow var(--duration-ui, 0.28s) var(--ease-out, ease);
  }
  .hc-photo {
    flex: 1;
    min-height: 0;
    overflow: hidden;
    border-radius: 0.125rem;
  }
  .hc-pic :global(img),
  .hc-pic :global(picture),
  .hc :global(.hc-img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hc-pic:hover {
    z-index: 5;
    scale: 1.06;
    box-shadow: var(--elevation-3, var(--elevation-2));
  }
  /* One picture: a little askew, as if pinned; the last step's is tilted the other way. */
  .hc-deck[data-layout='one'] .hc-pic {
    transform: rotate(1.5deg);
  }
  .hc-item[data-last] .hc-deck[data-layout='one'] .hc-pic {
    transform: rotate(-3.5deg);
  }
  /* Fan: hovering the deck opens it so each card can be seen; the hovered one grows. */
  .hc-deck[data-layout='fan'] .hc-pic,
  .hc-deck[data-layout='stack'] .hc-pic {
    grid-area: 1 / 1;
  }
  .hc-deck[data-layout='fan'] {
    padding-block: 1.5rem;
  }
  .hc-deck[data-layout='fan'] .hc-pic {
    --o: calc(var(--i) - (var(--n) - 1) / 2);
    width: 64%;
    justify-self: center;
    transform: translateX(calc(var(--o) * 16%)) rotate(calc(var(--o) * 6deg));
    transform-origin: 50% 110%;
  }
  .hc-deck[data-layout='fan']:hover .hc-pic {
    transform: translateX(calc(var(--o) * 52%)) rotate(calc(var(--o) * 3deg));
  }
  .hc-deck[data-layout='stack'] {
    padding-block-end: 2.5rem;
  }
  .hc-deck[data-layout='stack'] .hc-pic {
    width: 82%;
    transform: translate(calc(var(--i) * 9%), calc(var(--i) * 9%)) rotate(calc(var(--i) * -2.5deg));
  }
  .hc-deck[data-layout='stack']:hover .hc-pic {
    transform: translate(calc(var(--i) * 14%), calc(var(--i) * 12%)) rotate(calc(var(--i) * -3deg));
  }
  /* Bento: a wide main picture; the others lie on top of it, tilted, just covering its edges (one at the top left, the rest below). */
  .hc-deck[data-layout='bento'] {
    display: block;
    padding: 1.5rem 0.75rem 3rem;
  }
  .hc-deck[data-layout='bento'] .hc-pic {
    position: absolute;
    z-index: 1;
    width: 36%;
    aspect-ratio: 1;
  }
  .hc-deck[data-layout='bento'] .hc-pic:first-child {
    position: relative;
    z-index: 0;
    width: auto;
    aspect-ratio: 16 / 10;
  }
  .hc-deck[data-layout='bento'] .hc-pic:nth-child(2) {
    inset-block-start: 0;
    inset-inline-start: -1%;
    transform: rotate(-7deg);
  }
  .hc-deck[data-layout='bento'] .hc-pic:nth-child(3) {
    inset-block-end: 1rem;
    inset-inline-start: 8%;
    transform: rotate(5deg);
  }
  .hc-deck[data-layout='bento'] .hc-pic:nth-child(4) {
    inset-block-end: 0.5rem;
    inset-inline-end: 4%;
    transform: rotate(-4deg);
  }
  .hc-deck[data-layout='bento'] .hc-pic:nth-child(5) {
    inset-block-start: 0;
    inset-inline-end: -1%;
    transform: rotate(6deg);
  }
  .hc-deck[data-layout='bento'] .hc-pic:nth-child(6) {
    inset-block-end: 0.5rem;
    inset-inline-end: 30%;
    transform: rotate(3deg);
  }
  .hc-deck[data-layout='bento'] .hc-pic:not(:first-child):hover {
    transform: rotate(0deg);
  }
  /* Scatter: polaroids dropped on the table. */
  .hc-deck[data-layout='scatter'] {
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    padding-block: 1rem 2rem;
  }
  .hc-deck[data-layout='scatter'] .hc-pic {
    aspect-ratio: 1;
    margin: -0.5rem;
    transform: translate(var(--dx), var(--dy)) rotate(var(--rx));
  }
  .hc-deck[data-layout='scatter'] .hc-pic:hover {
    transform: translate(var(--dx), var(--dy)) rotate(0deg);
  }
  /* The very last picture: hovering it throws a little party. The pieces pop in together and stay while hovered;
     when the pointer leaves they fade out one after another, slowly. */
  .hc-cheer {
    position: absolute;
    inset: -14% -12%;
    pointer-events: none;
  }
  .hc-cheer i {
    --a: calc(var(--k) * 25.7deg);
    position: absolute;
    inset-block-start: calc(50% + 50% * sin(var(--a)));
    inset-inline-start: calc(50% + 52% * cos(var(--a)));
    width: 0.75rem;
    height: 0.75rem;
    margin: -0.375rem;
    opacity: 0;
    scale: 0.3;
    rotate: calc(var(--k) * 37deg);
    background: var(--c, var(--gold));
    transition:
      opacity 1.4s ease calc(var(--k) * 0.18s),
      scale 1.4s ease calc(var(--k) * 0.18s);
  }
  .hc-cheer i:nth-child(3n) {
    --c: var(--primary);
  }
  .hc-cheer i:nth-child(3n + 1) {
    --c: var(--clay, var(--season));
  }
  .hc-cheer i[data-shape='star'] {
    width: 1.1rem;
    height: 1.1rem;
    margin: -0.55rem;
    clip-path: polygon(50% 0, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
  }
  .hc-cheer i[data-shape='dot'] {
    border-radius: 50%;
  }
  .hc-cheer i[data-shape='bar'] {
    width: 0.375rem;
    height: 1.25rem;
    border-radius: 0.125rem;
  }
  .hc-cheer i[data-shape='ring'] {
    border-radius: 50%;
    background: transparent;
    box-shadow: inset 0 0 0 0.2rem var(--c, var(--gold));
  }
  .hc-pic:hover .hc-cheer i {
    opacity: 1;
    scale: 1;
    transition:
      opacity 0.25s ease calc(var(--k) * 0.03s),
      scale 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) calc(var(--k) * 0.03s);
  }
  @media (prefers-reduced-motion: reduce) {
    .hc-pic {
      transition: none;
    }
    .hc-pic:hover {
      scale: 1;
    }
    .hc-deck:hover .hc-pic {
      transform: none;
    }
    .hc-cheer i {
      transition-duration: 0.01s;
    }
  }
  @media (max-width: 47.99rem) {
    .hc-list::before {
      inset-inline-start: 1.25rem;
    }
    .hc-item {
      grid-template-columns: 1fr;
    }
    .hc-dot,
    .hc-item[data-side='l'] .hc-dot,
    .hc-item[data-side='r'] .hc-dot {
      inset-inline-start: 1.25rem;
    }
    .hc-card,
    .hc-item[data-side='r'] .hc-card {
      grid-column: 1;
      padding-inline: 3rem 0;
      text-align: start;
    }
  }
  /* The closing invitation: open on the page, no card around it. */
  .hc-end {
    display: grid;
    justify-items: center;
    gap: 1rem;
    padding-block: 2rem 1rem;
    text-align: center;
  }
  .hc-end-kicker {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--primary);
  }
  .hc-end-t {
    max-width: 22ch;
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    line-height: 1.1;
    text-wrap: balance;
  }
  .hc-end-p {
    max-width: 52ch;
    font-size: var(--text-lg);
  }
  /* Three polaroid cards, fanned; hovering the row opens them out. Each: a themed tile with its illustration cropped 10 % at the foot. */
  .hc-ways {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 15rem));
    justify-content: center;
    margin-block: 1.5rem;
    padding-block: 1rem;
  }
  .hc-way {
    --o: calc(var(--n) - 1);
    display: grid;
    gap: 0.25rem;
    padding: 0.625rem 0.625rem 1rem;
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: var(--elevation-2);
    text-align: start;
    transform: translateX(calc(var(--o) * -14%)) rotate(calc(var(--o) * 5deg));
    transition:
      transform var(--duration-ui, 0.28s) var(--ease-out, ease),
      scale var(--duration-ui, 0.28s) var(--ease-out, ease),
      box-shadow var(--duration-ui, 0.28s) var(--ease-out, ease);
  }
  .hc-ways:hover .hc-way {
    transform: translateX(calc(var(--o) * 4%)) rotate(calc(var(--o) * 2deg));
  }
  .hc-way:hover {
    z-index: 2;
    scale: 1.05;
  }
  /* The illustration is cropped at the foot by --crop (more on the last card); the middle one stands on the bottom edge, a little larger. */
  .hc-way-art {
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--primary-soft);
    aspect-ratio: 1;
  }
  .hc-way-art :global(.illo) {
    display: block;
    width: 100%;
    margin-block-end: calc(var(--crop) * -1);
  }
  .hc-way[data-mid] .hc-way-art :global(.illo) {
    transform: scale(1.2);
    transform-origin: 50% 100%;
  }
  .hc-way-art :global(img) {
    width: 100%;
    height: auto;
  }
  .hc-way-t {
    padding-block-start: 0.5rem;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
  }
  .hc-way-p {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  @media (max-width: 47.99rem) {
    .hc-ways {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      padding-inline: 1.5rem;
    }
    .hc-way {
      transform: rotate(calc(var(--o) * 2.5deg));
    }
    .hc-ways:hover .hc-way {
      transform: rotate(calc(var(--o) * 2.5deg));
    }
    /* On a phone the pictures of a step are a little wider than the column, so they feel big. */
    .hc-deck {
      margin-inline: -2.5rem -1rem;
    }
  }
  .hc-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }
  .co-gov {
    max-width: 56ch;
    line-height: 1.7;
  }
  .co-group {
    display: grid;
    gap: 0.75rem;
  }
  .co-h {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
  }
  .co-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
  }
  .co-card {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.75rem;
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--elevation-1);
  }
  .co-card :global(.co-photo),
  .co-ph {
    flex: none;
    width: 3.5rem;
    height: 3.5rem;
    overflow: hidden;
    border-radius: 50%;
    background: var(--primary-soft);
  }
  .co-text {
    display: grid;
  }
  .co-sub {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  @media (prefers-reduced-motion: reduce) {
    .hc-path {
      transition: none;
    }
  }
</style>
