---
import {
  daysBetween,
  EVENT_KIND_STYLE,
  type EventKind,
  shortDate,
  spanDays,
  weekLabel,
  weekOf,
} from '@eec/core'
/**
 * The agenda (page « Événements »): a list by default (this week / this month / later), or a month grid
 * (`?vue=mois&mois=2026-11`, no JavaScript), filterable by group (`?groupe=jape`). Occurrences come from the
 * cached public API; cancelled ones stay visible, struck through, with their note.
 */
import Button from '@eec/ui/astro/Button.astro'
import Icon from '@eec/ui/astro/Icon.astro'
import Illustration from '@eec/ui/astro/Illustration.astro'
import Site from '../../layouts/Site.astro'
import { type EventOcc, publicJson } from '../../lib/content-api'
import {
  dayKey,
  dayText,
  eventHref,
  eventsListHref,
  feedHref,
  fmt,
  TZ,
  timeText,
} from '../../lib/events-routes'
import { localeOf, useT } from '../../lib/i18n'
import { labelKey } from '../../lib/nav'
import PageHero from '../page/PageHero.astro'
import UnavailableState from './UnavailableState.astro'

const locale = localeOf(Astro.currentLocale)
const t = useT(locale)
const q = Astro.url.searchParams
const view = q.get('vue') === 'mois' || q.get('vue') === 'month' ? 'month' : 'list'
const group = /^[a-z0-9-]{1,40}$/.test(q.get('groupe') ?? '') ? q.get('groupe') : null
const todayKey = dayKey(new Date())
const [ty, tm] = todayKey.split('-').map(Number) as [number, number]
const ym = /^\d{4}-\d{2}$/.test(q.get('mois') ?? '')
  ? (q.get('mois') as string)
  : `${ty}-${String(tm).padStart(2, '0')}`
const [y, m] = ym.split('-').map(Number) as [number, number]

// Window: the list shows the next 100 days; the month view the 6 weeks around the month.
const iso = (d: Date) => d.toISOString().slice(0, 10)
const first = new Date(Date.UTC(y, m - 1, 1))
const lead = (first.getUTCDay() + 6) % 7
const gridStart = new Date(Date.UTC(y, m - 1, 1 - lead))
const period = ['semaine', 'mois', 'dates'].includes(q.get('periode') ?? '')
  ? (q.get('periode') as string)
  : ''
const dateOk = (v: string | null) => (/^\d{4}-\d{2}-\d{2}$/.test(v ?? '') ? (v as string) : '')
const wk = weekOf(todayKey)
const monthStart = `${ty}-${String(tm).padStart(2, '0')}-01`
const monthEnd = new Date(Date.UTC(ty, tm, 0)).toISOString().slice(0, 10)
const rangeFrom = period === 'dates' ? dateOk(q.get('du')) : ''
const rangeTo = period === 'dates' ? dateOk(q.get('au')) : ''
const periodFrom = period === 'semaine' ? wk.from : period === 'mois' ? monthStart : rangeFrom
const periodTo = period === 'semaine' ? wk.to : period === 'mois' ? monthEnd : rangeTo
const from = view === 'month' ? iso(gridStart) : periodFrom || todayKey
const to =
  view === 'month'
    ? iso(new Date(gridStart.getTime() + 42 * 86_400_000))
    : periodTo
      ? iso(new Date(Date.parse(`${periodTo}T00:00:00Z`) + 86_400_000))
      : iso(new Date(Date.now() + 100 * 86_400_000))
const params = new URLSearchParams({ locale, from, to })
if (group) params.set('group', group)
const result = await publicJson<{ items: EventOcc[] }>(Astro, `/api/events/public?${params}`)
const items = result.state === 'ok' ? result.data.items : []
const groups = [
  ...new Map(
    items.filter((i) => i.groupKey).map((i) => [i.groupKey as string, i.group as string]),
  ).entries(),
]

const label = (key: string) => t(`events.site.${key}` as 'events.site.today')
const link = (extra: Record<string, string | null>) => {
  const p = new URLSearchParams()
  const merged: Record<string, string | null> = {
    vue: view === 'month' ? 'mois' : null,
    mois: view === 'month' ? ym : null,
    groupe: group,
    ...extra,
  }
  for (const [k, v] of Object.entries(merged)) if (v) p.set(k, v)
  const s = p.toString()
  return `${eventsListHref(locale)}${s ? `?${s}` : ''}`
}
const monthLabel = new Intl.DateTimeFormat(locale, {
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(first)
const shiftMonth = (n: number) => {
  const d = new Date(Date.UTC(y, m - 1 + n, 1))
  return `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}`
}

// The list is grouped by week (Monday to Sunday), headed « Semaine du … au … »; the current week is marked.
const keyOf = (o: EventOcc) => (o.allDay ? o.startsAt.slice(0, 10) : dayKey(o.startsAt))
const upcoming = items.filter((o) => spanDays(o.startsAt, o.endsAt, o.allDay, TZ).to >= todayKey)
const thisWeek = weekOf(todayKey).from
const sections = [...new Set(upcoming.map((o) => weekOf(keyOf(o)).from))].sort().map((from) => ({
  id: from,
  title: weekLabel(from, locale),
  short: (() => {
    const w = weekOf(from)
    const a = new Date(`${w.from}T12:00:00Z`)
    const b = new Date(`${w.to}T12:00:00Z`)
    const mo = (d: Date) => fmt(locale, { month: 'short', timeZone: 'UTC' }).format(d)
    return a.getUTCMonth() === b.getUTCMonth()
      ? `${a.getUTCDate()}–${b.getUTCDate()} ${mo(a)}`
      : `${a.getUTCDate()} ${mo(a)} – ${b.getUTCDate()} ${mo(b)}`
  })(),
  current: from === thisWeek,
  items: upcoming.filter((o) => weekOf(keyOf(o)).from === from),
}))
// Month view: an event covering several days shows on each of them.
const byDay = new Map<string, EventOcc[]>()
for (const o of items) {
  const span = spanDays(o.startsAt, o.endsAt, o.allDay, TZ)
  for (const d of daysBetween(span.from, span.to)) byDay.set(d, [...(byDay.get(d) ?? []), o])
}
const kindStyle = (k: string) =>
  EVENT_KIND_STYLE[(k as EventKind) in EVENT_KIND_STYLE ? (k as EventKind) : 'autre']
const rangeText = (o: EventOcc) => {
  const span = spanDays(o.startsAt, o.endsAt, o.allDay, TZ)
  const z = o.allDay ? 'UTC' : TZ
  if (span.to === span.from)
    return `${shortDate(o.startsAt, locale, z)} · ${timeText(o.startsAt, locale, o.allDay, label('all_day'))}`
  return `${shortDate(o.startsAt, locale, z)} → ${shortDate(`${span.to}T12:00:00Z`, locale, 'UTC')}`
}
const weekdays = Array.from({ length: 7 }, (_, i) =>
  fmt(locale, { weekday: 'short', timeZone: 'UTC' }).format(new Date(Date.UTC(2026, 0, 5 + i))),
)
Astro.response.headers.set(
  'cache-control',
  result.state === 'ok' ? 'public, max-age=30, stale-while-revalidate=120' : 'no-store',
)
---

<Site title={t(labelKey('evenements'))} description={t('pages.evenements.lead')}>
  <link slot="head" rel="alternate" type="text/calendar" title={t('events.site.subscribe')} href={feedHref(locale, group)} />
  <PageHero id="evenements" />
  <section class="ev">
    <div id="ev-app" class="ev-app" data-ev-app>
    <div class="ev-bar">
      <div class="ev-seg" role="group" aria-label={t(labelKey('evenements'))}>
        <a data-ev-nav href={link({ vue: null, mois: null })} aria-current={view === 'list' ? 'true' : undefined}><Icon name="layoutList" size={20} />{label('view_list')}</a>
        <a data-ev-nav href={link({ vue: 'mois', mois: ym })} aria-current={view === 'month' ? 'true' : undefined}><Icon name="calendar" size={20} />{label('view_month')}</a>
      </div>
      {view === 'list' && (
        <nav class="ev-groups ev-period" aria-label={label('period')}>
          <a data-ev-nav href={link({ periode: null, du: null, au: null })} aria-current={!period ? 'true' : undefined}>{label('period_all')}</a>
          <a data-ev-nav href={link({ periode: 'semaine', du: null, au: null })} aria-current={period === 'semaine' ? 'true' : undefined}>{label('period_week')}</a>
          <a data-ev-nav href={link({ periode: 'mois', du: null, au: null })} aria-current={period === 'mois' ? 'true' : undefined}>{label('period_month')}</a>
        </nav>
      )}
      {
        groups.length > 0 && (
          <nav class="ev-groups" aria-label={label('filter_group')}>
            <a data-ev-nav href={link({ groupe: null })} aria-current={!group ? 'true' : undefined}>{label('all_groups')}</a>
            {groups.map(([key, name]) => <a data-ev-nav href={link({ groupe: key })} aria-current={group === key ? 'true' : undefined}>{name}</a>)}
          </nav>
        )
      }
    </div>

    {view === 'list' && (
      <form class="ev-range" data-ev-form method="get" action={eventsListHref(locale)}>
        <input type="hidden" name="periode" value="dates" />
        {group && <input type="hidden" name="groupe" value={group} />}
        <label><span>{label('range_from')}</span><input type="date" name="du" value={rangeFrom} /></label>
        <label><span>{label('range_to')}</span><input type="date" name="au" value={rangeTo} min={rangeFrom || undefined} /></label>
        <Button type="submit" variant="secondary">{label('range_apply')}</Button>
      </form>
    )}
    {
      result.state === 'unavailable' ? (
        <UnavailableState />
      ) : view === 'month' ? (
        <div class="ev-month">
          <div class="ev-month-head">
            <a class="ev-step" href={link({ vue: 'mois', mois: shiftMonth(-1) })} rel="prev"><Icon name="chevronLeft" size={20} /><span class="ev-sr">{label('prev_month')}</span></a>
            <h2 class="ev-month-title">{monthLabel}</h2>
            <a class="ev-step" href={link({ vue: 'mois', mois: shiftMonth(1) })} rel="next"><span class="ev-sr">{label('next_month')}</span><span class="ev-flip"><Icon name="chevronLeft" size={20} /></span></a>
          </div>
          <div class="ev-grid">
            {weekdays.map((w, i) => <span class="ev-wd" data-sunday={i === 6 ? '' : undefined} aria-hidden="true">{w}</span>)}
            {
              Array.from({ length: 42 }, (_, i) => {
                const d = new Date(gridStart.getTime() + i * 86_400_000)
                const key = iso(d)
                const day = byDay.get(key) ?? []
                return (
                  <div class="ev-day" data-out={d.getUTCMonth() !== m - 1 ? '' : undefined} data-today={key === todayKey ? '' : undefined} data-sunday={d.getUTCDay() === 0 ? '' : undefined}>
                    <span class="ev-daynum">{d.getUTCDate()}</span>
                    {day.map((o) => (
                      <a class="ev-chip" data-cancelled={o.cancelled ? '' : undefined} href={eventHref(locale, o.slug)}>
                        <span class="ev-chip-time">{timeText(o.startsAt, locale, o.allDay, '')}</span> {o.title}
                      </a>
                    ))}
                  </div>
                )
              })
            }
          </div>
          <ul class="ev-monthlist">
            {
              items.filter((o) => o.startsAt && keyOf(o) >= iso(first) && keyOf(o) < iso(new Date(Date.UTC(y, m, 1)))).map((o) => (
                <li>
                  <a class="ev-card" data-cancelled={o.cancelled ? '' : undefined} href={eventHref(locale, o.slug)}>
                    <span class="ev-body">
                      <strong class="ev-title">{o.title}</strong>
                      <span class="ev-meta">{dayText(o.startsAt, locale, o.allDay, 'full')} · {timeText(o.startsAt, locale, o.allDay, label('all_day'))}</span>
                      {o.cancelled && <span class="ev-flag">{label('cancelled')}</span>}
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="ev-feed"><a href={feedHref(locale, group)}>{label('subscribe')}</a></p>
        </div>
      ) : sections.length === 0 ? (
        <div class="ev-empty">
          <Illustration name="calendar" class="ev-art" />
          <p class="ev-empty-title">{label(group ? 'empty_filter_t' : 'empty_t')}</p>
          <p>{label(group ? 'empty_filter_p' : 'empty_p')}</p>
          <Button href={feedHref(locale, group)} variant="secondary">{label('subscribe')}</Button>
        </div>
      ) : (
        <div class="ev-layout">
          {sections.length >= 3 && (
            <nav class="ev-toc" aria-label={label('toc')}>
              <ol>
                {sections.map((s) => (
                  <li><a href={`#ev-${s.id}`} data-ev-toc={s.id} aria-current={s.current ? 'true' : undefined}>{s.short}</a></li>
                ))}
              </ol>
            </nav>
          )}
          <div class="ev-sections">
          {
            sections.map((s) => (
              <section aria-labelledby={`ev-${s.id}`} class="ev-section">
                <h2 id={`ev-${s.id}`} class="ev-h">{s.title}{s.current && <span class="ev-now">{label('this_week')}</span>}</h2>
                <ul class="ev-list">
                  {
                    s.items.map((o) => (
                      <li>
                        <a class="ev-card" data-cancelled={o.cancelled ? '' : undefined} href={eventHref(locale, o.slug)}>
                          <span class="ev-kind" data-tone={kindStyle(o.kind).tone} aria-hidden="true"><Icon name={kindStyle(o.kind).icon as 'church'} size={24} /></span>
                          <span class="ev-body">
                            <strong class="ev-title">{o.title}</strong>
                            <span class="ev-meta">
                              {rangeText(o)}
                              {o.location ? ` · ${o.location}` : o.locationKind === 'temple' ? ` · ${label('place_temple')}` : ''}
                              {o.group ? ` · ${o.group}` : ''}
                            </span>
                            {o.cancelled && <span class="ev-flag">{label('cancelled')}{o.note ? ` — ${o.note}` : ''}</span>}
                            {o.moved && <span class="ev-flag ev-flag-moved">{label('moved')}{o.note ? ` — ${o.note}` : ''}</span>}
                          </span>
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </section>
            ))
          }
          <p class="ev-feed"><a href={feedHref(locale, group)}>{label('subscribe')}</a> · <span class="ev-feed-help">{label('subscribe_help')}</span></p>
          </div>
        </div>
      )
    }
    </div>
  </section>
</Site>

<script>
  import { initEventsNav } from '../../scripts/events-nav'
  initEventsNav()
  document.addEventListener('astro:page-load', initEventsNav)
</script>

<style>
  .ev {
    display: grid;
    gap: 1.5rem;
    width: min(100% - 2rem, 72rem);
    margin-inline: auto;
    padding-block: 2rem 4rem;
  }
  .ev-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    align-items: center;
    justify-content: space-between;
  }
  .ev-seg,
  .ev-groups {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  .ev-seg {
    padding: 0.25rem;
    border-radius: var(--radius-lg);
    background: var(--surface-2);
  }
  .ev-seg a,
  .ev-groups a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 1rem;
    border-radius: var(--radius-md);
    text-decoration: none;
  }
  .ev-groups a {
    background: var(--surface-2);
  }
  .ev-seg a[aria-current],
  .ev-groups a[aria-current] {
    background: var(--primary-soft);
    color: var(--primary);
    font-weight: 600;
  }
  .ev-range {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-lg);
    background: var(--surface-2);
  }
  .ev-range label {
    display: grid;
    gap: 0.25rem;
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .ev-range input[type='date'] {
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: inset 0 0 0 1.5px var(--line-strong);
    font-weight: 400;
  }
  .ev-layout {
    display: grid;
    gap: 2rem;
    align-items: start;
  }
  @media (min-width: 64rem) {
    .ev-layout:has(.ev-toc) {
      grid-template-columns: 11rem minmax(0, 1fr);
    }
  }
  .ev-sections {
    display: grid;
    gap: 1.5rem;
    min-width: 0;
  }
  /* A table of contents that follows the reader: one entry per week, the one in view highlighted. */
  .ev-toc {
    display: none;
  }
  @media (min-width: 64rem) {
    .ev-toc {
      display: block;
      position: sticky;
      inset-block-start: 6rem;
      padding: 0.75rem;
      border-radius: var(--radius-lg);
      background: var(--surface-2);
    }
  }
  .ev-toc ol {
    display: grid;
    gap: 0.125rem;
  }
  .ev-toc a {
    display: block;
    padding: 0.375rem 0.625rem;
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--ink-muted);
    text-decoration: none;
  }
  .ev-toc a:hover {
    background: var(--surface);
  }
  .ev-toc a[aria-current] {
    background: var(--primary-soft);
    color: var(--primary);
    font-weight: 600;
  }
  .ev-seg a {
    gap: 0.5rem;
  }
  .ev-flip {
    display: inline-flex;
    transform: scaleX(-1);
  }
  .ev-h {
    scroll-margin-block-start: 6rem;
  }
  .ev-app[data-busy] {
    opacity: 0.6;
    transition: opacity 0.15s;
  }
  .ev-section {
    display: grid;
    gap: 0.75rem;
  }
  .ev-h {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
  }
  .ev-list {
    display: grid;
    gap: 0.75rem;
  }
  .ev-card {
    display: flex;
    gap: 1rem;
    align-items: center;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-xl);
    background: var(--surface);
    box-shadow: var(--elevation-1);
    text-decoration: none;
    transition: transform var(--duration-ui) var(--ease-out);
  }
  .ev-card:hover {
    transform: translateY(-0.125rem);
  }
  .ev-kind {
    display: grid;
    flex: none;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--radius-lg);
    background: var(--primary-soft);
    color: var(--primary);
  }
  .ev-kind[data-tone='info'] {
    background: var(--info-soft, var(--primary-soft));
    color: var(--info, var(--primary));
  }
  .ev-kind[data-tone='gold'] {
    background: var(--gold-soft, var(--primary-soft));
    color: var(--gold-deep, var(--ink));
  }
  .ev-kind[data-tone='clay'] {
    background: color-mix(in oklab, var(--clay) 18%, var(--surface));
    color: var(--clay);
  }
  .ev-kind[data-tone='success'] {
    background: var(--success-soft, var(--primary-soft));
    color: var(--success, var(--primary));
  }
  .ev-now {
    margin-inline-start: 0.75rem;
    padding: 0.125rem 0.625rem;
    border-radius: var(--radius-md);
    background: var(--primary-soft);
    color: var(--primary);
    font-family: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .ev-wd[data-sunday] {
    color: var(--gold-deep, var(--ink));
  }
  .ev-day[data-sunday] {
    background: color-mix(in oklab, var(--gold) 16%, var(--surface-2));
  }
  .ev-date {
    display: grid;
    flex: none;
    place-items: center;
    width: 3.75rem;
    padding-block: 0.5rem;
    border-radius: var(--radius-lg);
    background: var(--primary-soft);
    color: var(--primary);
    line-height: 1.1;
  }
  .ev-date-d {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
  }
  .ev-date-m {
    font-size: var(--text-sm);
    text-transform: uppercase;
  }
  .ev-body {
    display: grid;
    gap: 0.125rem;
  }
  .ev-title {
    font-size: var(--text-xl);
  }
  .ev-meta {
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
  .ev-card[data-cancelled] .ev-title {
    text-decoration: line-through;
    opacity: 0.7;
  }
  .ev-flag {
    justify-self: start;
    padding-inline: 0.5rem;
    border-radius: var(--radius-md);
    background: var(--danger-soft);
    color: var(--danger);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .ev-flag-moved {
    background: var(--gold-soft, var(--surface-2));
    color: var(--ink);
  }
  .ev-empty {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    padding: 3rem 1.5rem;
    border-radius: var(--radius-xl);
    background: var(--surface-2);
    text-align: center;
  }
  .ev-empty :global(.ev-art) {
    width: min(100%, 16rem);
    height: auto;
  }
  .ev-empty-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
  }
  .ev-feed {
    font-size: var(--text-sm);
    text-align: center;
  }
  .ev-feed-help {
    color: var(--ink-muted);
  }
  .ev-month {
    display: grid;
    gap: 1rem;
  }
  .ev-month-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .ev-month-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    text-transform: capitalize;
  }
  .ev-step {
    display: inline-grid;
    place-items: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    border-radius: var(--radius-md);
    background: var(--surface-2);
    text-decoration: none;
  }
  .ev-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .ev-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 0.25rem;
  }
  .ev-wd {
    padding: 0.25rem;
    text-align: center;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-muted);
    text-transform: capitalize;
  }
  .ev-day {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    min-height: 4.5rem;
