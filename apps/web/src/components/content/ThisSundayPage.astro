---
/**
 * « Ce dimanche »: the coming Sunday (or today's until 14:00): season colour, name, theme, readings, the service
 * time (approved schedule only), and the other published Sundays. People's names appear only when the API says they
 * agreed. Data: cached public API; on a cold database a friendly state, never a 500.
 */
import { shortDate } from '@eec/core/dates'
import Button from '@eec/ui/astro/Button.astro'
import Icon from '@eec/ui/astro/Icon.astro'
import Illustration from '@eec/ui/astro/Illustration.astro'
import Site from '../../layouts/Site.astro'
import { publicJson } from '../../lib/content-api'
import { localeOf, useT } from '../../lib/i18n'
import { labelKey } from '../../lib/nav'
import UnavailableState from './UnavailableState.astro'

type Sunday = {
  date: string
  season: string
  name: string
  theme: string
  readings: { label: string }[]
  preacher: string
  liturgist: string
  hymns: string
  notes: string
  holySupper: boolean
  published: boolean
}
const locale = localeOf(Astro.currentLocale)
const t = useT(locale)
const label = (key: string, vars?: Record<string, string>) =>
  t(`liturgy.site.${key}` as 'liturgy.site.title', vars)
const [cur, list, next, verse] = await Promise.all([
  publicJson<Sunday>(Astro, `/api/liturgy/public/sunday?locale=${locale}`),
  publicJson<{ current: string; items: Sunday[] }>(
    Astro,
    `/api/liturgy/public/sundays?locale=${locale}`,
  ),
  publicJson<{ next: { startsAt: string; kind: string; when: string } | null }>(
    Astro,
    '/api/schedule/public/next',
  ),
  publicJson<{ verse: { ref: string; text: string; translation: string } | null }>(
    Astro,
    `/api/liturgy/public/verse?locale=${locale}`,
  ),
])
const s = cur.state === 'ok' ? cur.data : null
const others = list.state === 'ok' ? list.data.items.filter((x) => x.date !== s?.date) : []
const before = others
  .filter((x) => x.date < (s?.date ?? ''))
  .slice(-4)
  .reverse()
const after = others.filter((x) => x.date > (s?.date ?? '')).slice(0, 4)
const day = (d: string) => shortDate(`${d}T12:00:00Z`, locale, 'UTC')
const serviceTime =
  next.state === 'ok' && next.data.next && s && next.data.next.startsAt.slice(0, 10) >= s.date
    ? new Intl.DateTimeFormat(locale, {
        hour: '2-digit',
        minute: '2-digit',
        timeZone: 'Africa/Douala',
      }).format(new Date(next.data.next.startsAt))
    : ''
const v = verse.state === 'ok' ? verse.data.verse : null
Astro.response.headers.set(
  'cache-control',
  cur.state === 'ok' ? 'public, max-age=30, stale-while-revalidate=120' : 'no-store',
)
---

<Site title={t(labelKey('dimanche'))} description={t('liturgy.site.lead')}>
  <article class="cs" data-season={s?.season}>
    <Illustration name="cherry-blossom" class="cs-art" />
    <div class="cs-wrap">
      <header class="cs-head">
        <p class="cs-kicker"><span class="cs-dot" aria-hidden="true"></span>{label('title')}</p>
        {s && <p class="cs-date">{day(s.date)}</p>}
        <div class="cs-titlerow">
          {s && s.published && (
            <p class="cs-timetile">
              <Icon name="clock" size={24} />
              <strong>{serviceTime || '—'}</strong>
              <span>{serviceTime ? label('service_label') : label('service_soon')}</span>
            </p>
          )}
          <h1 class="cs-title">{s ? s.name : label('title')}</h1>
        </div>
        {s && (s.season !== 'ordinaire' || s.holySupper) && (
          <p class="cs-tags">
            {s.season !== 'ordinaire' && <span class="cs-chip"><span class="cs-dot" aria-hidden="true"></span>{t(`season.${s.season}` as 'season.avent')}</span>}
            {s.holySupper && <span class="cs-chip cs-chip-supper">{label('holy_supper')}</span>}
          </p>
        )}
        {s?.published && s.theme && <p class="cs-theme">{s.theme}</p>}
      </header>
      {
        cur.state === 'unavailable' ? (
          <UnavailableState />
        ) : !s || !s.published ? (
          <div class="cs-empty">
            <h2>{label('not_ready_t')}</h2>
            <p>{label('not_ready_p')}</p>
          </div>
        ) : (
          <div class="cs-grid">
            {s.readings.length > 0 && (
              <section class="cs-panel cs-readings-panel">
                <h2 class="cs-label">{label('readings')}</h2>
                <ul class="cs-readings">{s.readings.map((r) => <li>{r.label}</li>)}</ul>
              </section>
            )}
            {(s.preacher || s.liturgist || s.hymns || s.notes) && (
              <section class="cs-panel cs-facts">
                {s.preacher && <p><span class="cs-label">{label('preacher')}</span>{s.preacher}</p>}
                {s.liturgist && <p><span class="cs-label">{label('liturgist')}</span>{s.liturgist}</p>}
                {s.hymns && <p><span class="cs-label">{label('hymns')}</span>{s.hymns}</p>}
                {s.notes && <p><span class="cs-label">{label('notes')}</span>{s.notes}</p>}
              </section>
            )}
            {v && (
              <figure class="cs-panel cs-verse">
                <blockquote>{v.text}</blockquote>
                <figcaption>{v.ref} · {v.translation}</figcaption>
              </figure>
            )}
          </div>
        )
      }
      {
        (before.length > 0 || after.length > 0) && (
          <div class="cs-others">
            {after.length > 0 && (
              <section class="cs-panel">
                <h2 class="cs-h">{label('next')}</h2>
                <ul>{after.map((x) => <li><strong>{day(x.date)}</strong><span>{x.name}{x.theme ? ` · ${x.theme}` : ''}</span></li>)}</ul>
              </section>
            )}
            {before.length > 0 && (
              <section class="cs-panel">
                <h2 class="cs-h">{label('previous')}</h2>
                <ul>{before.map((x) => <li><strong>{day(x.date)}</strong><span>{x.name}{x.theme ? ` · ${x.theme}` : ''}</span></li>)}</ul>
              </section>
            )}
          </div>
        )
      }
      <p><Button href={locale === 'fr' ? '/fr/agenda/annee-liturgique/' : '/en/calendar/liturgical-year/'} variant="secondary">{t('nav.items.liturgie.label')}</Button></p>
    </div>
  </article>
</Site>

<style>
  /* An immersive page: the season tints the whole viewport, the blossom is a large backdrop, content uses the width. */
  .cs {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: calc(100svh - 4rem);
    padding-block: clamp(2rem, 6vw, 5rem);
    background: color-mix(in oklab, var(--season) 14%, var(--bg));
  }
  .cs-art {
    position: absolute;
    inset-block: -8% -8%;
    inset-inline-end: -6%;
    z-index: -1;
    width: auto;
    height: 116%;
    aspect-ratio: 1;
    transform: scaleX(-1);
    opacity: 0.9;
    pointer-events: none;
  }
  .cs-wrap {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    width: min(100% - 2rem, 80rem);
    margin-inline: auto;
  }
  .cs-head {
    display: grid;
    gap: 0.75rem;
    max-width: 52rem;
  }
  .cs-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    color: var(--ink-muted);
  }
  .cs-dot {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--season);
  }
  .cs-titlerow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }
  .cs-title {
    font-family: var(--font-display);
    font-size: clamp(var(--text-4xl), 7vw, 5.5rem);
    line-height: 1.04;
  }
  .cs-timetile {
    display: grid;
    justify-items: center;
    gap: 0.125rem;
    min-width: 6rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--elevation-1);
    color: var(--primary);
  }
  .cs-timetile strong {
    font-size: var(--text-2xl);
    line-height: 1;
  }
  .cs-timetile span {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  .cs-date {
    font-size: var(--text-xl);
    color: var(--ink-muted);
  }
  .cs-date::first-letter {
    text-transform: uppercase;
  }
  .cs-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .cs-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-md);
    background: color-mix(in oklab, var(--season) 22%, var(--surface));
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .cs-chip-supper {
    background: var(--gold-soft, var(--surface-2));
  }
  .cs-theme {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    max-width: 40rem;
  }
  .cs-grid,
  .cs-others {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 56rem) {
    .cs-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cs-verse {
      grid-column: 1 / -1;
    }
    .cs-others {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .cs-panel,
  .cs-empty {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    border-radius: var(--radius-xl);
    background: color-mix(in oklab, var(--surface) 88%, transparent);
    backdrop-filter: blur(6px);
    box-shadow: var(--elevation-1), inset 0 0 0 2px color-mix(in oklab, var(--season) 30%, transparent);
  }
  .cs-empty {
    max-width: 40rem;
  }
  .cs-label {
    display: block;
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
  }
  .cs-readings {
    display: grid;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
  }
  .cs-facts {
    font-size: var(--text-lg, 1.125rem);
  }
  .cs-verse blockquote {
    font-family: var(--font-display);
    font-size: clamp(var(--text-xl), 3vw, var(--text-3xl));
    font-style: italic;
    max-width: 52rem;
  }
  .cs-verse figcaption {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  .cs-h {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
  }
  .cs-others ul {
    display: grid;
    gap: 0.75rem;
  }
  .cs-others li {
    display: grid;
    gap: 0.125rem;
  }
  .cs-others strong {
    text-transform: capitalize;
  }
</style>
