---
/**
 * « Méditations et bulletin »: the meditation of the day (readings and psalm, as the parish prints them, references only;
 * a verse only where its text was typed in LSG 1910 / WEB), the week around it, the month's programme, a calendar download
 * built in the browser, and the week's bulletin. Everything from the cached public JSON; no programme → a friendly state.
 */
import Button from '@eec/ui/astro/Button.astro'
import Icon from '@eec/ui/astro/Icon.astro'
import Illustration from '@eec/ui/astro/Illustration.astro'
import Select from '@eec/ui/astro/Select.astro'
import Site from '../../layouts/Site.astro'
import { type MeditationDay, type MeditationPlan, publicJson } from '../../lib/content-api'
import { localeOf, useT } from '../../lib/i18n'
import { meditationsHref } from '../../lib/meditations-routes'
import { labelKey } from '../../lib/nav'
import PageHero from '../page/PageHero.astro'
import UnavailableState from './UnavailableState.astro'

const locale = localeOf(Astro.currentLocale)
const t = useT(locale)
const s = (key: string, vars?: Record<string, string>) =>
  t(`meditations.site.${key}` as 'meditations.site.psalm', vars)
const TZ = 'Africa/Douala'
const today = new Intl.DateTimeFormat('en-CA', { timeZone: TZ }).format(new Date())
const asked = Astro.url.searchParams.get('jour') ?? ''
const date =
  /^\d{4}-\d{2}-\d{2}$/.test(asked) && !Number.isNaN(Date.parse(`${asked}T00:00:00Z`))
    ? asked
    : today
const addDays = (d: string, n: number) =>
  new Date(Date.parse(`${d}T12:00:00Z`) + n * 86_400_000).toISOString().slice(0, 10)
// The week around the chosen day, Monday to Sunday.
const dow = (new Date(`${date}T12:00:00Z`).getUTCDay() + 6) % 7
const week = Array.from({ length: 7 }, (_, i) => addDays(date, i - dow))
const months = [
  ...new Set(
    [date.slice(0, 7), week[0]?.slice(0, 7), week[6]?.slice(0, 7)].filter((m): m is string => !!m),
  ),
]
type Month = { plan: MeditationPlan | null; months: string[]; month: string; days: MeditationDay[] }
const results = await Promise.all(
  months.map((m) =>
    publicJson<Month>(Astro, `/api/meditations/public/month?locale=${locale}&month=${m}`),
  ),
)
const unavailable = results.some((r) => r.state === 'unavailable')
const data = results.flatMap((r) => (r.state === 'ok' ? [r.data] : []))
const plan = data.find((d) => d.plan)?.plan ?? null
const allDays = new Map(data.flatMap((d) => d.days.map((x) => [x.date, x] as const)))
const planMonths = data.find((d) => d.months.length)?.months ?? []
const day = allDays.get(date) ?? null
Astro.response.headers.set(
  'cache-control',
  unavailable ? 'no-store' : 'public, max-age=30, stale-while-revalidate=120',
)
const fmt = (d: string, o: Intl.DateTimeFormatOptions) =>
  new Intl.DateTimeFormat(locale, { ...o, timeZone: 'UTC' }).format(new Date(`${d}T12:00:00Z`))
const cap = (x: string) => x.charAt(0).toUpperCase() + x.slice(1)
const monthLabel = (m: string) => cap(fmt(`${m}-01`, { month: 'long', year: 'numeric' }))
const monthFor = Astro.url.searchParams.get('mois') ?? date.slice(0, 7)
const monthDays = await publicJson<Month>(
  Astro,
  `/api/meditations/public/month?locale=${locale}&month=${/^\d{4}-\d{2}$/.test(monthFor) ? monthFor : date.slice(0, 7)}`,
)
const listed = monthDays.state === 'ok' ? monthDays.data.days : []
const base = meditationsHref(locale)
const link = (d: string) => `${base}?jour=${d}`
const labelText = (l: string) => (l ? s(`label_${l}`) : '')
---

<Site title={t(labelKey('meditations'))} description={t('pages.meditations.lead')}>
  <PageHero id="meditations" />
  <section class="md">
    {
      unavailable ? (
        <UnavailableState />
      ) : !plan ? (
        <div class="md-empty">
          <Illustration name="news" class="md-art" />
          <p class="md-empty-title">{s('no_plan_t')}</p>
          <p>{s('no_plan_p')}</p>
        </div>
      ) : (
        <>
          <div class="md-live" data-live-area>
            <section class="md-today" aria-labelledby="md-today-h">
              <header class="md-today-head">
                <div>
                  <p class="md-kicker">{date === today ? s('today_h') : plan.title}</p>
                  <h2 id="md-today-h" class="md-date">{cap(fmt(date, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }))}</h2>
                  {day?.headline && <p class="md-headline">{day.headline}</p>}
                </div>
                <nav class="md-nav" aria-label={s('week_h')}>
                  <Button data-live-nav href={link(addDays(date, -1))} variant="secondary" size="sm"><Icon name="arrowLeft" size={16} />{s('prev')}</Button>
                  {date !== today && <Button data-live-nav href={base} variant="ghost" size="sm">{s('today')}</Button>}
                  <Button data-live-nav href={link(addDays(date, 1))} variant="secondary" size="sm">{s('next')}<Icon name="arrowRight" size={16} /></Button>
                </nav>
              </header>
              {
                day ? (
                  <>
                    <ul class="md-readings">
                      {day.readings.map((r) => (
                        <li>
                          {r.label && <span class="md-label">{labelText(r.label)}</span>}
                          <strong>{r.ref}</strong>
                        </li>
                      ))}
                      {day.psalm && (
                        <li data-psalm>
                          <span class="md-label">{s('psalm')}</span>
                          <strong>{day.psalm.replace(/^(Psaume|Psalm)\s/, '')}</strong>
                        </li>
                      )}
                    </ul>
                    {day.verse && (
                      <figure class="md-verse">
                        <blockquote>{day.verse.text}</blockquote>
                        <figcaption>{day.verse.ref} · {day.verse.translation}</figcaption>
                      </figure>
                    )}
                    {day.reflection && <p class="md-reflection"><strong>{s('reflection')}</strong> {day.reflection}</p>}
                  </>
                ) : (
                  <div class="md-nodays"><p class="md-empty-title">{s('no_day_t')}</p><p>{s('no_day_p')}</p></div>
                )
              }
            </section>

            <section class="md-week" aria-labelledby="md-week-h">
              <h2 id="md-week-h" class="md-h">{s('week_h')}</h2>
              <ol class="md-week-grid">
                {
                  week.map((d) => {
                    const x = allDays.get(d)
                    return (
                      <li>
                        <a data-live-nav class="md-day" href={link(d)} aria-current={d === date ? 'date' : undefined} data-today={d === today ? '' : undefined}>
                          <span class="md-day-w">{cap(fmt(d, { weekday: 'short' }))}</span>
                          <span class="md-day-n">{fmt(d, { day: 'numeric' })}</span>
                          <span class="md-day-r">{x ? [...x.readings.map((r) => r.ref), x.psalm].filter(Boolean)[0]?.replace(/^(Psaume|Psalm)\s/, '') : '—'}</span>
                          {x?.headline && <span class="md-day-h">{x.headline}</span>}
                        </a>
                      </li>
                    )
                  })
                }
              </ol>
            </section>
          </div>

          <section class="md-month" aria-labelledby="md-month-h">
            <div class="md-month-head">
              <h2 id="md-month-h" class="md-h">{s('month_h')}</h2>
              <form method="get" action={base} class="md-month-form" data-month-form>
                <label for="md-month">{s('month')}</label>
                <Select id="md-month" name="mois" value={monthFor} options={planMonths.map((m) => ({ value: m, label: monthLabel(m) }))} />
                <noscript><button type="submit" class="btn btn-secondary">{s('goto')}</button></noscript>
              </form>
            </div>
            <ul class="md-list">
              {
                listed.map((x) => (
                  <li>
                    <a href={link(x.date)} aria-current={x.date === date ? 'date' : undefined}>
                      <span class="md-list-d">{cap(fmt(x.date, { weekday: 'short', day: 'numeric' }))}</span>
                      <span class="md-list-t">{x.headline && <em>{x.headline}</em>}{[...x.readings.map((r) => r.ref), x.psalm].filter(Boolean).join(' · ')}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </section>

          <section class="md-cal" data-med-calendar data-locale={locale} data-busy={s('calendar_busy')} data-error={s('calendar_error')} data-label={plan.slug} aria-labelledby="md-cal-h">
            <h2 id="md-cal-h" class="md-h">{s('calendar_h')}</h2>
            <p>{s('calendar_p')}</p>
            <div class="md-cal-row">
              <label>{s('calendar_time')}<input class="input" type="time" value="06:00" /></label>
              <label class="md-check"><input type="checkbox" data-from-today checked />{s('calendar_from')}</label>
              <button type="button" class="btn btn-primary" data-go>{s('calendar_go')}</button>
            </div>
            <p class="md-cal-status" data-status role="status"></p>
          </section>
        </>
      )
    }
  </section>
</Site>

<script>
  import { initLiveNav } from '../../scripts/live-nav'
  import { initMeditationCalendar } from '../../scripts/meditation-calendar'
  const bind = () => {
    initLiveNav()
    initMeditationCalendar()
    const form = document.querySelector<HTMLFormElement>('[data-month-form]')
    if (form && !form.dataset.bound) {
      form.dataset.bound = '1'
      form.addEventListener('change', () => form.requestSubmit())
    }
  }
  bind()
  document.addEventListener('astro:page-load', bind)
</script>

<style>
  .md {
    display: grid;
    gap: 2.5rem;
    width: min(100% - 2rem, 64rem);
    margin-inline: auto;
    padding-block: 2rem 4rem;
  }
  .md-live {
    display: grid;
    gap: 2rem;
  }
  .md-h {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
  }
  .md-today {
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: var(--radius-xl);
    background: var(--surface);
    box-shadow: var(--elevation-1);
  }
  .md-today-head {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
  }
  .md-kicker {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--primary);
  }
  .md-date {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    line-height: 1.1;
  }
  .md-headline {
    display: inline-block;
    margin-block-start: 0.5rem;
    padding: 0.125rem 0.625rem;
    border-radius: var(--radius-md);
    background: var(--gold-soft, var(--primary-soft));
    font-weight: 600;
  }
  .md-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .md-readings {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }
  .md-readings li {
    display: grid;
    gap: 0.25rem;
    padding: 1rem 1.125rem;
    border-radius: var(--radius-lg);
    background: var(--primary-soft);
  }
  .md-readings li[data-psalm] {
    background: var(--surface-2);
  }
  .md-label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .md-readings strong {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 500;
  }
  .md-verse {
    display: grid;
    gap: 0.5rem;
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius-lg);
    background: var(--surface-2);
  }
  .md-verse blockquote {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.35;
  }
  .md-verse figcaption {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  .md-reflection {
    max-width: 62ch;
    color: var(--ink-muted);
  }
  .md-week {
    display: grid;
    gap: 0.75rem;
  }
  .md-week-grid {
    display: grid;
    gap: 0.5rem;
    grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));
  }
  .md-day {
    display: grid;
    gap: 0.125rem;
    height: 100%;
    padding: 0.75rem;
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--elevation-1);
    color: inherit;
    text-decoration: none;
  }
  .md-day:hover {
    background: var(--primary-soft);
  }
  .md-day[aria-current='date'] {
    background: var(--primary);
    color: var(--on-primary);
  }
  .md-day[data-today]:not([aria-current]) {
    box-shadow: inset 0 0 0 2px var(--gold);
  }
  .md-day-w {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    opacity: 0.75;
  }
  .md-day-n {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: 1;
  }
  .md-day-r {
    font-size: var(--text-sm);
  }
  .md-day-h {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--primary);
  }
  .md-day[aria-current='date'] .md-day-h {
    color: inherit;
  }
  .md-month {
    display: grid;
    gap: 1rem;
  }
  .md-month-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }
  .md-month-form {
    display: grid;
    gap: 0.25rem;
    min-width: min(100%, 14rem);
  }
  .md-month-form label {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  .md-list {
    display: grid;
    gap: 0.25rem;
  }
  .md-list a {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 0.75rem;
    min-height: 2.75rem;
    align-items: center;
    padding: 0.5rem 0.875rem;
    border-radius: var(--radius-md);
    color: inherit;
    text-decoration: none;
  }
  .md-list a:hover {
    background: var(--surface-2);
  }
  .md-list a[aria-current='date'] {
    background: var(--primary-soft);
  }
  .md-list-d {
    font-weight: 600;
  }
  .md-list-t em {
    display: block;
    font-style: normal;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--primary);
  }
  .md-cal {
    display: grid;
    gap: 0.75rem;
    padding: 1.5rem;
    border-radius: var(--radius-xl);
    background: var(--surface-2);
  }
  .md-cal p {
    max-width: 62ch;
    color: var(--ink-muted);
  }
  .md-cal-row {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 1rem;
  }
  .md-cal-row label {
    display: grid;
    gap: 0.25rem;
    font-size: var(--text-sm);
  }
  .md-check {
    display: flex !important;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
  }
  .md-cal-status {
    color: var(--danger) !important;
  }
  .md-empty,
  .md-nodays {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    padding: 3rem 1.5rem;
    border-radius: var(--radius-xl);
    background: var(--surface-2);
    text-align: center;
  }
  .md-empty :global(.md-art) {
    width: min(100%, 16rem);
    height: auto;
  }
  .md-empty-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
  }
</style>
