---
import { localeOf, useT } from '../../lib/i18n'

const t = useT(localeOf(Astro.currentLocale))
---

<p class="fallback-note" role="note">{t('news.site.fallback_note')}</p>

<style>
  .fallback-note {
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    background: var(--gold-soft, var(--surface-2));
    font-size: var(--text-sm);
  }
</style>
