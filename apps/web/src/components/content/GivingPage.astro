---
/**
 * « Donner »: gratitude first. Only approved giving values are shown (settings → Donner, per field). Before any is
 * approved, the earlier warm « bientôt » text stays, with the secretariat contact. No payment integration, no amounts,
 * no donor data. During the Fête des Moissons dates a highlighted block appears.
 */
import Button from '@eec/ui/astro/Button.astro'
import Icon from '@eec/ui/astro/Icon.astro'
import Illustration from '@eec/ui/astro/Illustration.astro'
import '../../styles/richtext.css'
import Site from '../../layouts/Site.astro'
import { publicJson } from '../../lib/content-api'
import { localeOf, useT } from '../../lib/i18n'
import { href, labelKey, pages } from '../../lib/nav'
import type { StoryData } from '../../lib/story-routes'
import PageView from '../PageView.astro'
import PageHero from '../page/PageHero.astro'

const locale = localeOf(Astro.currentLocale)
const t = useT(locale)
const s = (key: string) => t(`settings.site.${key}` as 'settings.site.copy')
const [settings, story] = await Promise.all([
  publicJson<{ giving?: Record<string, string>; season?: Record<string, string> }>(
    Astro,
    '/api/settings/public',
  ),
  publicJson<StoryData>(Astro, `/api/story/public?locale=${locale}`),
])
const g = settings.state === 'ok' ? (settings.data.giving ?? {}) : {}
const season = settings.state === 'ok' ? (settings.data.season ?? {}) : {}
const usage = story.state === 'ok' ? story.data.slots.give?.usage : undefined
const today = new Date().toISOString().slice(0, 10)
const inMoissons = !!(
  season.moissonsStart &&
  season.moissonsEnd &&
  today >= season.moissonsStart &&
  today <= season.moissonsEnd
)
const dial = (code: string) => `tel:${code.replace(/#/g, '%23')}`
const methods = [
  { id: 'momo', label: s('momo'), name: g.momoName, number: g.momoNumber, code: g.momoCode },
  { id: 'om', label: s('om'), name: g.omName, number: g.omNumber, code: g.omCode },
].filter((m) => m.number || m.code)
const bank = g.bankAccount
  ? { name: g.bankName, holder: g.bankHolder, account: g.bankAccount }
  : null
const purposes = [
  { id: 'dime', icon: 'church', title: s('purpose_dime'), text: g.purposeDime },
  { id: 'offrande', icon: 'gift', title: s('purpose_offrande'), text: g.purposeOffrande },
  { id: 'projets', icon: 'home', title: s('purpose_projets'), text: g.purposeProjets },
].filter((p) => p.text)
const moissons = g.purposeMoissons
const ready = methods.length > 0 || !!bank
const trouver = href(locale, pages.find((p) => p.id === 'trouver')?.path[locale] ?? '')
Astro.response.headers.set(
  'cache-control',
  settings.state === 'ok' ? 'public, max-age=30, stale-while-revalidate=120' : 'no-store',
)
---

<Site title={t(labelKey('give'))} description={t('pages.give.lead')}>
  <PageHero id="give" />
  {
    ready ? (
      <div class="gv">
        <section class="gv-thanks">
          <div>
            <p class="gv-kicker">{s('thanks_k')}</p>
            <h2 class="gv-big">{s('thanks').split('**').map((part, i) => (i % 2 ? <em>{part}</em> : part))}</h2>
          </div>
          <Illustration name="valentines-bouquet" class="gv-art" />
        </section>

        {inMoissons && moissons && (
          <section class="gv-moissons">
            <span class="gv-purpose-icon" aria-hidden="true"><Icon name="plant" size={24} /></span>
            <div>
              <h2>{s('moissons_t')}</h2>
              <p>{moissons}</p>
            </div>
          </section>
        )}

        <section aria-labelledby="gv-how">
          <h2 id="gv-how" class="gv-h">{s('how_t')}</h2>
          <ol class="gv-steps">
            <li><span class="gv-n">1</span><strong>{s('step1_t')}</strong><span>{s('step1_p')}</span></li>
            <li><span class="gv-n">2</span><strong>{s('step2_t')}</strong><span>{s('step2_p')}</span></li>
            <li><span class="gv-n">3</span><strong>{s('step3_t')}</strong><span>{s('step3_p')}</span></li>
          </ol>
        </section>

        <section aria-labelledby="gv-methods">
          <h2 id="gv-methods" class="gv-h">{s('methods_t')}</h2>
          <div class="gv-grid">
            {methods.map((m) => (
              <article class="gv-card" data-method={m.id}>
                <header class="gv-card-head">
                  <span class="gv-card-icon" aria-hidden="true"><Icon name={m.id === 'momo' ? 'phone' : 'money'} size={24} /></span>
                  <h3>{m.label}</h3>
                </header>
                {m.name && <p class="gv-merchant"><span>{s('merchant')}</span>{m.name}</p>}
                {m.number && (
                  <div class="gv-number">
                    <span>{s('number')}</span>
                    <strong>{m.number}</strong>
                    <button type="button" class="btn btn-secondary" data-copy={m.number.replace(/\s+/g, '')} data-copied={s('copied')}>
                      <Icon name="copy" size={20} /><span data-copy-label>{s('copy')}</span>
                    </button>
                  </div>
                )}
                {m.code && (
                  <div class="gv-number gv-code">
                    <span>{s('code')}</span>
                    <strong>{m.code}</strong>
                    <div class="gv-pair">
                      <a class="btn btn-primary gv-dial" href={dial(m.code)}><Icon name="phone" size={20} />{s('dial')}</a>
                      <button type="button" class="btn btn-secondary" data-copy={m.code} data-copied={s('copied')}>
                        <Icon name="copy" size={20} /><span data-copy-label>{s('copy_code')}</span>
                      </button>
                    </div>
                  </div>
                )}
              </article>
            ))}
            {bank && (
              <article class="gv-card" data-method="bank">
                <header class="gv-card-head">
                  <span class="gv-card-icon" aria-hidden="true"><Icon name="shield" size={24} /></span>
                  <h3>{s('bank')}</h3>
                </header>
                {bank.name && <p class="gv-merchant"><span>{s('bank_name')}</span>{bank.name}</p>}
                {bank.holder && <p class="gv-merchant"><span>{s('holder')}</span>{bank.holder}</p>}
                <div class="gv-number">
                  <span>{s('account')}</span>
                  <strong>{bank.account}</strong>
                  <button type="button" class="btn btn-secondary" data-copy={bank.account} data-copied={s('copied')}>
                    <Icon name="copy" size={20} /><span data-copy-label>{s('copy')}</span>
                  </button>
                </div>
              </article>
            )}
          </div>
        </section>

        {purposes.length > 0 && (
          <section aria-labelledby="gv-purposes">
            <h2 id="gv-purposes" class="gv-h">{s('purposes')}</h2>
            <ul class="gv-tiles">
              {purposes.map((p) => (
                <li class="gv-tile">
                  <span class="gv-purpose-icon" aria-hidden="true"><Icon name={p.icon as 'church'} size={24} /></span>
                  <h3>{p.title}</h3>
                  <p>{p.text}</p>
                </li>
              ))}
            </ul>
          </section>
        )}

        {usage && (
          <section class="gv-usage" aria-labelledby="gv-usage">
            <h2 id="gv-usage" class="gv-h">{s('usage')}</h2>
            <div class="gv-usage-body" set:html={usage.html} />
          </section>
        )}
      </div>
    ) : (
      <>
        <PageView id="give" hideHeader />
        <section class="gv gv-soon">
          <h2>{s('soon_t')}</h2>
          <p>{s('soon_p')}</p>
          <Button href={trouver}>{s('soon_cta')}</Button>
        </section>
      </>
    )
  }
</Site>

<script>
  import { initCopy } from '../../scripts/copy-number'
  initCopy()
  document.addEventListener('astro:page-load', initCopy)
</script>

<style>
  .gv {
    display: grid;
    gap: 2.5rem;
    width: min(100% - 2rem, 68rem);
    margin-inline: auto;
    padding-block: 2.5rem 4rem;
  }
  .gv-h {
    margin-block-end: 1rem;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
  }
  /* Gratitude first: a big thank-you with the illustration. */
  .gv-thanks {
    display: grid;
    align-items: center;
    gap: 1.5rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    overflow: hidden;
    border-radius: var(--radius-xl);
    background: color-mix(in oklab, var(--season) 14%, var(--surface));
    box-shadow: var(--elevation-1);
  }
  @media (min-width: 48rem) {
    .gv-thanks {
      grid-template-columns: 1fr minmax(0, 24rem);
    }
  }
  .gv-kicker {
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--primary);
  }
  .gv-big {
    font-family: var(--font-display);
    font-size: clamp(var(--text-3xl, 2rem), 4.5vw, 3.25rem);
    line-height: 1.08;
  }
  /* The bouquet stands on the card's lower edge and is cropped downward by it. */
  .gv-big em {
    font-weight: 700;
    font-style: italic;
    color: var(--primary);
  }
  .gv-thanks :global(.gv-art) {
    width: min(100%, 27rem);
    height: auto;
    justify-self: center;
    align-self: end;
    margin-block-end: -4.5rem;
    translate: 0 14%;
  }
  .gv-moissons {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius-xl);
    background: var(--gold-soft);
    box-shadow: inset 0 0 0 2px color-mix(in oklab, var(--gold) 55%, transparent);
  }
  .gv-moissons h2 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
  }
  /* Three steps. */
  .gv-steps {
    display: grid;
    gap: 0.75rem;
    counter-reset: step;
  }
  @media (min-width: 48rem) {
    .gv-steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .gv-steps li {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--elevation-1);
  }
  .gv-steps li > span:last-child {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  .gv-n {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin-block-end: 0.25rem;
    border-radius: 50%;
    background: var(--primary);
    color: var(--surface);
    font-weight: 700;
  }
  /* The ways to give: one tall card each, tinted, with the number large and a copy button. */
  .gv-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
  }
  .gv-card {
    --tone: var(--primary-soft);
    --ink-tone: var(--primary);
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: 1rem;
    border-radius: var(--radius-xl);
    background: var(--surface);
    box-shadow: var(--elevation-1);
  }
  .gv-card[data-method='momo'] {
    --tone: var(--gold-soft);
    --ink-tone: var(--gold-ink);
  }
  .gv-card[data-method='om'] {
    --tone: color-mix(in oklab, var(--clay) 16%, var(--surface));
    --ink-tone: var(--clay-ink);
  }
  .gv-card-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
    border-radius: var(--radius-lg);
    background: var(--tone);
    color: var(--ink-tone);
  }
  .gv-card-head h3 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--ink);
  }
  .gv-card-icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-md);
    background: var(--surface);
  }
  .gv-merchant {
    display: grid;
    padding-inline: 0.25rem;
    font-weight: 600;
  }
  .gv-merchant span,
  .gv-number > span {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
  }
  .gv-number {
    display: grid;
    gap: 0.5rem;
    padding: 0.75rem;
    border-radius: var(--radius-lg);
    background: var(--surface-2);
  }
  .gv-number strong {
    font-family: var(--font-display);
    font-size: clamp(var(--text-2xl), 4vw, 2rem);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    overflow-wrap: anywhere;
  }
  .gv-pair {
    display: grid;
    gap: 0.5rem;
  }
  /* A tap-to-dial link is for phones; on a computer the code is simply shown and can be copied. */
  @media (hover: hover) and (pointer: fine) {
    .gv-dial {
      display: none;
    }
  }
  /* What gifts are for: icon tiles. */
  .gv-tiles {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }
  .gv-tile {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: 1.25rem;
    border-radius: var(--radius-xl);
    background: var(--surface);
    box-shadow: var(--elevation-1);
  }
  .gv-tile h3 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
  }
  .gv-tile p {
    color: var(--ink-muted);
  }
  .gv-purpose-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-lg);
    background: var(--primary-soft);
    color: var(--primary);
  }
  .gv-moissons .gv-purpose-icon {
    background: var(--surface);
    color: var(--gold-ink);
  }
  .gv-usage {
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: var(--radius-xl);
    background: var(--surface-2);
  }
  .gv-usage-body {
    max-width: 62ch;
    line-height: 1.7;
  }
  .gv-usage-body :global(> * + *) {
    margin-block-start: 0.75em;
  }
  .gv-soon {
    justify-items: start;
    padding-block-start: 0;
  }
  .gv-soon h2 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
  }
</style>
