---
/**
 * Search: server-rendered, works without JavaScript (`?q=`), cached briefly per query by the API. Results are grouped
 * by type with highlighted excerpts; static pages are matched here from the site's own page list.
 */
import Button from '@eec/ui/astro/Button.astro'
import Icon from '@eec/ui/astro/Icon.astro'
import Illustration from '@eec/ui/astro/Illustration.astro'
import Site from '../../layouts/Site.astro'
import { type EventOcc, publicJson } from '../../lib/content-api'
import { eventHref } from '../../lib/events-routes'
import { guideHref } from '../../lib/guides-routes'
import { localeOf, useT } from '../../lib/i18n'
import { descKey, href, labelKey, pages } from '../../lib/nav'
import { content } from '../../lib/pages'
import {
  type Hit,
  highlight,
  hitHref,
  matchPages,
  SEARCH_TYPES,
  searchHref,
} from '../../lib/search'

const locale = localeOf(Astro.currentLocale)
const t = useT(locale)
const s = (key: string, vars?: Record<string, string>) => t(`search.${key}` as 'search.title', vars)
const raw = (Astro.url.searchParams.get('q') ?? '').replace(/\s+/g, ' ').trim().slice(0, 80)
const q = raw.length >= 2 ? raw : ''
const tooShort = raw.length === 1

const api = q
  ? await publicJson<{ items: (Omit<Hit, 'type'> & { type: Hit['type'] })[] }>(
      Astro,
      `/api/search?q=${encodeURIComponent(q)}&locale=${locale}`,
    )
  : null
const unavailable = api?.state === 'unavailable'
const apiHits = api?.state === 'ok' ? api.data.items : []
const pageEntries = pages
  .filter((p) => !['account', 'search', 'privacy', 'legal', 'credits'].includes(p.id))
  .map((p) => {
    const lead = content[p.id]?.lead
    return {
      path: p.path[locale],
      title: t(labelKey(p.id)),
      text: `${t(descKey(p.id))}${lead ? ` ${t(lead)}` : ''}`.trim(),
    }
  })
const hits: Hit[] = [...apiHits, ...(q ? matchPages(q, pageEntries) : [])]
const grouped = SEARCH_TYPES.map((type) => ({
  type,
  items: hits.filter((h) => h.type === type),
})).filter((g) => g.items.length)

// Suggestions for the empty state: a few guides and the next event.
const [guides, next] = !q
  ? await Promise.all([
      publicJson<{ items: { slug: string; title: string }[] }>(
        Astro,
        `/api/guides/public?locale=${locale}`,
      ),
      publicJson<{ items: EventOcc[] }>(Astro, `/api/events/public/next?locale=${locale}`),
    ])
  : [null, null]
const suggestGuides = guides?.state === 'ok' ? guides.data.items.slice(0, 3) : []
const nextEvent = next?.state === 'ok' ? next.data.items?.[0] : undefined
Astro.response.headers.set('cache-control', 'no-store')
---

<Site title={s('title')} noindex>
  <section class="sr">
    <h1 class="sr-title">{s('title')}</h1>
    <form class="sr-form" role="search" method="get" action={searchHref(locale)}>
      <label class="sr-label" for="sr-q">{s('dialog_title')}</label>
      <div class="sr-field">
        <Icon name="search" size={20} />
        <input id="sr-q" class="sr-input" type="search" name="q" value={q || raw} placeholder={s('placeholder')} autocomplete="off" maxlength="80" />
        <Button type="submit">{s('go')}</Button>
      </div>
    </form>
    {tooShort && <p class="sr-note" role="status">{s('min')}</p>}
    {
      unavailable ? (
        <p class="sr-note" role="status">{s('unavailable')}</p>
      ) : q ? (
        grouped.length === 0 ? (
          <div class="sr-empty">
            <Illustration name="book-lover" class="sr-art" />
            <h2>{s('empty_t', { q })}</h2>
            <p>{s('empty_p')}</p>
            <ul class="sr-links">
              {pageEntries.slice(0, 6).map((p) => <li><a href={href(locale, p.path)}>{p.title}</a></li>)}
            </ul>
          </div>
        ) : (
          <>
            <p class="sr-count" role="status">{hits.length === 1 ? s('count_one') : s('count', { n: String(hits.length) })}</p>
            {
              grouped.map((g) => (
                <section class="sr-group">
                  <h2 class="sr-h">{s(`type_${g.type}`)}</h2>
                  <ul class="sr-list">
                    {g.items.map((h) => (
                      <li class="sr-item">
                        <a class="sr-link" href={hitHref(locale, h)} set:html={highlight(h.title, q)} />
                        {h.snippet && <p class="sr-snip" set:html={highlight(h.snippet, q)} />}
                      </li>
                    ))}
                  </ul>
                </section>
              ))
            }
          </>
        )
      ) : (
        <div class="sr-empty">
          <Illustration name="book-lover" class="sr-art" />
          <h2>{s('start_t')}</h2>
          <p>{s('start_p')}</p>
          {(suggestGuides.length > 0 || nextEvent) && (
            <div class="sr-suggest">
              <h3>{s('suggest_t')}</h3>
              <ul class="sr-links">
                {suggestGuides.map((g) => <li><a href={guideHref(locale, g.slug)}>{g.title}</a></li>)}
                {nextEvent && <li><a href={eventHref(locale, nextEvent.slug)}>{s('suggest_event')} : {nextEvent.title}</a></li>}
              </ul>
            </div>
          )}
        </div>
      )
    }
  </section>
</Site>

<style>
  .sr {
    display: grid;
    gap: 1.25rem;
    width: min(100% - 2rem, 48rem);
    margin-inline: auto;
    padding-block: 2.5rem 4rem;
  }
  .sr-title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
  }
  .sr-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .sr-field {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.375rem 0.375rem 0.375rem 1rem;
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: inset 0 0 0 1.5px var(--line-strong);
  }
  .sr-field:focus-within {
    box-shadow: inset 0 0 0 2px var(--focus, var(--gold));
  }
  .sr-input {
    flex: 1;
    min-width: 0;
    min-height: 2.75rem;
    background: none;
    font-size: var(--text-lg, 1.125rem);
    outline: none;
  }
  .sr-input,
  .sr-input:focus,
  .sr-input:focus-visible {
    box-shadow: none;
    border: 0;
    outline: none;
    appearance: none;
  }
  .sr-input::-webkit-search-cancel-button {
    display: none;
  }
  .sr-note,
  .sr-count {
    color: var(--ink-muted);
  }
  .sr-group {
    display: grid;
    gap: 0.625rem;
  }
  .sr-h {
    font-family: var(--font-display);
    font-size: var(--text-xl);
  }
  .sr-list {
    display: grid;
    gap: 0.75rem;
  }
  .sr-item {
    display: grid;
    gap: 0.125rem;
    padding: 0.875rem 1rem;
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--elevation-1);
  }
  .sr-link {
    font-weight: 600;
    color: var(--primary);
    text-decoration: none;
  }
  .sr-snip {
    color: var(--ink-muted);
  }
  .sr :global(mark) {
    background: var(--gold-soft, var(--primary-soft));
    color: inherit;
    border-radius: 0.2em;
    padding-inline: 0.1em;
  }
  .sr-empty {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    padding: 2rem 1rem;
    border-radius: var(--radius-xl);
    background: var(--surface-2);
    text-align: center;
  }
  .sr-empty :global(.sr-art) {
    width: min(100%, 14rem);
    height: auto;
  }
  .sr-empty h2 {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
  }
  .sr-suggest {
    display: grid;
    gap: 0.5rem;
    margin-block-start: 0.75rem;
  }
  .sr-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1rem;
  }
  .sr-links a {
    color: var(--primary);
  }
</style>
