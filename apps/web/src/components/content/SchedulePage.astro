---
/**
 * Cultes et horaires: with approved slots, a calm week (Monday to Sunday) with each slot's time, place and a
 * calendar link, plus the changes of the next 14 days. With none approved, the static « bientôt » text stays
 * (nothing unvalidated is ever shown). Data: cached public API.
 */
import { shortDate } from '@eec/core/dates'
import Icon from '@eec/ui/astro/Icon.astro'
import Illustration from '@eec/ui/astro/Illustration.astro'
import Site from '../../layouts/Site.astro'
import { type PublicSlot, type PublicSlotException, publicJson } from '../../lib/content-api'
import { localeOf, useT } from '../../lib/i18n'
import { labelKey } from '../../lib/nav'
import PageView from '../PageView.astro'
import PageHero from '../page/PageHero.astro'
import UnavailableState from './UnavailableState.astro'

const locale = localeOf(Astro.currentLocale)
const t = useT(locale)
const label = (key: string, vars?: Record<string, string>) =>
  t(`schedule.site.${key}` as 'schedule.site.title', vars)
const result = await publicJson<{ slots: PublicSlot[]; exceptions: PublicSlotException[] }>(
  Astro,
  '/api/schedule/public',
)
const slots = result.state === 'ok' ? result.data.slots : []
const exceptions = result.state === 'ok' ? result.data.exceptions : []
const name = (s: { labelFr?: string; labelEn?: string }) =>
  locale === 'en' && s.labelEn ? s.labelEn : (s.labelFr ?? '')
const note = (e: PublicSlotException) => (locale === 'en' ? e.noteEn || e.noteFr : e.noteFr) ?? ''
const dayName = (wd: number) =>
  new Intl.DateTimeFormat(locale, { weekday: 'long', timeZone: 'UTC' }).format(
    new Date(Date.UTC(2026, 0, 4 + wd)),
  )
const order = [1, 2, 3, 4, 5, 6, 0]
const todayDow = new Date(
  `${new Intl.DateTimeFormat('en-CA', { timeZone: 'Africa/Douala' }).format(new Date())}T00:00:00Z`,
).getUTCDay()
const horizon = new Date(Date.now() + 14 * 86_400_000).toISOString().slice(0, 10)
const soon = exceptions.filter((e) => e.date <= horizon)
const dateText = (d: string) => shortDate(`${d}T12:00:00Z`, locale, 'UTC')
const hasSlots = slots.length > 0
Astro.response.headers.set(
  'cache-control',
  result.state === 'ok' ? 'public, max-age=30, stale-while-revalidate=120' : 'no-store',
)
---

<Site title={t(labelKey('cultes'))} description={t('pages.cultes.lead')}>
  <PageHero id="cultes" />
  {
    result.state === 'unavailable' ? (
      <section class="sc"><UnavailableState /></section>
    ) : hasSlots ? (
      <section class="sc" aria-labelledby="sc-title">
        <h2 id="sc-title" class="sc-h">{label('title')}</h2>
        {
          soon.length > 0 && (
            <div class="sc-changes" role="note">
              <h3 class="sc-sub">{label('next14')}</h3>
              <ul>
                {
                  soon.map((e) => {
                    const target = slots.find((s) => s.id === e.slotId)
                    return (
                      <li data-kind={e.kind}>
                        <strong>{dateText(e.date)}</strong>
                        {' — '}
                        {e.kind === 'cancelled' ? label('cancelled') : e.kind === 'changed' ? `${label('changed')}${e.start ? ` (${e.start})` : ''}` : `${label('extra')}${e.start ? ` ${e.start}` : ''}`}
                        {target ? ` · ${name(target)}` : e.kind === 'extra' ? ` · ${name(e)}` : ''}
                        {note(e) ? ` · ${note(e)}` : ''}
                      </li>
                    )
                  })
                }
              </ul>
            </div>
          )
        }
        <div class="sc-week" data-week data-nojs>
          {
            order.map((wd) => {
              const day = slots.filter((s) => s.weekday === wd)
              return (
                <section class="sc-day" data-day={wd} data-today={wd === todayDow ? '' : undefined} data-empty={day.length === 0 ? '' : undefined} aria-label={dayName(wd)}>
                  {wd === todayDow && <span class="sc-today">{label('today')}</span>}
                  <h3 class="sc-dayname" data-day-name>
                    {dayName(wd)}
                    {day.length > 0 && <span class="sc-count" data-day-count>{day.length === 1 ? label('count_one') : label('count', { n: String(day.length) })}</span>}
                  </h3>
                  {
                    day.length === 0 ? (
                      <p class="sc-none">{label('all_day_off')}</p>
                    ) : (
                      <>
                        <ul class="sc-list">
                          {
                            day.map((s, i) => (
                              <li class:list={['sc-slot', i >= 2 && 'sc-extra']}>
                                <span class="sc-time">{s.start}{s.end ? `–${s.end}` : ''}</span>
                                <span class="sc-label">{name(s)}</span>
                                {(locale === 'en' ? s.placeEn : s.placeFr) && <span class="sc-place">{locale === 'en' ? s.placeEn : s.placeFr}</span>}
                                <a class="sc-ics" href={`/api/schedule/public/slot/${s.id}/slot.ics?locale=${locale}`} download>{label('add_ics')}</a>
                              </li>
                            ))
                          }
                        </ul>
                        {day.length > 2 && (
                          <button type="button" class="sc-more" data-more>{label('read_more', { n: String(day.length) })}<Icon name="arrowRight" size={16} /></button>
                        )}
                      </>
                    )
                  }
                </section>
              )
            })
          }
        </div>
        <dialog class="sc-modal" data-day-dialog aria-labelledby="sc-modal-title">
          <header class="sc-modal-head">
            <h3 id="sc-modal-title" class="sc-dayname" data-modal-title></h3>
            <button type="button" class="btn btn-ghost btn-icon" data-day-close aria-label={label('close')}><Icon name="close" size={20} /></button>
          </header>
          <ul class="sc-list sc-modal-list" data-modal-list></ul>
        </dialog>
        <Illustration name="music" class="sc-art" />
      </section>
    ) : null
  }
  <PageView id="cultes" hideHeader omit={hasSlots ? [1] : []} />
</Site>

<script>
  import { initDays } from '../../scripts/schedule-days'
  initDays()
  document.addEventListener('astro:page-load', initDays)
</script>

<style>
  .sc {
    display: grid;
    gap: 1.25rem;
    width: min(100% - 2rem, 72rem);
    margin-inline: auto;
    padding-block: 2rem 1rem;
  }
  .sc-h {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
  }
  .sc-sub {
    font-weight: 600;
    margin-block-end: 0.5rem;
  }
  .sc-changes {
    padding: 1rem 1.25rem;
    border-radius: var(--radius-lg);
    background: var(--gold-soft, var(--surface-2));
  }
  .sc-changes ul {
    display: grid;
    gap: 0.375rem;
  }
  .sc-changes li[data-kind='cancelled'] strong {
    text-decoration: line-through;
  }
  .sc-week {
    display: grid;
    gap: 0.75rem;
    align-items: stretch;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
  }
  .sc-day {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    align-content: start;
    gap: 0.5rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-xl);
    background: var(--surface);
    box-shadow: var(--elevation-1);
  }
  .sc-day[data-empty] {
    background: var(--surface-2);
    box-shadow: none;
  }
  .sc-day[data-today] {
    box-shadow: inset 0 0 0 2px var(--primary), var(--elevation-1);
  }
  .sc-dayname {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.625rem;
    padding-inline-end: 5.5rem;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    text-transform: capitalize;
  }
  /* How many times the day holds. */
  .sc-count {
    padding: 0.0625rem 0.5rem;
    border-radius: var(--radius-md);
    background: var(--primary-soft);
    color: var(--primary);
    font-family: var(--font-sans, inherit);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: none;
    white-space: nowrap;
  }
  /* Today: a clear chip in the top right corner of its card. */
  .sc-today {
    position: absolute;
    inset-block-start: 0.75rem;
    inset-inline-end: 0.75rem;
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-md);
    background: var(--primary);
    color: var(--surface);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  /* Each card shows two times at most; the rest opens in a modal (all shown without script). */
  .sc-week[data-js] .sc-extra {
    display: none;
  }
  .sc-week[data-nojs] .sc-more {
    display: none;
  }
  .sc-more {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 2.25rem;
    color: var(--primary);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
  }
  .sc-more:hover {
    text-decoration: underline;
  }
  .sc-modal {
    width: min(100% - 2rem, 30rem);
    max-height: min(85svh, 40rem);
    margin: auto;
    padding: 1.25rem 1.5rem;
    overflow: auto;
    border-radius: var(--radius-xl);
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--elevation-3);
  }
  .sc-modal::backdrop {
    background: color-mix(in oklab, var(--ink) 35%, transparent);
    backdrop-filter: blur(3px);
  }
  .sc-modal-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-block-end: 0.75rem;
  }
  .sc-modal .sc-dayname {
    padding-inline-end: 0;
  }
  .sc-modal-list {
    display: grid;
    gap: 0.875rem;
  }
  .sc-modal-list .sc-extra {
    display: grid;
  }
  ::view-transition-group(sc-morph) {
    animation-duration: 0.45s;
    animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
  }
  ::view-transition-old(sc-morph),
  ::view-transition-new(sc-morph) {
    height: 100%;
    object-fit: cover;
  }
  .sc-none {
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
  .sc-day ul {
    display: grid;
    align-content: start;
    gap: 0.75rem;
  }
  .sc-slot {
    display: grid;
    align-content: start;
    gap: 0.125rem;
  }
  .sc-time {
    font-weight: 700;
    color: var(--primary);
  }
  .sc-place {
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
  .sc-ics {
    justify-self: start;
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  .sc :global(.sc-art) {
    width: min(100%, 18rem);
    height: auto;
    justify-self: center;
  }
</style>
