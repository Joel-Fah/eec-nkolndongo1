---
/** One event: date block, place, group, description, coming dates, add to calendar, share. `token`: preview link. */
import Button from '@eec/ui/astro/Button.astro'
import '../../styles/richtext.css'
import Site from '../../layouts/Site.astro'
import { type EventDetail, publicJson } from '../../lib/content-api'
import { dayText, eventHref, eventsListHref, fmt, TZ, timeText } from '../../lib/events-routes'
import { localeOf, useT } from '../../lib/i18n'
import Picture from '../Picture.astro'
import LangFallbackNote from './LangFallbackNote.astro'
import UnavailableState from './UnavailableState.astro'

interface Props {
  slug?: string
  token?: string
}
const { slug, token } = Astro.props
const locale = localeOf(Astro.currentLocale)
const t = useT(locale)
const label = (key: string, vars?: Record<string, string>) =>
  t(`events.site.${key}` as 'events.site.today', vars)
const preview = !!token
type Found = { found: true; event: EventDetail } | { found: false }
const result = preview
  ? await publicJson<EventDetail>(
      Astro,
      `/api/events/public/preview/${encodeURIComponent(token ?? '')}?locale=${locale}`,
    )
  : await publicJson<Found>(
      Astro,
      `/api/events/public/item/${encodeURIComponent(slug ?? '')}?locale=${locale}`,
    )
let ev: EventDetail | null = null
if (result.state === 'ok') {
  const d = result.data as Found | EventDetail
  if ('found' in d) ev = d.found ? d.event : null
  else ev = d
}
const unavailable = result.state === 'unavailable'
if (!ev && !unavailable) Astro.response.status = 404
Astro.response.headers.set(
  'cache-control',
  preview || !ev ? 'no-store' : 'public, max-age=30, stale-while-revalidate=120',
)
if (preview) Astro.response.headers.set('x-robots-tag', 'noindex, nofollow')

const url = ev ? new URL(eventHref(locale, ev.slug), Astro.url).href : ''
const wa = ev ? `https://wa.me/?text=${encodeURIComponent(`${ev.title}\n${url}`)}` : ''
const icsHref = ev ? `/api/events/public/item/${ev.slug}/event.ics?locale=${locale}` : ''
// Google Calendar template link (opens their site only when clicked; nothing is loaded from them).
const stamp = (iso: string) => iso.replace(/[-:]/g, '').replace(/\.\d{3}/, '')
const google = ev
  ? `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(ev.title)}&dates=${stamp(ev.startsAt)}/${stamp(ev.endsAt ?? ev.startsAt)}&location=${encodeURIComponent(ev.location)}&details=${encodeURIComponent(url)}`
  : ''
const tz = ev?.allDay ? 'UTC' : TZ
const d = ev ? new Date(ev.startsAt) : new Date()
---

<Site title={ev?.title ?? label('not_found_t')} description={ev?.description} noindex={preview || !ev}>
  <article class="ed">
    <p class="ed-back"><a href={eventsListHref(locale)}>← {label('back')}</a></p>
    {preview && <p class="ed-preview" role="note">{label('preview_banner')}</p>}
    {
      unavailable ? (
        <UnavailableState />
      ) : !ev ? (
        <div class="ed-missing">
          <h1>{label('not_found_t')}</h1>
          <p>{label('not_found_p')}</p>
          <Button href={eventsListHref(locale)}>{label('back')}</Button>
        </div>
      ) : (
        <>
          <header class="ed-head">
            <span class="ed-date" aria-hidden="true">
              <span class="ed-date-d">{fmt(locale, { day: 'numeric', timeZone: tz }).format(d)}</span>
              <span class="ed-date-m">{fmt(locale, { month: 'short', timeZone: tz }).format(d)}</span>
            </span>
            <div class="ed-titles">
              <h1 class="ed-title" data-cancelled={ev.cancelled ? '' : undefined}>{ev.title}</h1>
              <p class="ed-when">{dayText(ev.startsAt, locale, ev.allDay, 'full')} · {timeText(ev.startsAt, locale, ev.allDay, label('all_day'))}{ev.endsAt && !ev.allDay ? ` – ${timeText(ev.endsAt, locale, false, '')}` : ''}</p>
              <p class="ed-where">{ev.location || (ev.locationKind === 'temple' ? label('place_temple') : '')}{ev.group ? ` · ${label('group', { name: ev.group })}` : ''}</p>
              {ev.cancelled && <p class="ed-flag">{label('cancelled')}{ev.note ? ` — ${ev.note}` : ''}</p>}
              {ev.moved && <p class="ed-flag ed-flag-moved">{label('moved')}{ev.note ? ` — ${ev.note}` : ''}</p>}
            </div>
          </header>
          {ev.fallback && <LangFallbackNote />}
          {ev.cover && <Picture class="ed-cover" media={ev.cover} sizes="(min-width: 48rem) 46rem, 100vw" eager decorative />}
          {ev.html && <div class="ed-body" set:html={ev.html} />}
          {
            ev.recurring && ev.upcoming.length > 1 && (
              <section class="ed-dates" aria-labelledby="ed-dates-t">
                <h2 id="ed-dates-t" class="ed-h">{label('coming_dates')}</h2>
                <ul>
                  {
                    ev.upcoming.slice(0, 6).map((o) => (
                      <li data-cancelled={o.cancelled ? '' : undefined}>
                        {dayText(o.startsAt, locale, ev.allDay, 'full')} · {timeText(o.startsAt, locale, ev.allDay, label('all_day'))}
                        {o.cancelled ? ` — ${label('cancelled')}${o.note ? ` (${o.note})` : ''}` : o.moved ? ` — ${label('moved')}` : ''}
                      </li>
                    ))
                  }
                </ul>
              </section>
            )
          }
          <section class="ed-actions" aria-labelledby="ed-add-t">
            <h2 id="ed-add-t" class="ed-h">{label('add_to_calendar')}</h2>
            <div class="ed-buttons">
              <Button href={icsHref} variant="secondary" download>{label('add_ics')}</Button>
              <Button href={google} variant="secondary" target="_blank" rel="noopener noreferrer">{label('add_google')}</Button>
              {ev.registrationUrl && <Button href={ev.registrationUrl} target="_blank" rel="noopener noreferrer">{label('register')}</Button>}
              <Button href={wa} variant="secondary" target="_blank" rel="noopener noreferrer">{label('share_whatsapp')}</Button>
            </div>
          </section>
        </>
      )
    }
  </article>
</Site>

<style>
  .ed {
    display: grid;
    gap: 1.5rem;
    width: min(100% - 2rem, 46rem);
    margin-inline: auto;
    padding-block: 2rem 4rem;
  }
  .ed-back a {
    color: var(--ink-muted);
  }
  .ed-preview {
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    background: var(--gold-soft, var(--surface-2));
    font-weight: 600;
  }
  .ed-head {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }
  .ed-date {
    display: grid;
    flex: none;
    place-items: center;
    width: 5rem;
    padding-block: 0.75rem;
    border-radius: var(--radius-xl);
    background: var(--primary-soft);
    color: var(--primary);
    line-height: 1.1;
  }
  .ed-date-d {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
  }
  .ed-date-m {
    text-transform: uppercase;
    font-weight: 600;
  }
  .ed-titles {
    display: grid;
    gap: 0.375rem;
  }
  .ed-title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    line-height: 1.08;
  }
  .ed-title[data-cancelled] {
    text-decoration: line-through;
    opacity: 0.7;
  }
  .ed-when {
    font-size: var(--text-xl);
  }
  .ed-where {
    color: var(--ink-muted);
  }
  .ed-flag {
    justify-self: start;
    padding-inline: 0.5rem;
    border-radius: var(--radius-md);
    background: var(--danger-soft);
    color: var(--danger);
    font-weight: 600;
  }
  .ed-flag-moved {
    background: var(--gold-soft, var(--surface-2));
    color: var(--ink);
  }
  .ed :global(.ed-cover) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-xl);
    object-fit: cover;
  }
  .ed-body {
    font-size: var(--text-lg, 1.125rem);
    line-height: 1.75;
  }
  .ed-body :global(> * + *) {
    margin-block-start: 1em;
  }
  .ed-body :global(ul) {
    list-style: disc;
    padding-inline-start: 1.5rem;
  }
  .ed-body :global(ol) {
    list-style: decimal;
    padding-inline-start: 1.5rem;
  }
  .ed-body :global(a) {
    color: var(--primary);
    text-decoration: underline;
  }
  .ed-h {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
  }
  .ed-dates ul {
    display: grid;
    gap: 0.5rem;
    margin-block-start: 0.5rem;
  }
  .ed-dates li {
    padding: 0.625rem 0.875rem;
    border-radius: var(--radius-md);
    background: var(--surface-2);
  }
  .ed-dates li[data-cancelled] {
    text-decoration: line-through;
    opacity: 0.7;
  }
  .ed-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 0.75rem;
  }
  .ed-missing {
    display: grid;
    justify-items: start;
    gap: 1rem;
  }
</style>
