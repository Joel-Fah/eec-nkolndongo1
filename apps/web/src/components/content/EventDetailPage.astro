---
/** One event: date block, place, group, description, coming dates, add to calendar, share. `token`: preview link. */
import { EVENT_KIND_STYLE, type EventKind, spanDays } from '@eec/core'
import Button from '@eec/ui/astro/Button.astro'
import '../../styles/richtext.css'
import Icon from '@eec/ui/astro/Icon.astro'
import Site from '../../layouts/Site.astro'
import { type EventDetail, publicJson } from '../../lib/content-api'
import { dayText, eventHref, eventsListHref, fmt, TZ, timeText } from '../../lib/events-routes'
import { localeOf, useT } from '../../lib/i18n'
import Picture from '../Picture.astro'
import GeneratedBanner from './GeneratedBanner.astro'
import GoogleCalendarIcon from './GoogleCalendarIcon.astro'
import LangFallbackNote from './LangFallbackNote.astro'
import UnavailableState from './UnavailableState.astro'

interface Props {
  slug?: string
  token?: string
}
const { slug, token } = Astro.props
const locale = localeOf(Astro.currentLocale)
const t = useT(locale)
const label = (key: string, vars?: Record<string, string>) =>
  t(`events.site.${key}` as 'events.site.today', vars)
const preview = !!token
type Found = { found: true; event: EventDetail } | { found: false }
const result = preview
  ? await publicJson<EventDetail>(
      Astro,
      `/api/events/public/preview/${encodeURIComponent(token ?? '')}?locale=${locale}`,
    )
  : await publicJson<Found>(
      Astro,
      `/api/events/public/item/${encodeURIComponent(slug ?? '')}?locale=${locale}`,
    )
let ev: EventDetail | null = null
if (result.state === 'ok') {
  const d = result.data as Found | EventDetail
  if ('found' in d) ev = d.found ? d.event : null
  else ev = d
}
const unavailable = result.state === 'unavailable'
if (!ev && !unavailable) Astro.response.status = 404
Astro.response.headers.set(
  'cache-control',
  preview || !ev ? 'no-store' : 'public, max-age=30, stale-while-revalidate=120',
)
if (preview) Astro.response.headers.set('x-robots-tag', 'noindex, nofollow')

const url = ev ? new URL(eventHref(locale, ev.slug), Astro.url).href : ''
const wa = ev ? `https://wa.me/?text=${encodeURIComponent(`${ev.title}\n${url}`)}` : ''
const icsHref = ev ? `/api/events/public/item/${ev.slug}/event.ics?locale=${locale}` : ''
// Google Calendar template link (opens their site only when clicked; nothing is loaded from them).
const stamp = (iso: string) => iso.replace(/[-:]/g, '').replace(/\.\d{3}/, '')
const google = ev
  ? `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(ev.title)}&dates=${stamp(ev.startsAt)}/${stamp(ev.endsAt ?? ev.startsAt)}&location=${encodeURIComponent(ev.location)}&details=${encodeURIComponent(url)}`
  : ''
const tz = ev?.allDay ? 'UTC' : TZ
const span = ev ? spanDays(ev.startsAt, ev.endsAt, ev.allDay, TZ) : null
const kind =
  EVENT_KIND_STYLE[((ev?.kind as EventKind) in EVENT_KIND_STYLE ? ev?.kind : 'autre') as EventKind]
const d = ev ? new Date(ev.startsAt) : new Date()
---

<Site title={ev?.title ?? label('not_found_t')} description={ev?.description} noindex={preview || !ev}>
  <article class="ed">
    <p class="ed-back"><a href={eventsListHref(locale)}><Icon name="chevronLeft" size={20} />{label('back')}</a></p>
    {preview && <p class="ed-preview" role="note">{label('preview_banner')}</p>}
    {
      unavailable ? (
        <UnavailableState />
      ) : !ev ? (
        <div class="ed-missing">
          <h1>{label('not_found_t')}</h1>
          <p>{label('not_found_p')}</p>
          <Button href={eventsListHref(locale)}>{label('back')}</Button>
        </div>
      ) : (
        <>
          <div class="ed-banner" data-tone={kind.tone}>
            {ev.cover ? <Picture class="ed-cover" media={ev.cover} sizes="(min-width: 72rem) 68rem, 100vw" eager decorative /> : <GeneratedBanner seed={ev.slug} tone={kind.tone} />}
            <span class="ed-kind" data-tone={kind.tone}><Icon name={kind.icon as 'church'} size={24} />{label(`kind_${ev.kind}`)}</span>
          </div>
          <div class="ed-layout">
            <div class="ed-main">
              <header class="ed-head">
                <h1 class="ed-title" data-cancelled={ev.cancelled ? '' : undefined}>{ev.title}</h1>
                {ev.cancelled && <p class="ed-flag">{label('cancelled')}{ev.note ? ` — ${ev.note}` : ''}</p>}
                {ev.moved && <p class="ed-flag ed-flag-moved">{label('moved')}{ev.note ? ` — ${ev.note}` : ''}</p>}
              </header>
              {ev.fallback && <LangFallbackNote />}
              {ev.html ? <div class="ed-body" set:html={ev.html} /> : null}
              {
                ev.recurring && ev.upcoming.length > 1 && (
                  <section class="ed-dates" aria-labelledby="ed-dates-t">
                    <h2 id="ed-dates-t" class="ed-h">{label('coming_dates')}</h2>
                    <ul>
                      {
                        ev.upcoming.slice(0, 6).map((o) => (
                          <li data-cancelled={o.cancelled ? '' : undefined}>
                            {dayText(o.startsAt, locale, ev.allDay)} · {timeText(o.startsAt, locale, ev.allDay, label('all_day'))}
                            {o.cancelled ? ` — ${label('cancelled')}${o.note ? ` (${o.note})` : ''}` : o.moved ? ` — ${label('moved')}` : ''}
                          </li>
                        ))
                      }
                    </ul>
                  </section>
                )
              }
            </div>
            <aside class="ed-side" aria-label={label('recap')}>
              <div class="ed-card">
                <h2 class="ed-card-t">{label('recap')}</h2>
                <ul class="ed-facts">
                  <li><Icon name="calendar" size={20} /><span>{span && span.to !== span.from ? `${dayText(ev.startsAt, locale, ev.allDay)} → ${dayText(`${span.to}T12:00:00Z`, locale, true)}` : dayText(ev.startsAt, locale, ev.allDay)}</span></li>
                  {!ev.allDay && <li><Icon name="clock" size={20} /><span>{timeText(ev.startsAt, locale, false, '')}{ev.endsAt ? ` – ${timeText(ev.endsAt, locale, false, '')}` : ''}</span></li>}
                  <li><Icon name="location" size={20} /><span>{ev.location || (ev.locationKind === 'temple' ? label('place_temple') : label('place_other'))}</span></li>
                  {ev.group && <li><Icon name="users" size={20} /><span>{ev.group}</span></li>}
                  {ev.recurring && <li><Icon name="refresh" size={20} /><span>{label('repeats')}</span></li>}
                </ul>
                <div class="ed-actions">
                  <h3 class="ed-card-sub">{label('add_to_calendar')}</h3>
                  <a class="ed-action" href={google} target="_blank" rel="noopener noreferrer"><GoogleCalendarIcon /><span>{label('add_google')}</span><Icon name="external" size={16} /></a>
                  <a class="ed-action" href={icsHref} download><Icon name="calendar" size={20} /><span>{label('add_ics')}</span></a>
                  {ev.registrationUrl && <a class="ed-action ed-action-primary" href={ev.registrationUrl} target="_blank" rel="noopener noreferrer"><Icon name="check" size={20} /><span>{label('register')}</span><Icon name="external" size={16} /></a>}
                  <a class="ed-action" href={wa} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" size={20} /><span>{label('share_whatsapp')}</span><Icon name="external" size={16} /></a>
                </div>
              </div>
            </aside>
          </div>
        </>
      )
    }
  </article>
</Site>

<style>
  .ed {
    display: grid;
    gap: 1.5rem;
    width: min(100% - 2rem, 72rem);
    margin-inline: auto;
    padding-block: 2rem 4rem;
  }
  .ed-back a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--ink-muted);
    text-decoration: none;
  }
  .ed-preview {
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    background: var(--gold-soft, var(--surface-2));
    font-weight: 600;
  }
  .ed-banner {
    position: relative;
    overflow: hidden;
    width: 100%;
    height: clamp(13rem, 28vw, 22rem);
    border-radius: var(--radius-xl);
    background: var(--surface-2);
  }
  .ed-banner :global(.ed-cover) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ed-kind {
    position: absolute;
    inset-block-end: 1rem;
    inset-inline-start: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.875rem 0.375rem 0.625rem;
    border-radius: var(--radius-md);
    background: color-mix(in oklab, var(--surface) 88%, transparent);
    backdrop-filter: blur(6px);
    color: var(--primary);
    font-weight: 600;
    box-shadow: var(--elevation-1);
  }
  .ed-kind[data-tone='gold'] {
    color: var(--gold-deep, var(--ink));
  }
  .ed-kind[data-tone='clay'] {
    color: var(--clay);
  }
  .ed-kind[data-tone='info'] {
    color: var(--info, var(--primary));
  }
  .ed-kind[data-tone='success'] {
    color: var(--success, var(--primary));
  }
  .ed-layout {
    display: grid;
    gap: 1.5rem;
    align-items: start;
  }
  @media (min-width: 64rem) {
    .ed-layout {
      grid-template-columns: minmax(0, 1fr) 20rem;
      gap: 2rem;
    }
    .ed-side {
      position: sticky;
      inset-block-start: 6rem;
    }
  }
  /* On small screens the recap comes first: it is what most visitors came for. */
  @media (max-width: 63.99rem) {
    .ed-side {
      order: -1;
    }
  }
  .ed-main {
    display: grid;
    gap: 1.5rem;
    min-width: 0;
  }
  .ed-head {
    display: grid;
    gap: 0.5rem;
  }
  .ed-title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    line-height: 1.08;
  }
  .ed-title[data-cancelled] {
    text-decoration: line-through;
    opacity: 0.7;
  }
  .ed-flag {
    justify-self: start;
    padding-inline: 0.5rem;
    border-radius: var(--radius-md);
    background: var(--danger-soft);
    color: var(--danger);
    font-weight: 600;
  }
  .ed-flag-moved {
    background: var(--gold-soft, var(--surface-2));
    color: var(--ink);
  }
  .ed-card {
    display: grid;
    gap: 1rem;
    padding: 1.25rem;
    border-radius: var(--radius-xl);
    background: var(--surface);
    box-shadow: var(--elevation-1);
  }
  .ed-card-t {
    font-family: var(--font-display);
    font-size: var(--text-xl);
  }
  .ed-card-sub {
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
  }
  .ed-facts {
    display: grid;
    gap: 0.625rem;
  }
  .ed-facts li {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
  }
  .ed-facts li :global(svg) {
    flex: none;
    color: var(--primary);
  }
  .ed-actions {
    display: grid;
    gap: 0.5rem;
    padding: 0.75rem;
    border-radius: var(--radius-lg);
    background: var(--surface-2);
  }
  .ed-action {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    text-decoration: none;
    transition: background-color var(--duration-micro) var(--ease-out);
  }
  .ed-action > span {
    flex: 1;
  }
  .ed-action:hover {
    background: var(--primary-soft);
  }
  .ed-action :global(svg) {
    flex: none;
  }
  .ed-action-primary {
    background: var(--primary);
    color: var(--on-primary);
    box-shadow: none;
  }
  .ed-action-primary:hover {
    background: color-mix(in oklab, var(--primary) 88%, var(--ink));
  }
  .ed-body {
    font-size: var(--text-lg, 1.125rem);
    line-height: 1.75;
  }
  .ed-body :global(> * + *) {
    margin-block-start: 1em;
  }
  .ed-body :global(ul) {
    list-style: disc;
    padding-inline-start: 1.5rem;
  }
  .ed-body :global(ol) {
    list-style: decimal;
    padding-inline-start: 1.5rem;
  }
  .ed-body :global(a) {
    color: var(--primary);
    text-decoration: underline;
  }
  .ed-h {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
  }
  .ed-dates ul {
    display: grid;
    gap: 0.5rem;
    margin-block-start: 0.5rem;
  }
  .ed-dates li {
    padding: 0.625rem 0.875rem;
    border-radius: var(--radius-md);
    background: var(--surface-2);
  }
  .ed-dates li[data-cancelled] {
    text-decoration: line-through;
    opacity: 0.7;
  }
  .ed-missing {
    display: grid;
    justify-items: start;
    gap: 1rem;
  }
</style>
