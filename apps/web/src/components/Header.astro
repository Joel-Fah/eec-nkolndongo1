---
import Icon from '@eec/ui/astro/Icon.astro'
import Illustration from '@eec/ui/astro/Illustration.astro'
import { localeOf, useT } from '../lib/i18n'
import { alternates, descKey, href, labelKey, pages, tabKey, tabs } from '../lib/nav'
import SiteLockup from './SiteLockup.astro'
import ThemeToggle from './ThemeToggle.astro'

const locale = localeOf(Astro.currentLocale)
const t = useT(locale)
const other = locale === 'fr' ? 'en' : 'fr'
const switchHref = alternates(Astro.url.pathname)[other]
const home = href(locale, '')
const accountPath = pages.find((p) => p.id === 'account')?.path[locale] ?? ''
const current = Astro.url.pathname
const active = (slug: string) => current.startsWith(`/${locale}/${slug}`)
---

<header class="site-header" data-header>
  <div class="site-header-bar">
    <a href={home} class="site-brand" aria-label={`${t('site.name')} — ${t('nav.home')}`}>
      <SiteLockup variant="three" class="site-lockup-narrow text-[0.95rem]" />
      <SiteLockup variant="two" class="site-lockup-wide text-[0.95rem]" />
    </a>

    <nav class="site-nav" aria-label={t('nav.main')}>
      <ul class="site-nav-list" role="list">
        {
          tabs.map((tab) => {
            const slug = tab.slug[locale]
            return (
              <li data-menu={tab.children.length ? '' : undefined}>
                {tab.children.length ? (
                  <>
                    <button type="button" class="navlink" data-menu-trigger aria-expanded="false" aria-controls={`panel-${tab.id}`} aria-current={active(slug) ? 'true' : undefined}>
                      <Icon name={tab.icon} size={20} />
                      {t(tabKey(tab.id))}
                      <span class="eec-chevron" aria-hidden="true" />
                    </button>
                    <div id={`panel-${tab.id}`} class="mega" data-menu-panel hidden>
                      <div class="mega-grid">
                        <ul class="mega-list" role="list">
                          {tab.children.map((child, i) => {
                            const to = href(locale, `${slug}/${child.slug[locale]}`)
                            return (
                              <li>
                                <a class="mega-item" data-i={i} href={to} aria-current={current.startsWith(to) ? 'page' : undefined}>
                                  <span class="mega-icon"><Icon name={child.icon} size={20} /></span>
                                  <span class="mega-text">
                                    <span class="mega-label">{t(labelKey(child.id))}</span>
                                    <span class="mega-desc">{t(descKey(child.id))}</span>
                                  </span>
                                </a>
                              </li>
                            )
                          })}
                        </ul>
                        {/* One illustration per item, cropped by the panel; the hovered/focused item's one shows. */}
                        <aside class="mega-art" aria-hidden="true">
                          <div class="mega-art-text-wrap">
                            <p class="mega-art-title">{t(`nav.panel.${tab.id}.title` as 'nav.panel.discover.title')}</p>
                            <p class="mega-art-text">{t(`nav.panel.${tab.id}.text` as 'nav.panel.discover.text')}</p>
                          </div>
                          {tab.children.map((child, i) => <Illustration name={child.art} class="mega-illustration" data-art={i} />)}
                        </aside>
                      </div>
                    </div>
                  </>
                ) : (
                  <a class="navlink" href={href(locale, slug)} aria-current={active(slug) ? 'page' : undefined}>
                    <Icon name={tab.icon} size={20} />
                    {t(tabKey(tab.id))}
                  </a>
                )}
              </li>
            )
          })
        }
      </ul>
    </nav>

    <div class="site-tools">
      <button type="button" class="btn btn-ghost btn-icon site-tool-desktop" aria-label={t('nav.search')} disabled title={t('nav.search')}>
        <Icon name="search" />
      </button>
      <a href={switchHref} hreflang={other} lang={other} class="btn btn-ghost site-lang site-tool-desktop" aria-label={t('common.language.switch_label')} title={t('nav.language_short')}>
        {other.toUpperCase()}
      </a>
      <span class="site-tool-desktop"><ThemeToggle /></span>
      <a href={href(locale, accountPath)} class="btn btn-secondary btn-icon site-tool-desktop" aria-label={t('nav.account')} title={t('nav.account')}>
        <Icon name="account" />
      </a>
      <button type="button" class="btn btn-ghost btn-icon site-menu-button" data-dialog-open="mobile-menu" aria-haspopup="dialog" aria-label={t('nav.open_menu')}>
        <Icon name="menu" size={24} />
      </button>
    </div>
  </div>

  <dialog id="mobile-menu" class="sheet mobile-menu" data-side="full" aria-label={t('nav.main')}>
    <div class="mobile-menu-inner">
      <div class="mobile-menu-top">
        <a href={home} class="mobile-menu-brand"><SiteLockup variant="three" class="text-[0.95rem]" /></a>
        <button type="button" class="btn btn-secondary btn-icon mobile-menu-x" data-dialog-close aria-label={t('nav.close_menu')}><Icon name="close" size={24} /></button>
      </div>
      <nav aria-label={t('nav.main')} class="mobile-menu-nav">
        {
          tabs.map((tab) => {
            const slug = tab.slug[locale]
            return tab.children.length ? (
              <details class="accordion-item mobile-card" name="mobile-nav" open={active(slug)}>
                <summary class="accordion-trigger">
                  <span class="mobile-row"><span class="mega-icon"><Icon name={tab.icon} /></span>{t(tabKey(tab.id))}</span>
                  <span class="eec-chevron" aria-hidden="true" />
                </summary>
                <ul class="mobile-sub" role="list">
                  {tab.children.map((child) => (
                    <li>
                      <a class="mega-item" href={href(locale, `${slug}/${child.slug[locale]}`)}>
                        <span class="mega-icon"><Icon name={child.icon} size={20} /></span>
                        <span class="mega-text"><span class="mega-label">{t(labelKey(child.id))}</span><span class="mega-desc">{t(descKey(child.id))}</span></span>
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ) : (
              <a class="mobile-card mobile-link" href={href(locale, slug)}>
                <span class="mobile-row"><span class="mega-icon"><Icon name={tab.icon} /></span>{t(tabKey(tab.id))}</span>
              </a>
            )
          })
        }
      </nav>
      <div class="mobile-menu-tools" role="group" aria-label={t('nav.utilities')}>
        <a href={href(locale, accountPath)} class="btn btn-secondary"><Icon name="account" />{t('nav.account')}</a>
        <a href={switchHref} hreflang={other} lang={other} class="btn btn-ghost"><Icon name="language" />{t('common.language.switch_to')}</a>
        <ThemeToggle />
      </div>
      <button type="button" class="btn btn-primary mobile-menu-close" data-dialog-close>
        <Icon name="close" />{t('nav.close_menu')}
      </button>
    </div>
  </dialog>
</header>

<script>
  import { initHeader } from '../scripts/header'
  document.addEventListener('astro:page-load', initHeader)
</script>

<style is:global>
  /* The bar floats: inset from the edges, rounded on every corner, blurred. */
  .site-header {
    position: sticky;
    inset-block-start: 0.75rem;
    z-index: 40;
    padding-inline: 0.75rem;
    pointer-events: none;
    transition: transform var(--duration-nav) var(--ease-soft);
  }
  .site-header[data-hidden] {
    transform: translateY(calc(-100% - 1.5rem));
  }
  .site-header-bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 80rem;
    margin-inline: auto;
    padding: 0.5rem 0.625rem 0.5rem 1rem;
    border-radius: var(--radius-xl);
    background: color-mix(in oklab, var(--surface) 78%, transparent);
    backdrop-filter: blur(16px) saturate(1.2);
    -webkit-backdrop-filter: blur(16px) saturate(1.2);
    box-shadow: var(--elevation-2);
    pointer-events: auto;
    transition: background-color var(--duration-nav) var(--ease-soft);
  }
  .site-header[data-scrolled] .site-header-bar {
    background: color-mix(in oklab, var(--surface) 92%, transparent);
  }
  .site-brand {
    display: block;
    flex: none;
    width: 11.5rem;
    border-radius: var(--radius-md);
    text-decoration: none;
  }
  .site-brand .site-lockup-wide {
    display: none;
  }
  .site-nav,
  .site-tool-desktop {
    display: none;
  }
  .site-tools {
    display: flex;
    align-items: center;
    gap: 0.125rem;
    margin-inline-start: auto;
  }
  .site-lang {
    min-width: 2.75rem;
    padding-inline: 0.5rem;
    font-weight: 600;
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
  }
  .navlink {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding-inline: 0.875rem 0.625rem;
    border-radius: var(--radius-md);
    font-weight: 500;
    text-decoration: none;
    color: var(--ink);
    cursor: pointer;
    transition: background-color var(--duration-ui) var(--ease-soft);
  }
  .navlink > svg {
    color: var(--ink-muted);
    transition: color var(--duration-ui) var(--ease-soft), translate var(--duration-nav) var(--ease-soft);
  }
  .navlink:hover,
  .navlink[aria-expanded="true"] {
    background: var(--surface-2);
  }
  .navlink:hover > svg,
  .navlink[aria-expanded="true"] > svg {
    color: var(--primary);
    translate: 0 -1px;
  }
  .navlink[aria-expanded="true"] .eec-chevron {
    transform: rotate(180deg);
  }
  /* Current section: a soft green tint, green label and icon (no underline). */
  .navlink[aria-current] {
    background: var(--primary-soft);
    color: var(--primary);
    font-weight: 600;
  }
  .navlink[aria-current] > svg {
    color: var(--primary);
  }
  .navlink[aria-current]:hover,
  .navlink[aria-current][aria-expanded="true"] {
    background: color-mix(in oklab, var(--primary) 16%, var(--surface));
  }
  .site-nav-list {
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }

  /* Mega menu: items with icons on the left, an illustration card on the right. */
  .mega {
    position: absolute;
    inset-block-start: calc(100% + 0.5rem);
    /* The whole width of the navbar, not just its content. */
    inset-inline: 0;
    z-index: 5;
    padding: 0.75rem;
    border-radius: var(--radius-xl);
    background: var(--surface-raised);
    box-shadow: var(--elevation-3);
    --focus-gap: var(--surface-raised);
    transform-origin: 50% 0;
    animation: eec-mega-in var(--duration-nav) var(--ease-soft);
  }
  @keyframes eec-mega-in {
    from {
      opacity: 0;
      transform: translateY(-0.75rem) scale(0.985);
    }
  }
  .mega-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 0.75rem;
  }
  .mega-list {
    display: grid;
    align-content: start;
    gap: 0.125rem;
  }
  .mega-item {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.625rem;
    border-radius: var(--radius-lg);
    color: inherit;
    text-decoration: none;
    transition: background-color var(--duration-ui) var(--ease-soft);
  }
  .mega-item:hover,
  .mega-item:focus-visible {
    background: var(--surface-2);
  }
  .mega-item[aria-current="page"] {
    background: var(--primary-soft);
  }
  .mega-icon {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-md);
    background: var(--primary-soft);
    color: var(--primary);
    transition: transform var(--duration-nav) var(--ease-soft);
  }
  .mega-item:hover .mega-icon {
    transform: translateY(-2px) rotate(-4deg);
  }
  .mega-text {
    display: grid;
    min-width: 0;
  }
  .mega-label {
    font-weight: 600;
  }
  .mega-desc {
    font-size: var(--text-sm);
    line-height: 1.35;
    color: var(--ink-muted);
  }
  /* Illustration panel, cropped style: text on top, the scene big and cut by the panel's bottom edge. */
  .mega-art {
    position: relative;
    min-height: 19rem;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: color-mix(in oklab, var(--season) 9%, var(--surface-2));
  }
  .mega-art-text-wrap {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.25rem;
    max-width: 22rem;
    padding: 1.25rem 1.5rem;
  }
  .mega-illustration {
    position: absolute;
    inset-inline-start: 50%;
    inset-block-end: -42%;
    width: min(30rem, 100%);
    translate: -50% 0.75rem;
    opacity: 0;
    transition:
      opacity var(--duration-nav) var(--ease-soft),
      translate var(--duration-nav) var(--ease-soft);
    pointer-events: none;
  }
  /* Shown: the hovered/focused item's scene; otherwise the current page's; otherwise the first. */
  .mega-grid:has(.mega-item[data-i="0"]:is(:hover, :focus-visible)) .mega-illustration[data-art="0"],
  .mega-grid:has(.mega-item[data-i="1"]:is(:hover, :focus-visible)) .mega-illustration[data-art="1"],
  .mega-grid:has(.mega-item[data-i="2"]:is(:hover, :focus-visible)) .mega-illustration[data-art="2"],
  .mega-grid:has(.mega-item[data-i="3"]:is(:hover, :focus-visible)) .mega-illustration[data-art="3"],
  .mega-grid:not(:has(.mega-item:is(:hover, :focus-visible))):has(.mega-item[data-i="0"][aria-current="page"]) .mega-illustration[data-art="0"],
  .mega-grid:not(:has(.mega-item:is(:hover, :focus-visible))):has(.mega-item[data-i="1"][aria-current="page"]) .mega-illustration[data-art="1"],
  .mega-grid:not(:has(.mega-item:is(:hover, :focus-visible))):has(.mega-item[data-i="2"][aria-current="page"]) .mega-illustration[data-art="2"],
  .mega-grid:not(:has(.mega-item:is(:hover, :focus-visible))):has(.mega-item[data-i="3"][aria-current="page"]) .mega-illustration[data-art="3"],
  .mega-grid:not(:has(.mega-item:is(:hover, :focus-visible), .mega-item[aria-current="page"])) .mega-illustration[data-art="0"] {
    opacity: 1;
    translate: -50% 0;
  }
  .mega-art-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: 1.2;
  }
  .mega-art-text {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  @media (min-width: 64rem) {
    .site-header {
      padding-inline: 1.5rem;
    }
    .site-header-bar {
      gap: 1.25rem;
    }
    .site-brand {
      width: 19.5rem;
    }
    .site-brand .site-lockup-narrow {
      display: none;
    }
    .site-brand .site-lockup-wide {
      display: flex;
    }
    .site-nav {
      display: block;
      margin-inline: auto;
    }
    .site-tool-desktop {
      display: inline-flex;
    }
    .site-menu-button {
      display: none;
    }
    .site-tools {
      margin-inline-start: 0;
    }
  }

  /* Mobile menu: full screen, floating cards, a soft circular reveal. */
  .mobile-menu {
    background: var(--bg);
    /* The header (its parent) ignores the pointer so its margins never block the page: undo it here. */
    pointer-events: auto;
    clip-path: circle(0% at calc(100% - 2.25rem) 2.25rem);
    opacity: 1;
    transform: none;
    transition:
      clip-path calc(var(--duration-nav) * 1.5) var(--ease-soft),
      display calc(var(--duration-nav) * 1.5) allow-discrete,
      overlay calc(var(--duration-nav) * 1.5) allow-discrete;
  }
  .mobile-menu[open] {
    clip-path: circle(150% at calc(100% - 2.25rem) 2.25rem);
  }
  @starting-style {
    .mobile-menu[open] {
      clip-path: circle(0% at calc(100% - 2.25rem) 2.25rem);
    }
  }
  .mobile-menu::backdrop {
    background: transparent;
    backdrop-filter: none;
  }
  .mobile-menu-inner {
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    gap: 1rem;
    min-height: 100dvh;
    padding: 1rem 1rem calc(1rem + env(safe-area-inset-bottom));
  }
  .mobile-menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0.25rem;
  }
  .mobile-menu-brand {
    width: 12rem;
  }
  .mobile-menu-brand {
    display: block;
    text-decoration: none;
  }
  .mobile-menu-nav {
    display: grid;
    align-content: start;
    gap: 0.625rem;
    overflow-y: auto;
    padding: 0.25rem;
  }
  .mobile-card {
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--elevation-1);
  }
  .mobile-card.accordion-item {
    box-shadow: var(--elevation-1);
  }
  .mobile-card .accordion-trigger {
    min-height: 3.75rem;
    border-radius: var(--radius-lg);
  }
  .mobile-link {
    display: flex;
    align-items: center;
    min-height: 3.75rem;
    padding-inline: 1.25rem;
    font-weight: 500;
    text-decoration: none;
  }
  .mobile-row {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }
  .mobile-sub {
    display: grid;
    gap: 0.125rem;
    padding: 0 0.5rem 0.75rem;
  }
  .mobile-menu-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .mobile-menu-close {
    width: 100%;
    min-height: 3.5rem;
  }
  .site-menu-button:active > svg {
    translate: -3px 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-menu {
      clip-path: none;
      opacity: 0;
      transition-duration: 0.12s;
    }
    .mobile-menu[open] {
      opacity: 1;
      clip-path: none;
    }
    .mega {
      animation: none;
    }
    .site-header,
    .site-header-bar {
      transition: none;
    }
  }
</style>
