---
import { locales } from '@eec/i18n'
import Icon from '@eec/ui/astro/Icon.astro'
import { localeOf, useT } from '../lib/i18n'
import { alternates, descKey, href, labelKey, pages, tabKey, tabs } from '../lib/nav'
import SiteLockup from './SiteLockup.astro'
import ThemeToggle from './ThemeToggle.astro'

const locale = localeOf(Astro.currentLocale)
const t = useT(locale)
const other = locale === 'fr' ? 'en' : 'fr'
const switchHref = alternates(Astro.url.pathname)[other]
const home = href(locale, '')
const accountPath = pages.find((p) => p.id === 'account')?.path[locale] ?? ''
const current = Astro.url.pathname
const active = (slug: string) => current.startsWith(`/${locale}/${slug}`)
void locales
---

<header class="site-header" data-header>
  <div class="site-header-bar">
    <a href={home} class="site-brand" aria-label={`${t('site.name')} — ${t('nav.home')}`}>
      <SiteLockup variant="short" class="site-lockup site-lockup-short text-[1.05rem]" />
      <SiteLockup variant="long" class="site-lockup site-lockup-long text-[1.15rem]" />
    </a>

    <nav class="site-nav" aria-label={t('nav.main')}>
      <ul class="site-nav-list" role="list">
        {
          tabs.map((tab) => {
            const slug = tab.slug[locale]
            return (
              <li data-menu={tab.children.length ? '' : undefined} class="site-nav-item">
                {tab.children.length ? (
                  <>
                    <button type="button" class="navlink" data-menu-trigger aria-expanded="false" aria-controls={`panel-${tab.id}`} aria-current={active(slug) ? 'true' : undefined}>
                      {t(tabKey(tab.id))}
                      <span class="eec-chevron" aria-hidden="true" />
                    </button>
                    <div id={`panel-${tab.id}`} class="mega" data-menu-panel hidden>
                      <ul role="list">
                        {tab.children.map((child) => (
                          <li>
                            <a class="menu-item" href={href(locale, `${slug}/${child.slug[locale]}`)} aria-current={current.startsWith(href(locale, `${slug}/${child.slug[locale]}`)) ? 'page' : undefined}>
                              <span>
                                {t(labelKey(child.id))}
                                <span class="menu-item-desc">{t(descKey(child.id))}</span>
                              </span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </>
                ) : (
                  <a class="navlink" href={href(locale, slug)} aria-current={active(slug) ? 'page' : undefined}>{t(tabKey(tab.id))}</a>
                )}
              </li>
            )
          })
        }
      </ul>
    </nav>

    <div class="site-tools">
      <button type="button" class="btn btn-ghost btn-icon site-tool-desktop" aria-label={t('nav.search')} disabled title={t('nav.search')}>
        <Icon name="search" />
      </button>
      <a href={switchHref} hreflang={other} lang={other} class="btn btn-ghost btn-sm site-tool-desktop" aria-label={t('common.language.switch_label')}>
        <Icon name="language" size={16} />{t('common.language.switch_to')}
      </a>
      <span class="site-tool-desktop"><ThemeToggle /></span>
      <a href={href(locale, accountPath)} class="btn btn-secondary btn-sm site-tool-desktop">
        <Icon name="account" size={16} />{t('nav.account')}
      </a>
      <button type="button" class="btn btn-ghost btn-icon site-menu-button" data-dialog-open="mobile-menu" aria-haspopup="dialog" aria-label={t('nav.open_menu')}>
        <Icon name="menu" size={24} />
      </button>
    </div>
  </div>

  <dialog id="mobile-menu" class="sheet mobile-menu" data-side="full" aria-label={t('nav.main')}>
    <div class="mobile-menu-inner">
      <div class="mobile-menu-top">
        <SiteLockup variant="short" class="text-[1.05rem]" />
      </div>
      <nav aria-label={t('nav.main')} class="mobile-menu-nav">
        <a class="mobile-link" href={home}>{t('nav.home')}</a>
        {
          tabs.map((tab) => {
            const slug = tab.slug[locale]
            return tab.children.length ? (
              <details class="accordion-item" name="mobile-nav" open={active(slug)}>
                <summary class="accordion-trigger"><span>{t(tabKey(tab.id))}</span><span class="eec-chevron" aria-hidden="true" /></summary>
                <ul class="mobile-sub" role="list">
                  {tab.children.map((child) => (
                    <li>
                      <a class="menu-item" href={href(locale, `${slug}/${child.slug[locale]}`)}>
                        <span>{t(labelKey(child.id))}<span class="menu-item-desc">{t(descKey(child.id))}</span></span>
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ) : (
              <a class="mobile-link" href={href(locale, slug)}>{t(tabKey(tab.id))}</a>
            )
          })
        }
      </nav>
      <div class="mobile-menu-tools" role="group" aria-label={t('nav.utilities')}>
        <a href={href(locale, accountPath)} class="btn btn-secondary"><Icon name="account" />{t('nav.account')}</a>
        <a href={switchHref} hreflang={other} lang={other} class="btn btn-ghost"><Icon name="language" />{t('common.language.switch_to')}</a>
        <ThemeToggle />
      </div>
      <button type="button" class="btn btn-primary mobile-menu-close" data-dialog-close>
        <Icon name="close" />{t('nav.close_menu')}
      </button>
    </div>
  </dialog>
</header>

<script>
  import { initHeader } from '../scripts/header'
  document.addEventListener('astro:page-load', initHeader)
</script>

<style is:global>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 40;
    background: color-mix(in oklab, var(--bg) 78%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    transition:
      transform var(--duration-ui) var(--ease-out),
      background-color var(--duration-ui) var(--ease-out),
      box-shadow var(--duration-ui) var(--ease-out);
  }
  .site-header[data-scrolled] {
    background: color-mix(in oklab, var(--bg) 92%, transparent);
    box-shadow: var(--elevation-1);
  }
  .site-header[data-hidden] {
    transform: translateY(-100%);
  }
  .site-header-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    max-width: 80rem;
    margin-inline: auto;
    padding: 0.5rem 1rem;
  }
  .site-brand {
    display: block;
    flex: 1 1 auto;
    min-width: 0;
    max-width: 16rem;
    border-radius: var(--radius-md);
    text-decoration: none;
  }
  .site-lockup-long {
    display: none !important;
  }
  .site-nav,
  .site-tool-desktop {
    display: none;
  }
  .site-tools {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-inline-start: auto;
  }
  .navlink {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 2.75rem;
    padding-inline: 0.875rem;
    border-radius: var(--radius-md);
    font-weight: 500;
    text-decoration: none;
    color: var(--ink);
    cursor: pointer;
    transition: background-color var(--duration-micro) var(--ease-out);
  }
  .navlink:hover,
  .navlink[aria-expanded="true"] {
    background: var(--surface-2);
  }
  .navlink[aria-expanded="true"] .eec-chevron {
    transform: rotate(180deg);
  }
  .navlink[aria-current] {
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.4em;
  }
  .site-nav-list {
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }
  .site-nav-item {
    position: relative;
  }
  .mega {
    position: absolute;
    inset-block-start: calc(100% + 0.5rem);
    inset-inline-start: 0;
    z-index: 5;
    width: 22rem;
    padding: 0.5rem;
    border-radius: var(--radius-lg);
    background: var(--surface-raised);
    box-shadow: var(--elevation-2);
    --focus-gap: var(--surface-raised);
    animation: eec-mega-in var(--duration-ui) var(--ease-out);
  }
  @keyframes eec-mega-in {
    from {
      opacity: 0;
      transform: translateY(calc(var(--rise) * -0.5));
    }
  }
  @media (min-width: 64rem) {
    .site-header-bar {
      padding-inline: 2rem;
      gap: 1.5rem;
    }
    .site-brand {
      flex: none;
      width: 20rem;
      max-width: 22rem;
    }
    .site-lockup-short {
      display: none !important;
    }
    .site-lockup-long {
      display: flex !important;
    }
    .site-nav {
      display: block;
      margin-inline-start: auto;
    }
    .site-tool-desktop {
      display: inline-flex;
    }
    .site-menu-button {
      display: none;
    }
    .site-tools {
      margin-inline-start: 0;
    }
  }

  /* Mobile menu: full-screen sheet with a soft clip-path reveal. */
  .mobile-menu {
    background: var(--bg);
    clip-path: circle(0% at calc(100% - 2.25rem) 2.25rem);
    transition:
      clip-path var(--duration-story) var(--ease-out),
      opacity var(--duration-ui) var(--ease-out),
      display var(--duration-story) allow-discrete,
      overlay var(--duration-story) allow-discrete;
    transform: none;
    opacity: 1;
  }
  .mobile-menu[open] {
    clip-path: circle(150% at calc(100% - 2.25rem) 2.25rem);
  }
  @starting-style {
    .mobile-menu[open] {
      clip-path: circle(0% at calc(100% - 2.25rem) 2.25rem);
    }
  }
  .mobile-menu::backdrop {
    background: transparent;
    backdrop-filter: none;
  }
  .mobile-menu-inner {
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    gap: 1rem;
    min-height: 100dvh;
    padding: 1rem 1rem calc(1rem + env(safe-area-inset-bottom));
  }
  .mobile-menu-top {
    max-width: 14rem;
    padding-block: 0.25rem;
  }
  .mobile-menu-nav {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    overflow-y: auto;
  }
  .mobile-link {
    display: flex;
    align-items: center;
    min-height: 3.25rem;
    padding-inline: 1.25rem;
    border-radius: var(--radius-md);
    background: var(--surface);
    font-weight: 500;
    text-decoration: none;
    box-shadow: inset 0 0 0 1.5px var(--line);
  }
  .mobile-sub {
    padding: 0 0.5rem 0.75rem;
  }
  .mobile-menu-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .mobile-menu-close {
    width: 100%;
    min-height: 3.25rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-menu {
      clip-path: none;
      opacity: 0;
      transition-duration: 0.12s;
    }
    .mobile-menu[open] {
      opacity: 1;
      clip-path: none;
    }
    .mega {
      animation: none;
    }
    .site-header {
      transition: none;
    }
  }
</style>
