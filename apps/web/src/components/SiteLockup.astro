---
import Lockup from '@eec/ui/astro/Lockup.astro'
import { useT } from '../lib/i18n'

interface Props {
  variant?: 'auto' | 'short' | 'long'
  mark?: 'mark' | 'halo' | 'mono'
  class?: string
}

const t = useT(Astro.currentLocale)
---

<Lockup
  {...Astro.props}
  short={t('lockup.short')}
  church={t('lockup.long_church')}
  parish={t('lockup.long_parish')}
/>
