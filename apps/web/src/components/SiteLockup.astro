---
import Lockup from '@eec/ui/astro/Lockup.astro'
import { useT } from '../lib/i18n'

interface Props {
  variant?: 'auto' | 'one' | 'two' | 'three'
  mark?: 'mark' | 'halo' | 'mono'
  class?: string
}

const t = useT(Astro.currentLocale)
---

<Lockup
  {...Astro.props}
  one={t('lockup.short')}
  eec={t('lockup.eec')}
  parish={t('lockup.long_parish')}
  parishLead={t('lockup.parish_lead')}
  parishPlace={t('lockup.parish_place')}
/>
