---
/**
 * « Mon espace » for a signed-in member (Phase 05, Checkpoint A; plan: docs/product/mon-espace.md): five sections, one at a time, each
 * reachable by its anchor and loaded on demand (scripts/mon-espace.ts). Everything is private and drawn on the device from /api/me/*; the
 * profile section is the slot (the existing profile, photo, data and devices panels, reorganised not rewritten).
 */
import Icon from '@eec/ui/astro/Icon.astro'
import { iconSvg } from '@eec/ui/icons'
import { departmentHref, departmentsHref } from '../lib/departments-routes'
import { eventHref, eventsListHref } from '../lib/events-routes'
import { localeOf, useT } from '../lib/i18n'
import { href, pages } from '../lib/nav'
import { cancelPath } from '../lib/registrations-routes'

const locale = localeOf(Astro.currentLocale)
const t = useT(locale)
const m = (key: string, vars?: Record<string, string>) =>
  t(`member.me.${key}` as 'member.me.nav_home', vars)
// Placeholders stay in the text for the scripts to fill ({n}, {total}, {date}, {title}).
const ph = { n: '{n}', total: '{total}', date: '{date}', title: '{title}' }
const sections = [
  ['accueil', 'home', 'nav_home'],
  ['inscriptions', 'checklist', 'nav_regs'],
  ['groupes', 'users', 'nav_groups'],
  ['notifications', 'bell', 'nav_notifs'],
  ['profil', 'account', 'nav_profile'],
] as const
const sundayPath = pages.find((p) => p.id === 'dimanche')?.path[locale] ?? ''
const accountPath = pages.find((p) => p.id === 'account')?.path[locale] ?? ''
const messages = Object.fromEntries(
  [
    'sunday_k',
    'sunday_open',
    'nav_regs',
    'nav_groups',
    'next_reg_k',
    'groups_k',
    'profile_k',
    'profile_todo',
    'profile_go',
    'next_reg_p',
    'none_reg_t',
    'none_reg_p',
    'sunday_p',
    'groups_p',
    'groups_none_p',
    'profile_p',
    'profile_ok_t',
    'profile_ok_p',
    'card_k',
    'card_soon',
    'card_t',
    'card_p',
    'card_parish',
    'card_preview',
    'hero_title',
    'share_phone',
    'request_k',
    'request_p',
    'request_withdraw',
    'join_t',
    'join_p',
    'request_ask',
    'request_send',
    'request_declined',
    'kind_group_decision',
    'group_decision_t',
    'group_decision_p',
    'group_announcement_t',
    'group_announcement_p',
    'no_next',
    'regs_upcoming',
    'regs_past',
    'regs_empty_t',
    'regs_empty_p',
    'regs_agenda',
    'status_confirmed',
    'status_waitlist',
    'status_cancelled',
    'position',
    'people',
    'calendar',
    'cancel',
    'cancel_ask',
    'cancel_done',
    'kept_until',
    'link_t',
    'link_p',
    'link_ph',
    'link_go',
    'link_done',
    'link_bad',
    'link_taken',
    'link_rate',
    'err',
    'groups_empty_t',
    'groups_empty_p',
    'groups_discover',
    'member_badge',
    'view_page',
    'leave',
    'leave_ask',
    'leave_done',
    'next_event',
    'no_event',
    'notifs_empty_t',
    'notifs_empty_p',
    'this_week',
    'last_week',
    'week_of',
    'mark_all',
    'dismiss',
    'settings',
    'settings_p',
    'unread',
    'kind_waitlist_promoted',
    'kind_policy_change',
    'kind_group_announcement',
    'waitlist_promoted_t',
    'waitlist_promoted_p',
    'policy_change_t',
    'policy_change_p',
    'done',
    'loading',
  ].map((k) => [k, m(k, ph)]),
)
const iconNames = [
  'home',
  'calendar',
  'checklist',
  'users',
  'bell',
  'account',
  'sparkles',
  'church',
  'userRoundPlus',
  'check',
  'clock',
  'location',
  'heart',
  'lock',
  'arrowRight',
] as const
const icons = Object.fromEntries(iconNames.map((n) => [n, iconSvg(n, { size: 20 })]))
const intros: Record<string, string> = {
  accueil: m('intro_home'),
  inscriptions: m('intro_regs'),
  groupes: m('intro_groups'),
  notifications: m('intro_notifs'),
  profil: m('intro_profile'),
}
const links = {
  agenda: eventsListHref(locale),
  departments: departmentsHref(locale),
  sunday: href(locale, sundayPath),
  account: href(locale, accountPath),
  cancel: cancelPath(locale),
  eventBase: eventHref(locale, '__SLUG__'),
  deptBase: departmentHref(locale, '__KEY__'),
}
---

<div class="me" data-me data-lang={locale} data-msgs={JSON.stringify(messages)} data-links={JSON.stringify(links)} data-icons={JSON.stringify(icons)}>
  <nav class="me-nav" aria-label={m('nav_label')}>
    <p class="me-nav-title" aria-hidden="true"><Icon name="sparkles" size={20} /><span>{m('hero_title')}</span></p>
    {
      sections.map(([id, icon, key], i) => (
        <a class="me-tab" href={`#${id}`} data-me-tab={id} aria-current={i === 0 ? 'page' : undefined}>
          <Icon name={icon} size={20} />
          <span>{m(key)}</span>
          {id === 'notifications' && <span class="me-count" data-me-count hidden></span>}
        </a>
      ))
    }
  </nav>

  <section class="me-section" data-me-section="accueil" aria-labelledby="me-h-accueil">
    <header class="me-head"><span class="me-head-ico" aria-hidden="true"><Icon name="home" size={20} /></span><div><h3 class="me-head-t" id="me-h-accueil">{m('nav_home')}</h3><p class="me-head-p">{intros.accueil}</p></div></header>
    <div class="me-cards" data-me-home aria-busy="true"><div class="me-skel"></div><div class="me-skel"></div></div>
  </section>
  <section class="me-section" data-me-section="inscriptions" hidden aria-labelledby="me-h-inscriptions">
    <header class="me-head"><span class="me-head-ico" aria-hidden="true"><Icon name="checklist" size={20} /></span><div><h3 class="me-head-t" id="me-h-inscriptions">{m('nav_regs')}</h3><p class="me-head-p">{intros.inscriptions}</p></div></header>
    <div class="me-cards" data-me-regs aria-busy="true"><div class="me-skel"></div></div>
  </section>
  <section class="me-section" data-me-section="groupes" hidden aria-labelledby="me-h-groupes">
    <header class="me-head"><span class="me-head-ico" aria-hidden="true"><Icon name="users" size={20} /></span><div><h3 class="me-head-t" id="me-h-groupes">{m('nav_groups')}</h3><p class="me-head-p">{intros.groupes}</p></div></header>
    <div class="me-cards" data-me-groups aria-busy="true"><div class="me-skel"></div></div>
  </section>
  <section class="me-section" data-me-section="notifications" hidden aria-labelledby="me-h-notifications">
    <header class="me-head"><span class="me-head-ico" aria-hidden="true"><Icon name="bell" size={20} /></span><div><h3 class="me-head-t" id="me-h-notifications">{m('nav_notifs')}</h3><p class="me-head-p">{intros.notifications}</p></div></header>
    <div class="me-cards" data-me-notifs aria-busy="true"><div class="me-skel"></div></div>
  </section>
  <section class="me-section" data-me-section="profil" hidden aria-labelledby="me-h-profil">
    <header class="me-head"><span class="me-head-ico" aria-hidden="true"><Icon name="account" size={20} /></span><div><h3 class="me-head-t" id="me-h-profil">{m('nav_profile')}</h3><p class="me-head-p">{intros.profil}</p></div></header>
    <slot />
  </section>
</div>

<style is:global>
  .me {
    display: grid;
    gap: 1rem;
  }
  .me-nav {
    position: sticky;
    inset-block-start: 4.75rem;
    z-index: 5;
    display: flex;
    gap: 0.375rem;
    padding: 0.375rem;
    overflow-x: auto;
    border-radius: var(--radius-lg);
    background: var(--surface-2);
    scrollbar-width: none;
  }
  .me-nav::-webkit-scrollbar {
    display: none;
  }
  .me-tab {
    position: relative;
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding-inline: 0.875rem;
    border-radius: var(--radius-md);
    color: var(--ink-muted);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .me-tab:hover {
    color: var(--ink);
  }
  .me-tab[aria-current='page'] {
    background: var(--primary);
    color: var(--bg);
  }
  .me-count {
    display: inline-grid;
    place-items: center;
    min-width: 1.25rem;
    height: 1.25rem;
    padding-inline: 0.25rem;
    border-radius: var(--radius-sm);
    background: var(--warning-soft);
    color: var(--warning);
    font-size: 0.6875rem;
    font-weight: 700;
  }
  .me-nav-title {
    display: none;
  }
  .me-head {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }
  .me-head-ico {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-md);
    background: color-mix(in oklab, var(--season) 14%, var(--surface));
    color: var(--season-ink);
  }
  .me-head-t {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: 1.15;
  }
  .me-head-p {
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
  .me-ico {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-md);
    background: color-mix(in oklab, var(--season) 14%, transparent);
    color: var(--season-ink);
  }
  .me-top {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .me-p {
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
  /* The headline of the menu: it appears once the welcome has scrolled out of view. */
  @media (min-width: 64rem) {
    .me-nav-title {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      padding-inline: 1rem;
      font-family: var(--font-display);
      font-size: var(--text-xl);
      transition: max-height 0.3s var(--ease-out, ease), opacity 0.3s, padding 0.3s;
    }
    .me[data-past-hero] .me-nav-title {
      max-height: 3rem;
      opacity: 1;
      padding-block: 0.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .me-nav-title {
      transition: none;
    }
  }
  .me-section {
    display: grid;
    gap: 1rem;
  }
  .me-cards {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    align-items: start;
  }
  .me-cards > * {
    min-width: 0;
  }
  /* A long list of notifications reads better as one column. */
  .me-cards[data-me-notifs] {
    grid-template-columns: minmax(0, 46rem);
  }
  @media (min-width: 64rem) {
    .me {
      grid-template-columns: 14.5rem minmax(0, 1fr);
      gap: 1.5rem 2.5rem;
      align-items: start;
    }
    .me-nav {
      inset-block-start: 6.5rem;
      flex-direction: column;
      overflow: visible;
      padding: 0.5rem;
    }
    .me-tab {
      min-height: 3rem;
      padding-inline: 1rem;
    }
    .me-count {
      margin-inline-start: auto;
    }
  }
  /* The home is a bento. Tablet: two columns, a lone last card stretches. Desktop: three columns, the Communion card tall on the right and
     the other cards packed to its left by me-home.ts (data-span), so no cell is left empty whatever cards there are. */
  @media (min-width: 40rem) {
    .me-cards[data-me-home] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-flow: dense;
    }
  }
  @media (min-width: 40rem) and (max-width: 63.99rem) {
    .me-cards[data-me-home] > :last-child:nth-child(odd) {
      grid-column: span 2;
    }
  }
  @media (min-width: 64rem) {
    .me-cards[data-me-home] {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .me-cards[data-me-home] > [data-span='2'] {
      grid-column: span 2;
    }
    .me-cards[data-me-home] > [data-span='3'] {
      grid-column: span 3;
    }
    .me-cards[data-me-home] > .me-comm {
      grid-column: 3;
      grid-row: 1 / span 2;
    }
  }
  .me-cards[data-me-home] {
    align-items: stretch;
  }
  .me-cards[data-me-home] > .me-card {
    align-content: start;
  }
  /* The Communion card: portrait, like the paper booklet. */
  .me-comm {
    align-content: start;
  }
  .me-comm-face {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.75rem;
    aspect-ratio: 3 / 4;
    padding: 1rem;
    border-radius: var(--radius-lg);
    background: linear-gradient(160deg, color-mix(in oklab, var(--season) 22%, var(--surface-2)), color-mix(in oklab, var(--gold) 18%, var(--surface-2)));
    box-shadow: inset 0 0 0 1px var(--line);
    transition: transform 0.6s var(--ease-out, ease);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .me-comm-face:hover {
      transform: perspective(60rem) rotateX(1.5deg) rotateY(-1.5deg);
    }
  }
  .me-comm-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .me-comm-ico {
    display: inline-grid;
    flex: none;
    width: 1.5rem;
    color: var(--season-ink);
  }
  .me-comm-parish {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.15;
  }
  .me-comm-line {
    height: 0.75rem;
    border-radius: var(--radius-sm);
    background: color-mix(in oklab, var(--ink) 8%, transparent);
  }
  .me-comm-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.375rem;
    list-style: none;
    padding: 0;
  }
  .me-comm-grid li {
    display: grid;
    place-items: center;
    min-height: 2.25rem;
    border-radius: var(--radius-sm);
    background: color-mix(in oklab, var(--surface) 70%, transparent);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--ink-muted);
    font-size: 0.6875rem;
    text-transform: capitalize;
  }
  .me-comm-tag {
    align-self: end;
    justify-self: end;
    color: var(--ink-muted);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .me-head-sub,
  .me-wide {
    grid-column: 1 / -1;
  }
  .me-head-sub {
    margin-block-start: 0.5rem;
  }
  .me-ann {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.125rem 0.625rem;
    align-items: center;
    padding: 0.625rem;
    border-radius: var(--radius-md);
    background: color-mix(in oklab, var(--gold) 14%, var(--surface));
  }
  .me-ann > .me-p,
  .me-ann > a {
    grid-column: 2;
  }
  .me-skel {
    height: 5rem;
    border-radius: var(--radius-lg);
    background: color-mix(in oklab, var(--ink) 8%, transparent);
  }
  .me-card {
    display: grid;
    gap: 0.5rem;
    padding: 1rem 1.125rem;
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--elevation-1);
  }
  .me-card[data-tone='gold'] {
    background: color-mix(in oklab, var(--gold) 16%, var(--surface));
  }
  .me-card[data-tone='green'] {
    background: color-mix(in oklab, var(--primary) 10%, var(--surface));
  }
  .me-k {
    color: var(--ink-muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .me-t {
    font-weight: 700;
    font-size: var(--text-lg);
  }
  .me-m {
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
  .me-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .me-pill {
    display: inline-block;
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-sm);
    background: color-mix(in oklab, var(--primary) 14%, transparent);
    color: var(--primary);
    font-size: 0.75rem;
    font-weight: 700;
  }
  .me-pill[data-tone='warn'] {
    background: var(--warning-soft);
    color: var(--warning);
  }
  .me-pill[data-tone='off'] {
    background: color-mix(in oklab, var(--ink) 10%, transparent);
    color: var(--ink-muted);
  }
  .me-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .me-wk {
    margin-block-start: 0.5rem;
    color: var(--ink-muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .me-empty {
    display: grid;
    gap: 0.5rem;
    justify-items: center;
    padding: 1.5rem 1rem;
    text-align: center;
    color: var(--ink-muted);
  }
  .me-empty strong {
    color: var(--ink);
  }
  .me-unread {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-inline-end: 0.5rem;
    border-radius: 50%;
    background: var(--danger);
  }
  .me-notif {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .me-notif > a {
    display: grid;
    gap: 0.25rem;
    color: inherit;
    text-decoration: none;
  }
  .me-link {
    display: grid;
    gap: 0.5rem;
  }
  .me-link .field {
    margin: 0;
  }
  @media (max-width: 40rem) {
    .me-nav {
      inset-block-start: 4rem;
      margin-inline: -0.5rem;
      gap: 0.125rem;
      overflow: visible;
    }
    /* All five sections stay in view on a phone: icon over a short label. */
    .me-tab {
      flex: 1 1 0;
      min-width: 0;
      flex-direction: column;
      justify-content: center;
      gap: 0.125rem;
      padding-inline: 0.125rem;
      font-size: 0.6875rem;
    }
    .me-count {
      position: absolute;
      inset-block-start: 0.125rem;
      inset-inline-end: 0.25rem;
      min-width: 1rem;
      height: 1rem;
    }
  }
</style>
