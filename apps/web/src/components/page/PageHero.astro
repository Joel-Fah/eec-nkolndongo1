---
/**
 * Page hero (lib/heroes.ts). The photo is clipped to a playful shape (lib/shapes.ts) with a tinted echo
 * behind it; cards are scattered over it at placed positions and may overflow the picture sideways or
 * below, never above. `morph` heroes start as a full-screen photo that shrinks into a rounded shape as the
 * page scrolls (CSS scroll-driven animation; browsers without it, and reduced motion, get the final state).
 * No illustrations. Without photos (production, until the media library) the shape keeps its form on a
 * tinted, textured panel.
 */
import { getSeason } from '@eec/core'
import Icon from '@eec/ui/astro/Icon.astro'
import { heroes } from '../../lib/heroes'
import { localeOf, useT } from '../../lib/i18n'
import { labelKey, pages, tabKey } from '../../lib/nav'
import { content } from '../../lib/pages'
import { heroSrc, photosById } from '../../lib/placeholders'
import { shapes } from '../../lib/shapes'
import SeasonStrip from '../home/SeasonStrip.astro'

interface Props {
  id: string
}
const { id } = Astro.props
const locale = localeOf(Astro.currentLocale)
const t = useT(locale)
const hero = heroes[id]
if (!hero) throw new Error(`No hero for page: ${id}`)
const page = content[id]
const tab = pages.find((p) => p.id === id)?.tab
const [main] = photosById(hero.photos)
const shape = shapes[hero.shape]
const morph = hero.layout === 'morph'

// Facts (stat, progress) show their example only in dev, tagged; unvalidated ones are hidden in production.
const cards = hero.cards
  .map((c) =>
    c.kind === 'stat' || c.kind === 'progress'
      ? {
          ...c,
          shown: c.value ?? (import.meta.env.DEV ? c.example : null),
          isExample: c.value === null,
        }
      : c,
  )
  .filter((c) => !('shown' in c) || c.shown !== null)
const ring = 2 * Math.PI * 26
const title = t(labelKey(id))
const lead = page ? t(page.lead) : ''
const eyebrow = tab ? t(tabKey(tab)) : ''
const season = getSeason()
const sizes = morph ? '100vw' : '(min-width: 64rem) 34rem, 90vw'
---

<section class="ph" data-layout={hero.layout} data-shape={hero.shape} aria-labelledby="ph-title">
  {
    hero.layout !== 'plain' && (
      <svg class="ph-defs" width="0" height="0" aria-hidden="true" focusable="false">
        <defs>
          <clipPath id={`ph-${hero.shape}`} clipPathUnits="objectBoundingBox" set:html={shape.defs} />
        </defs>
      </svg>
    )
  }
  <div class="ph-frame" style={`--ar:${shape.ar}`}>
    <div class="ph-text">
      {eyebrow && <p class="ph-eyebrow"><span class="ph-dot" aria-hidden="true"></span>{eyebrow}</p>}
      {hero.giant === 'season' && <p class="ph-giant" aria-hidden="true">{t(`season.${season}` as 'season.avent')}</p>}
      {hero.giant === 'thanks' && <p class="ph-giant" aria-hidden="true">{t('hero.thanks')}</p>}
      <h1 id="ph-title" class="ph-title">{title}</h1>
      {lead && <p class="ph-lead">{lead}</p>}
      {hero.layout === 'plain' && (
        <ul class="ph-plain-cards">
          {cards.map((c) => c.kind === 'info' && <li class="ph-card"><span class="ph-card-icon"><Icon name={c.icon} size={20} /></span><p class="ph-card-title">{t(c.title)}</p><p class="ph-card-text">{t(c.text)}</p></li>)}
        </ul>
      )}
    </div>

    {
      hero.layout !== 'plain' && (
        <div class="ph-stage">
          <div class="ph-shape-wrap">
            <div class="ph-echo" style={`clip-path:url(#ph-${hero.shape})`} aria-hidden="true" />
            <div class="ph-shape" style={morph ? undefined : `clip-path:url(#ph-${hero.shape})`}>
              {main ? (
                <picture>
                  <source type="image/avif" srcset={`${heroSrc(main, 1280, 'avif')} 1280w, ${heroSrc(main, 1920, 'avif')} 1920w`} sizes={sizes} />
                  <img src={heroSrc(main, 1280, 'webp')} srcset={`${heroSrc(main, 1280, 'webp')} 1280w, ${heroSrc(main, 1920, 'webp')} 1920w`} sizes={sizes} alt={main.alt} width={main.width ?? 1920} height={main.height ?? 1280} fetchpriority="high" decoding="async" style={`background-image:url(${main.blur});background-color:${main.color}`} />
                </picture>
              ) : (
                <div class="ph-empty" aria-hidden="true" />
              )}
            </div>
          </div>

          <ul class="ph-cards">
            {
              cards.map((c, i) => (
                <li
                  class:list={['ph-card', `ph-card-${c.kind}`]}
                  style={`--x:${c.at.x};--y:${Math.max(0, c.at.y)};--r:${c.at.r ?? 0};--i:${i}`}
                >
                  {c.kind === 'season' ? (
                    <SeasonStrip />
                  ) : c.kind === 'progress' ? (
                    <div class="ph-progress">
                      <svg viewBox="0 0 60 60" aria-hidden="true">
                        <circle cx="30" cy="30" r="26" pathLength={ring} class="ph-progress-track" />
                        <circle cx="30" cy="30" r="26" pathLength={ring} class="ph-progress-bar" style={`stroke-dasharray:${((c.shown ?? 0) / 100) * ring} ${ring}`} />
                      </svg>
                      <div>
                        <p class="ph-card-value">{c.shown}%{c.isExample && <span class="ph-example">{t('home.stats.example')}</span>}</p>
                        <p class="ph-card-label">{t(c.label)}</p>
                      </div>
                    </div>
                  ) : c.kind === 'player' ? (
                    <div class="ph-player">
                      <button type="button" class="ph-play" disabled aria-label={`${t('hero.listen')} — ${t('hero.soon')}`}><Icon name="play" size={24} /></button>
                      <div class="grid min-w-0 gap-1">
                        <p class="ph-card-title">{t(c.title)}</p>
                        <p class="ph-card-text">{t(c.text)}</p>
                        <span class="ph-wave" aria-hidden="true">{Array.from({ length: 30 }, (_, w) => <i style={`--h:${Math.round((Math.sin(w * 1.7) * 0.5 + 0.5) * 70 + 20)}%`} />)}</span>
                      </div>
                    </div>
                  ) : c.kind === 'step' ? (
                    <>
                      <span class="ph-step">{c.n}</span>
                      <p class="ph-card-title">{t(c.title)}</p>
                      <p class="ph-card-text">{t(c.text)}</p>
                    </>
                  ) : c.kind === 'stat' ? (
                    <>
                      <p class="ph-card-value">
                        {c.shown}
                        {c.suffix}
                        {c.isExample && <span class="ph-example">{t('home.stats.example')}</span>}
                      </p>
                      <p class="ph-card-label">{t(c.label)}</p>
                    </>
                  ) : (
                    <>
                      <span class="ph-card-icon"><Icon name={c.icon} size={20} /></span>
                      <p class="ph-card-title">{t(c.title)}</p>
                      <p class="ph-card-text">{t(c.text)}</p>
                    </>
                  )}
                </li>
              ))
            }
          </ul>
          {main && <p class="ph-credit">{t('home.stream.credit', { name: main.photographer })}</p>}
        </div>
      )
    }
  </div>
</section>

<style is:global>
  .ph {
    padding: 0.5rem 1rem 0;
    /* The echo and overflowing cards never add a horizontal scrollbar (clip, not hidden: sticky still works). */
    overflow-x: clip;
  }
  .ph-defs {
    position: absolute;
  }
  .ph-frame {
    display: grid;
    gap: 2rem;
    max-width: 80rem;
    margin-inline: auto;
    padding-block: 1.5rem 1rem;
  }

  /* ── Text ─────────────────────────────────────────────────────────────────────────── */
  .ph-text {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 1rem;
  }
  .ph-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3125rem 0.75rem;
    border-radius: var(--radius-sm);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .ph-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--season);
  }
  .ph-title {
    font-size: clamp(2.25rem, 1.2rem + 3.6vw, 4.5rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .ph-lead {
    max-width: 34rem;
    font-size: var(--text-lg);
    color: var(--ink-muted);
  }
  .ph-giant {
    font-family: var(--font-display);
    font-size: clamp(3rem, 1rem + 7vw, 7.5rem);
    font-style: italic;
    line-height: 0.85;
    letter-spacing: -0.02em;
    color: var(--season-ink);
  }
  [data-layout="split-right"] .ph-giant,
  [data-layout="split-left"] .ph-giant {
    margin-block-end: -0.25rem;
  }

  /* ── The picture: a shape, with an echo of itself behind ──────────────────────────── */
  .ph-stage {
    position: relative;
    width: min(100%, 30rem);
    justify-self: center;
  }
  .ph-shape-wrap {
    position: relative;
    aspect-ratio: var(--ar);
    filter: drop-shadow(0 1.25rem 1.5rem color-mix(in oklab, var(--ink) 16%, transparent));
  }
  .ph-echo,
  .ph-shape {
    position: absolute;
    inset: 0;
  }
  .ph-echo {
    background: color-mix(in oklab, var(--season) 28%, var(--surface-2));
    translate: 5% 4%;
    rotate: 3deg;
  }
  .ph-shape {
    overflow: hidden;
    background: var(--surface-2);
  }
  .ph-shape picture {
    display: block;
    height: 100%;
  }
  .ph-shape img,
  .ph-empty {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background-size: cover;
  }
  .ph-shape img {
    animation: ph-settle 1.4s var(--ease-soft) both;
  }
  @keyframes ph-settle {
    from {
      transform: scale(1.08);
    }
  }
  /* No photo yet: a tinted, textured panel in the season colour. */
  .ph-empty {
    background:
      radial-gradient(color-mix(in oklab, var(--ink) 14%, transparent) 1px, transparent 1.5px) 0 0 / 20px 20px,
      radial-gradient(70% 80% at 80% 20%, color-mix(in oklab, var(--season) 40%, transparent), transparent 70%),
      radial-gradient(60% 70% at 10% 90%, color-mix(in oklab, var(--gold) 35%, transparent), transparent 70%),
      var(--surface-2);
  }
  .ph-credit {
    margin-block-start: 0.5rem;
    font-size: var(--text-xs);
    text-align: end;
    color: var(--ink-muted);
  }

  /* ── Cards: scattered over the picture ────────────────────────────────────────────── */
  .ph-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 0.625rem;
    margin-block-start: -1.5rem;
    padding-inline: 0.25rem;
    position: relative;
    z-index: 2;
  }
  .ph-card {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    min-width: 9.5rem;
    padding: 0.875rem 1rem;
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--elevation-2), inset 0 0 0 1px var(--line);
    animation: ph-rise var(--duration-nav) var(--ease-soft) calc(0.35s + var(--i) * 90ms) both;
    transition: transform var(--duration-nav) var(--ease-spring), box-shadow var(--duration-ui) var(--ease-out);
  }
  @keyframes ph-rise {
    from {
      opacity: 0;
      translate: 0 1rem;
    }
  }
  .ph-card:hover {
    box-shadow: var(--elevation-3), inset 0 0 0 1px var(--line);
  }
  .ph-card-value {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }
  .ph-example {
    margin-inline-start: 0.375rem;
    align-self: center;
    padding: 0.125rem 0.375rem;
    border-radius: var(--radius-xs);
    background: var(--warning-soft);
    color: var(--warning);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0;
  }
  .ph-card-label,
  .ph-card-text {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  .ph-card-title {
    font-weight: 600;
  }
  .ph-card-icon,
  .ph-step {
    display: grid;
    place-items: center;
    width: 2.125rem;
    height: 2.125rem;
    margin-block-end: 0.25rem;
    border-radius: var(--radius-sm);
    background: var(--primary-soft);
    color: var(--primary);
  }
  .ph-step {
    background: var(--gold);
    color: var(--on-gold);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
  }
  .ph-card:has(.season-strip) {
    min-width: min(100%, 22rem);
  }
  .ph-progress {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }
  .ph-progress svg {
    flex: none;
    width: 3.75rem;
    height: 3.75rem;
    transform: rotate(-90deg);
  }
  .ph-progress circle {
    fill: none;
    stroke-width: 6;
    stroke-linecap: round;
  }
  .ph-progress-track {
    stroke: var(--surface-2);
  }
  .ph-progress-bar {
    stroke: var(--gold);
    animation: ph-fill 1.6s var(--ease-soft) 0.6s both;
  }
  @keyframes ph-fill {
    from {
      stroke-dasharray: 0 999;
    }
  }
  .ph-player {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: min(100%, 20rem);
  }
  .ph-play {
    display: grid;
    flex: none;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--gold);
    color: var(--on-gold);
    opacity: 0.9;
    cursor: not-allowed;
  }
  .ph-wave {
    display: flex;
    align-items: center;
    gap: 3px;
    height: 1.75rem;
    margin-block-start: 0.25rem;
  }
  .ph-wave i {
    flex: 1;
    height: var(--h);
    border-radius: var(--radius-xs);
    background: color-mix(in oklab, var(--primary) 45%, transparent);
  }

  /* ── Plain (legal pages): a calm typographic hero, no photo ──────────────────────── */
  [data-layout="plain"] .ph-frame {
    padding: clamp(2rem, 5vw, 4rem);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(color-mix(in oklab, var(--ink) 10%, transparent) 1px, transparent 1.5px) 0 0 / 22px 22px,
      var(--surface-2);
  }
  .ph-plain-cards {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* ── Desktop ─────────────────────────────────────────────────────────────────────── */
  @media (min-width: 64rem) {
    .ph {
      padding-inline: 1.5rem;
    }
    .ph-frame {
      min-height: calc(100svh - 7rem);
      align-items: center;
      padding-block: 2rem 4rem;
    }
    [data-layout="split-right"] .ph-frame {
      grid-template-columns: minmax(0, 1fr) minmax(0, 34rem);
      gap: 5rem;
    }
    [data-layout="split-left"] .ph-frame {
      grid-template-columns: minmax(0, 34rem) minmax(0, 1fr);
      grid-template-areas: "stage text";
      gap: 5rem;
    }
    [data-layout="split-left"] .ph-text {
      grid-area: text;
    }
    [data-layout="split-left"] .ph-stage {
      grid-area: stage;
    }
    .ph-stage {
      width: 100%;
    }
    [data-layout="centered"] .ph-frame {
      justify-items: center;
      gap: 2.5rem;
      text-align: center;
    }
    [data-layout="centered"] .ph-text {
      justify-items: center;
    }
    [data-layout="centered"] .ph-stage {
      width: min(100%, 36rem);
    }
    [data-shape="stadium"] .ph-stage {
      width: min(100%, 44rem);
    }
    [data-layout="centered"][data-shape="circle"] .ph-stage {
      width: min(100%, 24rem);
    }
    /* Scattered: positioned in % of the picture (see lib/heroes.ts), overflow allowed, never above. */
    .ph-cards {
      position: absolute;
      inset: 0;
      display: block;
      margin: 0;
      padding: 0;
      pointer-events: none;
    }
    .ph-card {
      position: absolute;
      inset-inline-start: calc(var(--x) * 1%);
      inset-block-start: calc(var(--y) * 1%);
      width: max-content;
      max-width: 15rem;
      rotate: calc(var(--r) * 1deg);
      pointer-events: auto;
    }
    .ph-card:hover {
      rotate: 0deg;
      translate: 0 -4px;
    }
    .ph-card-info,
    .ph-card-step {
      width: 13.5rem;
    }
    .ph-card-progress {
      width: 15rem;
    }
    .ph-card-player {
      width: 22rem;
      max-width: none;
    }
    .ph-credit {
      position: absolute;
      inset-inline-end: 0;
      inset-block-end: -1.75rem;
      margin: 0;
    }
  }

  /* ── Morph: a full-screen photo that shrinks into a rounded shape as you scroll ──── */
  [data-layout="morph"] .ph-text {
    color: var(--on-photo);
  }
  [data-layout="morph"] .ph-lead,
  [data-layout="morph"] .ph-eyebrow {
    color: var(--on-photo);
  }
  [data-layout="morph"] .ph-eyebrow {
    background: color-mix(in oklab, var(--scrim) 40%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--on-photo) 22%, transparent);
  }
  [data-layout="morph"] .ph-shape {
    clip-path: inset(0 round var(--radius-xl));
  }
  [data-layout="morph"] .ph-shape::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, color-mix(in oklab, var(--scrim) 25%, transparent), color-mix(in oklab, var(--scrim) 70%, transparent));
  }
  [data-layout="morph"] .ph-echo {
    display: none;
  }
  @media (max-width: 63.99rem) {
    [data-layout="morph"] .ph-stage {
      width: min(100%, 30rem);
      --ar: 0.8;
    }
    [data-layout="morph"] .ph-text {
      color: var(--ink);
    }
    [data-layout="morph"] .ph-lead {
      color: var(--ink-muted);
    }
    [data-layout="morph"] .ph-eyebrow {
      color: var(--ink);
      background: var(--surface);
    }
  }
  @media (min-width: 64rem) {
    [data-layout="morph"] .ph-frame {
      display: block;
      max-width: none;
      min-height: 100svh;
      padding: 0;
    }
    [data-layout="morph"] .ph-text {
      position: relative;
      z-index: 3;
      display: grid;
      place-content: center;
      justify-items: center;
      height: 100svh;
      padding-inline: 22%;
      text-align: center;
      pointer-events: none;
    }
    [data-layout="morph"] .ph-title {
      font-size: clamp(2.75rem, 1rem + 5vw, 6rem);
    }
    [data-layout="morph"] .ph-stage {
      position: absolute;
      inset: 0;
      width: 100%;
      justify-self: stretch;
      z-index: 1;
    }
    [data-layout="morph"] .ph-shape-wrap {
      position: absolute;
      inset: 0;
      aspect-ratio: auto;
      filter: none;
    }
    /* Final state: a rounded "pebble" with the cards around it. */
    [data-layout="morph"] .ph-shape {
      clip-path: inset(10% 15% 6% 15% round 46% / 38%);
    }
    [data-layout="morph"] .ph-credit {
      inset-inline-end: 1.5rem;
      inset-block-end: 0.5rem;
    }
    @supports (animation-timeline: scroll()) {
      @media (prefers-reduced-motion: no-preference) {
        [data-layout="morph"] .ph-frame {
          min-height: 190svh;
        }
        [data-layout="morph"] .ph-text {
          position: sticky;
          top: 0;
        }
        [data-layout="morph"] .ph-stage {
          position: sticky;
          inset: auto;
          top: 0;
          height: 100svh;
          margin-block-start: -100svh;
        }
        [data-layout="morph"] .ph-shape {
          animation: ph-morph linear both;
          animation-timeline: scroll(root);
          animation-range: 0 85svh;
        }
        [data-layout="morph"] .ph-shape img {
          animation: ph-zoom linear both;
          animation-timeline: scroll(root);
          animation-range: 0 85svh;
        }
        [data-layout="morph"] .ph-card {
          animation: ph-appear linear both;
          animation-timeline: scroll(root);
          animation-range: calc(30svh + var(--i) * 8svh) calc(80svh + var(--i) * 8svh);
        }
      }
    }
  }
  @keyframes ph-morph {
    from {
      clip-path: inset(0 0 0 0 round 0);
    }
    to {
      clip-path: inset(10% 15% 6% 15% round 46% / 38%);
    }
  }
  @keyframes ph-zoom {
    from {
      transform: scale(1.12);
    }
    to {
      transform: scale(1);
    }
  }
  @keyframes ph-appear {
    from {
      opacity: 0;
      translate: 0 2.5rem;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ph-shape img,
    .ph-card,
    .ph-progress-bar {
      animation: none;
    }
  }
</style>
