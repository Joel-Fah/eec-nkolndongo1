---
/**
 * Page hero — one layout per page (lib/heroes.ts), each different: fullbleed, arch, stack, panorama,
 * split, mosaic, path. Near full-screen photos inside a floating rounded frame, cards laid over them.
 * Without photos (production, until the media library) each layout keeps its shape on a tinted, textured
 * panel. Motion: the photo settles from a slight zoom and drifts with the scroll (scroll-driven, where
 * supported); cards rise in. Nothing moves with reduced motion.
 */
import { getSeason } from '@eec/core'
import Icon from '@eec/ui/astro/Icon.astro'
import { heroes } from '../../lib/heroes'
import { localeOf, useT } from '../../lib/i18n'
import { labelKey, pages, tabKey } from '../../lib/nav'
import { content } from '../../lib/pages'
import { heroSrc, photosById } from '../../lib/placeholders'
import SeasonStrip from '../home/SeasonStrip.astro'

interface Props {
  id: string
}
const { id } = Astro.props
const locale = localeOf(Astro.currentLocale)
const t = useT(locale)
const hero = heroes[id]
if (!hero) throw new Error(`No hero for page: ${id}`)
const page = content[id]
const tab = pages.find((p) => p.id === id)?.tab
const photos = photosById(hero.photos)
const [main, ...rest] = photos
const layout = hero.layout
// Facts (stat, progress) show their example only in dev, tagged; unvalidated ones are hidden in production.
const cards = hero.cards
  .map((c) =>
    c.kind === 'stat' || c.kind === 'progress'
      ? {
          ...c,
          shown: c.value ?? (import.meta.env.DEV ? c.example : null),
          isExample: c.value === null,
        }
      : c,
  )
  .filter((c) => !('shown' in c) || c.shown !== null)
const ring = 2 * Math.PI * 26
const title = t(labelKey(id))
const lead = page ? t(page.lead) : ''
const eyebrow = tab ? t(tabKey(tab)) : ''
const credit = (name: string) => t('home.stream.credit', { name })
---

<section class="ph" data-layout={layout} aria-labelledby="ph-title">
  <div class="ph-frame">
    {/* Main photo (every layout has one; mosaic/stack add more below) */}
    {layout !== 'plain' && (
    <figure class="ph-media ph-media-main">
      {
        main ? (
          <picture>
            <source type="image/avif" srcset={`${heroSrc(main, 1280, 'avif')} 1280w, ${heroSrc(main, 1920, 'avif')} 1920w`} sizes={layout === 'split' || layout === 'arch' ? '(min-width: 64rem) 55vw, 100vw' : '100vw'} />
            <img src={heroSrc(main, 1280, 'webp')} srcset={`${heroSrc(main, 1280, 'webp')} 1280w, ${heroSrc(main, 1920, 'webp')} 1920w`} sizes={layout === 'split' || layout === 'arch' ? '(min-width: 64rem) 55vw, 100vw' : '100vw'} alt={main.alt} width={main.width ?? 1920} height={main.height ?? 1280} fetchpriority="high" decoding="async" style={`background-image:url(${main.blur});background-color:${main.color}`} />
          </picture>
        ) : (
          <div class="ph-empty" aria-hidden="true"></div>
        )
      }
      {main && <figcaption class="ph-credit">{credit(main.photographer)}</figcaption>}
    </figure>
    )}

    {
      layout === 'mosaic' && (
        <div class="ph-mosaic-side">
          {[0, 1].map((i) => (
            <figure class="ph-media">
              {rest[i] ? <img src={heroSrc(rest[i], 1280, 'webp')} alt={rest[i].alt} width={rest[i].width ?? 1280} height={rest[i].height ?? 853} loading="lazy" decoding="async" style={`background-color:${rest[i].color}`} /> : <div class="ph-empty" aria-hidden="true"></div>}
            </figure>
          ))}
        </div>
      )
    }

    <div class="ph-text">
      {eyebrow && <p class="ph-eyebrow"><span class="ph-dot" aria-hidden="true"></span>{eyebrow}</p>}
      {layout === 'duotone' && <p class="ph-giant" aria-hidden="true">{t(`season.${getSeason()}` as 'season.avent')}</p>}
      {layout === 'gratitude' && <p class="ph-giant" aria-hidden="true">{t('hero.thanks')}</p>}
      <h1 id="ph-title" class="ph-title">{title}</h1>
      {lead && <p class="ph-lead">{lead}</p>}
    </div>

    {
      layout === 'stack' && rest.length > 0 && (
        <div class="ph-fan" aria-hidden="true">
          {rest.slice(0, 3).map((p, i) => (
            <img src={heroSrc(p, 1280, 'webp')} alt="" width="480" height="640" loading="lazy" decoding="async" style={`--i:${i};background-color:${p.color}`} />
          ))}
        </div>
      )
    }

    <ul class="ph-cards" role="list">
      {
        cards.map((c, i) => (
          <li class:list={['ph-card', `ph-card-${c.kind}`]} style={`--i:${i}`}>
            {c.kind === 'season' ? (
              <SeasonStrip />
            ) : c.kind === 'progress' ? (
              <div class="ph-progress">
                <svg viewBox="0 0 60 60" aria-hidden="true">
                  <circle cx="30" cy="30" r="26" pathLength={ring} class="ph-progress-track" />
                  <circle cx="30" cy="30" r="26" pathLength={ring} class="ph-progress-bar" style={`stroke-dasharray:${((c.shown ?? 0) / 100) * ring} ${ring}`} />
                </svg>
                <div>
                  <p class="ph-card-value">{c.shown}%{c.isExample && <span class="ph-example">{t('home.stats.example')}</span>}</p>
                  <p class="ph-card-label">{t(c.label)}</p>
                </div>
              </div>
            ) : c.kind === 'player' ? (
              <div class="ph-player">
                <button type="button" class="ph-play" disabled aria-label={`${t('hero.listen')} — ${t('hero.soon')}`}><Icon name="play" size={24} /></button>
                <div class="grid gap-1">
                  <p class="ph-card-title">{t(c.title)}</p>
                  <p class="ph-card-text">{t(c.text)}</p>
                  <span class="ph-wave" aria-hidden="true">{Array.from({ length: 36 }, (_, w) => <i style={`--h:${Math.round((Math.sin(w * 1.7) * 0.5 + 0.5) * 70 + 20)}%`}></i>)}</span>
                </div>
              </div>
            ) : c.kind === 'stat' ? (
              <>
                <p class="ph-card-value">
                  {c.shown}
                  {c.suffix}
                  {c.isExample && <span class="ph-example">{t('home.stats.example')}</span>}
                </p>
                <p class="ph-card-label">{t(c.label)}</p>
              </>
            ) : (
              <>
                {layout === 'path' ? <span class="ph-step">{i + 1}</span> : <span class="ph-card-icon"><Icon name={c.icon} size={20} /></span>}
                <p class="ph-card-title">{t(c.title)}</p>
                <p class="ph-card-text">{t(c.text)}</p>
              </>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style is:global>
  /* ── Shared ───────────────────────────────────────────────────────────────────────────── */
  .ph {
    --ph-h: max(34rem, calc(100svh - 6.5rem));
    padding: 1rem 0.75rem 0;
  }
  .ph-frame {
    position: relative;
    display: grid;
    max-width: 88rem;
    margin-inline: auto;
  }
  .ph-media {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-xl);
    background: var(--surface-2);
    isolation: isolate;
  }
  .ph-media img,
  .ph-empty {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background-size: cover;
  }
  .ph-media-main img {
    animation: ph-settle 1.6s var(--ease-soft) both;
  }
  @supports (animation-timeline: view()) {
    .ph-media-main picture {
      display: block;
      height: 100%;
      animation: ph-drift linear both;
      animation-timeline: view();
      animation-range: exit 0% exit 100%;
    }
  }
  @keyframes ph-settle {
    from {
      transform: scale(1.06);
    }
  }
  @keyframes ph-drift {
    to {
      transform: translateY(12%);
    }
  }
  /* No photo yet: a tinted, textured panel in the season colour. */
  .ph-empty {
    min-height: 100%;
    background:
      radial-gradient(color-mix(in oklab, var(--ink) 14%, transparent) 1px, transparent 1.5px) 0 0 / 22px 22px,
      radial-gradient(60% 80% at 80% 20%, color-mix(in oklab, var(--season) 35%, transparent), transparent 70%),
      radial-gradient(50% 70% at 10% 90%, color-mix(in oklab, var(--gold) 30%, transparent), transparent 70%),
      var(--surface-2);
  }
  .ph-credit {
    position: absolute;
    inset: auto 0.875rem 0.875rem auto;
    z-index: 2;
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-xs);
    background: color-mix(in oklab, var(--scrim) 55%, transparent);
    font-size: var(--text-xs);
    color: var(--on-photo);
  }
  .ph-text {
    position: relative;
    z-index: 2;
    display: grid;
    align-content: end;
    gap: 1rem;
  }
  .ph-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 600;
    box-shadow: var(--elevation-1);
  }
  .ph-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--season);
  }
  .ph-title {
    font-size: clamp(2.75rem, 1.4rem + 5vw, 6rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.035em;
  }
  .ph-lead {
    max-width: 40rem;
    font-size: var(--text-lg);
  }
  .ph-cards {
    position: relative;
    z-index: 3;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .ph-card {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    min-width: 10rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--elevation-2);
    animation: ph-rise var(--duration-nav) var(--ease-soft) calc(0.5s + var(--i) * 90ms) both;
  }
  @keyframes ph-rise {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }
  .ph-card-value {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .ph-example {
    margin-inline-start: 0.375rem;
    align-self: center;
    padding: 0.125rem 0.375rem;
    border-radius: var(--radius-xs);
    background: var(--warning-soft);
    color: var(--warning);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0;
  }
  .ph-card-label,
  .ph-card-text {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  .ph-card-title {
    font-weight: 600;
  }
  .ph-card-icon,
  .ph-step {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-block-end: 0.5rem;
    border-radius: var(--radius-md);
    background: var(--primary-soft);
    color: var(--primary);
  }
  .ph-step {
    font-family: var(--font-display);
    font-size: var(--text-xl);
  }
  /* Glass cards on a photo (fullbleed, stack, panorama, path): light text on a blurred dark tint. */
  .ph-on-photo,
  :is([data-layout="fullbleed"], [data-layout="stack"], [data-layout="panorama"], [data-layout="path"]) .ph-card {
    background: color-mix(in oklab, var(--scrim) 38%, transparent);
    backdrop-filter: blur(18px) saturate(1.3);
    -webkit-backdrop-filter: blur(18px) saturate(1.3);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--on-photo) 18%, transparent);
    color: var(--on-photo);
  }
  :is([data-layout="fullbleed"], [data-layout="stack"], [data-layout="panorama"], [data-layout="path"]) :is(.ph-card-label, .ph-card-text) {
    color: color-mix(in oklab, var(--on-photo) 82%, transparent);
  }
  :is([data-layout="fullbleed"], [data-layout="stack"], [data-layout="panorama"], [data-layout="path"]) :is(.ph-card-icon, .ph-step) {
    background: color-mix(in oklab, var(--on-photo) 16%, transparent);
    color: var(--on-photo);
  }

  /* Phones: photo first with the title on it (photo layouts) or after the text; cards follow. */
  @media (max-width: 63.99rem) {
    .ph-media-main {
      min-height: 62svh;
    }
    .ph-credit {
      inset: 0.875rem 0.875rem auto auto;
    }
    .ph-cards {
      margin-block-start: 1rem;
    }
    .ph-card {
      flex: 1 1 10rem;
    }
    :is([data-layout="fullbleed"], [data-layout="stack"], [data-layout="panorama"], [data-layout="path"]) .ph-frame {
      grid-template-areas: "stage" "cards";
    }
    :is([data-layout="fullbleed"], [data-layout="stack"], [data-layout="panorama"], [data-layout="path"]) :is(.ph-media-main, .ph-text) {
      grid-area: stage;
    }
    :is([data-layout="fullbleed"], [data-layout="stack"], [data-layout="panorama"], [data-layout="path"]) .ph-text {
      padding: 1.5rem;
      color: var(--on-photo);
    }
    :is([data-layout="fullbleed"], [data-layout="stack"], [data-layout="panorama"], [data-layout="path"]) .ph-media-main::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(transparent 30%, color-mix(in oklab, var(--scrim) 80%, transparent));
    }
    :is([data-layout="fullbleed"], [data-layout="stack"], [data-layout="panorama"], [data-layout="path"]) .ph-card {
      background: var(--surface);
      backdrop-filter: none;
      color: var(--ink);
      box-shadow: var(--elevation-1);
    }
    :is([data-layout="fullbleed"], [data-layout="stack"], [data-layout="panorama"], [data-layout="path"]) :is(.ph-card-label, .ph-card-text) {
      color: var(--ink-muted);
    }
    :is([data-layout="fullbleed"], [data-layout="stack"], [data-layout="panorama"], [data-layout="path"]) :is(.ph-card-icon, .ph-step) {
      background: var(--primary-soft);
      color: var(--primary);
    }
    :is([data-layout="arch"], [data-layout="split"], [data-layout="mosaic"]) .ph-frame {
      gap: 1.25rem;
    }
    :is([data-layout="arch"], [data-layout="split"], [data-layout="mosaic"]) .ph-text {
      order: -1;
      padding-block-start: 1.5rem;
    }
    .ph-fan,
    .ph-mosaic-side {
      display: none;
    }
    [data-layout="arch"] .ph-media-main {
      border-radius: 50vw 50vw var(--radius-xl) var(--radius-xl);
    }
  }

  /* ── Desktop layouts ─────────────────────────────────────────────────────────────────── */
  @media (min-width: 64rem) {
    .ph-frame {
      min-height: var(--ph-h);
    }
    /* Photo-filled layouts: the frame is the screen, whatever the photo's proportions. */
    :is([data-layout="fullbleed"], [data-layout="stack"], [data-layout="panorama"], [data-layout="path"]) .ph-frame {
      height: var(--ph-h);
    }
    .ph-media {
      min-height: 0;
    }

    /* 1. Fullbleed: the photo fills the frame; title low on the left; figures as glass cards bottom right. */
    [data-layout="fullbleed"] .ph-frame {
      grid-template: 1fr auto / 1fr auto;
    }
    [data-layout="fullbleed"] .ph-media-main {
      grid-area: 1 / 1 / 3 / 3;
    }
    [data-layout="fullbleed"] .ph-media-main::after,
    [data-layout="path"] .ph-media-main::after,
    [data-layout="stack"] .ph-media-main::after,
    [data-layout="panorama"] .ph-media-main::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, transparent 35%, color-mix(in oklab, var(--scrim) 78%, transparent));
    }
    [data-layout="fullbleed"] .ph-text {
      grid-area: 1 / 1 / 3 / 2;
      padding: 3.5rem;
      color: var(--on-photo);
    }
    [data-layout="fullbleed"] .ph-title {
      font-size: clamp(4rem, 2rem + 6vw, 8rem);
    }
    [data-layout="fullbleed"] .ph-cards {
      grid-area: 2 / 2;
      align-self: end;
      flex-direction: column;
      padding: 2.5rem;
    }

    /* 2. Arch: the photo in a tall church-window arch on the right; text left; cards ride its edges. */
    [data-layout="arch"] .ph-frame {
      grid-template-columns: 1fr minmax(0, 34rem);
      align-items: center;
      gap: 4rem;
      padding-inline: 2rem;
    }
    [data-layout="arch"] .ph-media-main {
      grid-area: 1 / 2;
      height: calc(var(--ph-h) - 2rem);
      border-radius: 17rem 17rem var(--radius-xl) var(--radius-xl);
      box-shadow: var(--elevation-3);
    }
    [data-layout="arch"] .ph-text {
      grid-area: 1 / 1;
      align-content: center;
    }
    [data-layout="arch"] .ph-cards {
      grid-area: 1 / 2;
      align-self: stretch;
      display: block;
      pointer-events: none;
    }
    [data-layout="arch"] .ph-card {
      position: absolute;
      width: 17rem;
      pointer-events: auto;
    }
    [data-layout="arch"] .ph-card:nth-child(1) {
      inset: 38% auto auto -7rem;
    }
    [data-layout="arch"] .ph-card:nth-child(2) {
      inset: auto -2.5rem 3rem auto;
    }

    /* 3. Stack: the photo dimmed as a backdrop; a fan of portrait cards on the right; figures under the text. */
    [data-layout="stack"] .ph-frame {
      grid-template: 1fr auto / 1.1fr 1fr;
    }
    [data-layout="stack"] .ph-media-main {
      grid-area: 1 / 1 / 3 / 3;
    }
    [data-layout="stack"] .ph-media-main::after {
      background: linear-gradient(90deg, color-mix(in oklab, var(--scrim) 82%, transparent) 25%, color-mix(in oklab, var(--scrim) 30%, transparent));
    }
    [data-layout="stack"] .ph-text {
      grid-area: 1 / 1;
      padding: 3.5rem 3.5rem 1.5rem;
      color: var(--on-photo);
    }
    [data-layout="stack"] .ph-cards {
      grid-area: 2 / 1;
      padding: 0 3.5rem 3.5rem;
    }
    .ph-fan {
      grid-area: 1 / 2 / 3 / 3;
      position: relative;
      z-index: 2;
      align-self: center;
      justify-self: center;
      width: 22rem;
      height: 26rem;
    }
    .ph-fan img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: var(--radius-lg);
      box-shadow: 0 0 0 6px var(--on-photo), var(--elevation-3);
      transform: rotate(calc((var(--i) - 1) * 9deg)) translateX(calc((var(--i) - 1) * 5rem));
      transition: transform var(--duration-nav) var(--ease-spring);
    }
    .ph-fan:hover img {
      transform: rotate(calc((var(--i) - 1) * 13deg)) translateX(calc((var(--i) - 1) * 8rem)) translateY(-0.5rem);
    }

    /* 4. Panorama: a wide view; title top-left; practical cards as glass panels at the bottom. */
    [data-layout="panorama"] .ph-frame {
      grid-template: auto 1fr auto / 1fr;
    }
    [data-layout="panorama"] .ph-media-main {
      grid-area: 1 / 1 / 4 / 2;
    }
    [data-layout="panorama"] .ph-media-main::after {
      background:
        linear-gradient(180deg, color-mix(in oklab, var(--scrim) 70%, transparent), transparent 40%),
        linear-gradient(0deg, color-mix(in oklab, var(--scrim) 60%, transparent), transparent 35%);
    }
    [data-layout="panorama"] .ph-text {
      grid-area: 1 / 1;
      padding: 3.5rem;
      color: var(--on-photo);
    }
    [data-layout="panorama"] .ph-cards {
      grid-area: 3 / 1;
      padding: 2.5rem;
    }
    [data-layout="panorama"] .ph-card {
      flex: 0 1 24rem;
    }

    /* 5. Split: text left, photo right; figures stacked across the seam. */
    [data-layout="split"] .ph-frame {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: 3rem;
      padding-inline-start: 2rem;
    }
    [data-layout="split"] .ph-media-main {
      grid-area: 1 / 2;
      min-height: var(--ph-h);
    }
    [data-layout="split"] .ph-text {
      grid-area: 1 / 1;
      align-content: center;
    }
    [data-layout="split"] .ph-cards {
      grid-area: 1 / 2;
      align-self: center;
      justify-self: start;
      flex-direction: column;
      width: 17rem;
      margin-inline-start: -5.5rem;
    }

    /* 6. Mosaic: one large photo and two smaller ones; the title on a glass card; figures on the right. */
    [data-layout="mosaic"] .ph-frame {
      grid-template: 1fr 1fr / 1.6fr 1fr;
      gap: 0.75rem;
      height: var(--ph-h);
    }
    [data-layout="mosaic"] .ph-media-main {
      grid-area: 1 / 1 / 3 / 2;
    }
    [data-layout="mosaic"] .ph-credit {
      inset: 0.875rem 0.875rem auto auto;
    }
    .ph-mosaic-side {
      grid-area: 1 / 2 / 3 / 3;
      display: grid;
      gap: 0.75rem;
    }
    [data-layout="mosaic"] .ph-text {
      grid-area: 2 / 1;
      align-self: end;
      max-width: 40rem;
      margin: 1.5rem;
      padding: 2rem;
      border-radius: var(--radius-lg);
      background: color-mix(in oklab, var(--surface) 86%, transparent);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      box-shadow: var(--elevation-2);
    }
    [data-layout="mosaic"] .ph-title {
      font-size: clamp(3rem, 1.6rem + 3.6vw, 5rem);
    }
    [data-layout="mosaic"] .ph-cards {
      grid-area: 1 / 2;
      align-self: start;
      justify-self: end;
      margin: 1.25rem;
    }

    /* 7. Path: the photo full width; title top; numbered steps as glass cards along the bottom, joined by a line. */
    [data-layout="path"] .ph-frame {
      grid-template: 1fr auto / 1fr;
    }
    [data-layout="path"] .ph-media-main {
      grid-area: 1 / 1 / 3 / 2;
    }
    [data-layout="path"] .ph-text {
      grid-area: 1 / 1;
      padding: 3.5rem;
      color: var(--on-photo);
    }
    [data-layout="path"] .ph-cards {
      grid-area: 2 / 1;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
