---
import { createT } from '@eec/i18n'
import ErrorScreen from '../components/ErrorScreen.astro'
import Base from '../layouts/Base.astro'
import { href, pages } from '../lib/nav'

// One 404 for the whole site (static hosting serves a single file): both languages, the script picks one.
const fr = createT('fr')
const en = createT('en')
const to = (id: string) => ({
  fr: href('fr', pages.find((p) => p.id === id)?.path.fr ?? ''),
  en: href('en', pages.find((p) => p.id === id)?.path.en ?? ''),
})
---

<Base title={fr('notfound.title')} noindex>
  <ErrorScreen
    code="404"
    title={{ fr: fr('notfound.title'), en: en('notfound.title') }}
    text={{ fr: fr('notfound.text'), en: en('notfound.text') }}
    actions={[
      { label: { fr: fr('soon.home'), en: en('soon.home') }, href: { fr: '/fr/', en: '/en/' }, primary: true },
      { label: { fr: fr('nav.items.cultes.label'), en: en('nav.items.cultes.label') }, href: to('cultes') },
      { label: { fr: fr('nav.items.trouver.label'), en: en('nav.items.trouver.label') }, href: to('trouver') },
      { label: { fr: fr('nav.items.evenements.label'), en: en('nav.items.evenements.label') }, href: to('evenements') },
    ]}
  />
</Base>
