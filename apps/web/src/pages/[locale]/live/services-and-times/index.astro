---
import SchedulePage from '../../../../components/content/SchedulePage.astro'
import { pages } from '../../../../lib/nav'

export const prerender = false
const locale = Astro.currentLocale === 'en' ? 'en' : 'fr'
const path = pages.find((p) => p.id === 'cultes')?.path[locale] ?? ''
if (!Astro.url.pathname.startsWith(`/${locale}/${path}`)) return Astro.rewrite('/404')
---

<SchedulePage />
