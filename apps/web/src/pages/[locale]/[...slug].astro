---
import { locales } from '@eec/i18n'
import AccountView from '../../components/AccountView.astro'
import PageView from '../../components/PageView.astro'
import PageHero from '../../components/page/PageHero.astro'
import Site from '../../layouts/Site.astro'
import { heroes } from '../../lib/heroes'
import { localeOf, useT } from '../../lib/i18n'
import { labelKey, pages } from '../../lib/nav'
import { content } from '../../lib/pages'

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    pages
      .filter((page) => page.id !== 'nouvelles')
      .map((page) => ({ params: { locale, slug: page.path[locale] }, props: { id: page.id } })),
  )
}

const { id } = Astro.props
const t = useT(localeOf(Astro.currentLocale))
const page = content[id]
---

<Site title={t(labelKey(id))} description={page ? t(page.lead) : undefined}>
  {
    id === 'account' ? (
      <AccountView />
    ) : heroes[id] ? (
      <>
        <PageHero id={id} />
        <PageView id={id} hideHeader />
      </>
    ) : (
      <PageView id={id} />
    )
  }
</Site>
