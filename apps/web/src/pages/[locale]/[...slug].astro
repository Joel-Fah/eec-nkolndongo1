---
import { locales } from '@eec/i18n'
import ComingSoon from '../../components/ComingSoon.astro'
import Site from '../../layouts/Site.astro'
import { localeOf, useT } from '../../lib/i18n'
import { labelKey, pages } from '../../lib/nav'

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    pages.map((page) => ({ params: { locale, slug: page.path[locale] }, props: { id: page.id } })),
  )
}

const { id } = Astro.props
const t = useT(localeOf(Astro.currentLocale))
const title = t(labelKey(id))
---

<Site title={title} description={t('soon.text')}>
  <ComingSoon pageTitle={title} />
</Site>
