---
import { getSeason } from '@eec/core'
import Button from '@eec/ui/astro/Button.astro'
import Icon from '@eec/ui/astro/Icon.astro'
import Illustration from '@eec/ui/astro/Illustration.astro'
import HeroStream from '../../components/home/HeroStream.astro'
import SeasonStrip from '../../components/home/SeasonStrip.astro'
import Site from '../../layouts/Site.astro'
import { eventsListHref } from '../../lib/events-routes'
import { localeOf, localePaths, useT } from '../../lib/i18n'
import { href, pages as navPages, pages } from '../../lib/nav'
import { newsListHref } from '../../lib/news-routes'
import '../../styles/patterns.css'

export const getStaticPaths = localePaths

const locale = localeOf(Astro.currentLocale)
const t = useT(locale)
const season = getSeason()
const seasonLabel = t(`season.${season}` as 'season.avent')
const pathOf = (id: string) => href(locale, pages.find((p) => p.id === id)?.path[locale] ?? '')
const figureIds = ['years', 'groups', 'sundays', 'members'] as const
const groups = ['choirs', 'youth', 'women', 'men', 'children', 'readers', 'welcome'] as const
---

<Site title={t('site.name')} description={t('home.lead')}>
  <section class="home-hero">
    <div class="home-hero-head">
      <a class="home-kicker" href={pathOf('liturgie')}>
        <span class="home-kicker-dot" aria-hidden="true"></span>
        <span>{t('home.season', { season: seasonLabel })}</span>
        <Icon name="arrowRight" size={16} />
      </a>
      <h1 class="home-title">
        <span class="home-title-line">{t('home.title_a')}</span>
        <span class="home-title-line">{t('home.title_b')} <span class="home-title-mark">{t('home.title_c')}<svg viewBox="0 0 300 24" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M4 17C58 7 122 5 176 9s84 6 120 2" /></svg></span></span>
      </h1>
      <p class="home-lead" data-slot="home.lead">{t('home.lead')}</p>
      <div class="flex flex-wrap justify-center gap-3">
        <Button href={pathOf('cultes')} size="lg" data-magnetic>{t('home.cta_visit')}<Icon name="arrowRight" /></Button>
        <Button href={pathOf('histoire')} size="lg" variant="secondary">{t('home.cta_discover')}</Button>
      </div>
    </div>

    <HeroStream />

    <dl class="home-stats" data-home-figures hidden>
      {
        figureIds.map((id) => (
          <div class="home-stat" data-fig={id} hidden>
            <dt>{t(`home.stats.${id}` as 'home.stats.years')}</dt>
            <dd><span class="home-stat-value">0</span><span data-fig-suffix></span></dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="home-section" aria-labelledby="start-title">
    <div class="home-section-head">
      <p class="home-eyebrow">{t('home.start_eyebrow')}</p>
      <h2 id="start-title" class="text-4xl">{t('home.start_title')}</h2>
    </div>

    <div class="bento">
      <a class="bento-card bento-visit" href={pathOf('cultes')} data-glow>
        <div class="grid gap-3">
          <span class="bento-icon"><Icon name="church" /></span>
          <h3 class="text-2xl">{t('home.start1_t')}</h3>
          <p class="max-w-[34ch] text-ink-muted">{t('home.start1_p')}</p>
          <span class="bento-more">{t('home.more')}<Icon name="arrowRight" size={16} /></span>
        </div>
        <Illustration name="group" class="bento-art" />
      </a>

      <a class="bento-card bento-groups" href={pathOf('departements')} data-glow>
        <div class="grid gap-3">
          <span class="bento-icon"><Icon name="users" /></span>
          <h3 class="text-2xl">{t('home.start2_t')}</h3>
          <p class="text-ink-muted">{t('home.start2_p')}</p>
        </div>
        <ul class="bento-chips" role="list">
          {groups.map((g, i) => <li style={`--i:${i}`}>{t(`home.groups.${g}` as 'home.groups.choirs')}</li>)}
        </ul>
        <span class="bento-more">{t('home.more')}<Icon name="arrowRight" size={16} /></span>
      </a>

      <a class="bento-card bento-season" href={pathOf('liturgie')} data-glow>
        <div class="grid gap-1">
          <p class="home-eyebrow">{t('home.season_eyebrow')}</p>
          <h3 class="text-2xl">{seasonLabel}</h3>
          <p class="text-sm text-ink-muted">{t(`pages.liturgie.season_${season}` as 'pages.liturgie.season_avent')}</p>
        </div>
        <SeasonStrip />
      </a>

      <figure class="bento-card bento-verse" data-verse-of-day data-locale={locale}>
        <span class="bento-verse-mark" aria-hidden="true">{locale === 'fr' ? '«' : '“'}</span>
        <blockquote class="bento-verse-text">{t('home.verse')}</blockquote>
        <figcaption class="bento-verse-cite">{t('home.verse_cite')}</figcaption>
      </figure>

      <a class="bento-card bento-account" href={pathOf('account')} data-glow>
        <div class="grid gap-3">
          <span class="bento-icon"><Icon name="account" /></span>
          <h3 class="text-2xl">{t('home.account_t')}</h3>
          <p class="text-ink-muted">{t('home.account_p')}</p>
        </div>
        <span class="bento-more">{t('home.account_cta')}<Icon name="arrowRight" size={16} /></span>
      </a>

      <a class="bento-card bento-story" href={pathOf('histoire')} data-glow>
        <div class="grid gap-3">
          <span class="bento-icon"><Icon name="compass" /></span>
          <h3 class="text-2xl">{t('home.start3_t')}</h3>
          <p class="text-ink-muted">{t('home.start3_p')}</p>
        </div>
        <span class="bento-more">{t('home.more')}<Icon name="arrowRight" size={16} /></span>
      </a>
    </div>
  </section>
  <section class="home-section sunday" aria-labelledby="sunday-title" data-sunday data-supper={t('liturgy.site.holy_supper')} data-season_avent={t('season.avent')} data-season_noel={t('season.noel')} data-season_epiphanie={t('season.epiphanie')} data-season_careme={t('season.careme')} data-season_semaine-sainte={t('season.semaine-sainte')} data-season_paques={t('season.paques')} data-season_pentecote={t('season.pentecote')} data-season_moissons={t('season.moissons')} data-locale={locale} data-base={href(locale, pages.find((p) => p.id === 'dimanche')?.path[locale] ?? '')} hidden>
    <div class="sunday-deck">
    <div class="sunday-card">
      <Illustration name="cherry-blossom" class="sunday-art" />
      <div class="sunday-body">
        <header class="sunday-head">
          <p class="sunday-kicker"><span class="sunday-dot" aria-hidden="true"></span><span id="sunday-title">{t('liturgy.site.title')}</span></p>
          <p class="sunday-date" data-sunday-date></p>
        </header>
        <div class="sunday-titlerow">
          <p class="flip-time sunday-time" data-sunday-time-block hidden role="img" data-sunday-time></p>
          <h2 class="sunday-name" data-sunday-name></h2>
        </div>
        <p class="sunday-tags" data-sunday-tags hidden>
          <span class="sunday-chip sunday-chip-season" data-sunday-season hidden></span>
          <span class="sunday-chip sunday-chip-supper" data-sunday-tag hidden></span>
        </p>
        <p class="sunday-theme" data-sunday-theme hidden></p>
        <div class="sunday-foot">
          <ul class="sunday-readings" data-sunday-readings role="list" aria-label={t('liturgy.site.readings')}></ul>
          <Button href={href(locale, pages.find((p) => p.id === 'dimanche')?.path[locale] ?? '')} data-sunday-link>{t('liturgy.site.see_program')}<Icon name="arrowRight" size={20} /></Button>
        </div>
      </div>
    </div>
    </div>
  </section>

  <section class="home-section" aria-labelledby="upcoming-title" data-upcoming data-locale={locale} data-base={eventsListHref(locale)} hidden>
    <div class="home-section-head">
      <h2 id="upcoming-title" class="text-4xl">{t('events.site.upcoming_t')}</h2>
    </div>
    <ul class="up-list" data-upcoming-list role="list"></ul>
    <p class="ln-all"><a href={eventsListHref(locale)}>{t('events.site.upcoming_all')}</a></p>
  </section>

  <section class="home-section" aria-labelledby="latest-title" data-latest-news data-locale={locale} data-base={newsListHref(locale)} data-more={t('news.site.latest_all')} hidden>
    <div class="home-section-head">
      <h2 id="latest-title" class="text-4xl">{t('news.site.latest_t')}</h2>
    </div>
    <ul class="ln-list" data-latest-list role="list"></ul>
    <p class="ln-all"><a data-latest-all href={newsListHref(locale)}>{t('news.site.latest_all')}</a></p>
  </section>
</Site>

<script>
  import { showLatestNews } from '../../lib/latest-news-client'
  import { showSunday } from '../../lib/sunday-client'
  import { showUpcoming } from '../../lib/upcoming-client'
  showSunday()
  document.addEventListener('astro:page-load', showSunday)
  showLatestNews()
  showUpcoming()
  document.addEventListener('astro:page-load', showLatestNews)
  document.addEventListener('astro:page-load', showUpcoming)
</script>

<script>
  // Figures count up once, when they come into view. Reduced motion: they are simply there.
  const run = () => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue
          io.unobserve(entry.target)
          const el = entry.target as HTMLElement
          const target = Number(el.dataset.count)
          const start = performance.now()
          const tick = (now: number) => {
            const p = Math.min(1, (now - start) / 1400)
            el.textContent = String(Math.round(target * (1 - (1 - p) ** 4)))
            if (p < 1) requestAnimationFrame(tick)
          }
          requestAnimationFrame(tick)
        }
      },
      { threshold: 0.6 },
    )
    for (const el of document.querySelectorAll('[data-count]')) io.observe(el)
  }
  run()
  document.addEventListener('astro:after-swap', run)
  // The figures arrive from the slots after the page is up: count them up once they are filled.
  window.addEventListener('eec:figures', run)
</script>

<style is:global>
  .home-hero {
    position: relative;
    display: grid;
    justify-items: center;
    padding-block: clamp(3rem, 8vw, 6.5rem) 0;
    isolation: isolate;
  }
  /* A faint dot grid, fading out downwards: the "blueprint" texture of a modern product page. */
  .home-hero::before {
    content: "";
    position: absolute;
    inset: -6rem 0 30%;
    z-index: -1;
    background-image: radial-gradient(color-mix(in oklab, var(--ink) 16%, transparent) 1px, transparent 1.5px);
    background-size: 22px 22px;
    -webkit-mask: radial-gradient(ellipse 70% 70% at 50% 30%, black, transparent 75%);
    mask: radial-gradient(ellipse 70% 70% at 50% 30%, black, transparent 75%);
  }
  .home-hero::after {
    content: "";
    position: absolute;
    inset: 10% 15% 40%;
    z-index: -1;
    border-radius: 50%;
    background: color-mix(in oklab, var(--season) 16%, transparent);
    filter: blur(80px);
  }
  .home-hero-head {
    display: grid;
    justify-items: center;
    gap: 1.5rem;
    max-width: 76rem;
    padding-inline: 1rem;
    text-align: center;
  }
  .home-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-md);
    background: color-mix(in oklab, var(--surface) 80%, transparent);
    box-shadow: inset 0 0 0 1px var(--line), var(--elevation-1);
    font-size: var(--text-sm);
    font-weight: 500;
    transition: box-shadow var(--duration-ui) var(--ease-out), transform var(--duration-ui) var(--ease-out);
  }
  .home-kicker:hover {
    transform: translateY(-1px);
    box-shadow: inset 0 0 0 1px var(--season), var(--elevation-2);
  }
  .home-kicker-dot {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: var(--season);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--season) 22%, transparent);
    animation: kicker-pulse 2.4s var(--ease-in-out) infinite;
  }
  @keyframes kicker-pulse {
    50% {
      box-shadow: 0 0 0 7px color-mix(in oklab, var(--season) 0%, transparent);
    }
  }
  .home-title {
    font-size: clamp(2.25rem, 1.2rem + 3.9vw, 4.5rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.02em;
  }
  /* Two lines on tablet and desktop; on phones each line may wrap. */
  .home-title-line {
    display: block;
  }
  .home-title-mark {
    position: relative;
    display: inline-block;
    font-style: italic;
    color: var(--primary);
  }
  .home-title-mark svg {
    position: absolute;
    inset: auto -2% -0.12em;
    width: 104%;
    height: 0.24em;
    overflow: visible;
  }
  .home-title-mark path {
    fill: none;
    stroke: var(--gold);
    stroke-width: 7;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: mark-draw 0.9s var(--ease-out) 0.5s forwards;
  }
  html:not([data-preloaded]) .home-title-mark path {
    animation-delay: 2.5s;
  }
  @keyframes mark-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  .home-lead {
    max-width: 44rem;
    font-size: var(--text-lg);
    color: var(--ink-muted);
  }

  .home-section {
    display: grid;
    gap: 2.5rem;
    max-width: 80rem;
    margin: clamp(5rem, 10vw, 8rem) auto 0;
    padding-inline: 1rem;
  }
  @media (min-width: 48rem) {
    .home-section {
      padding-inline: 2rem;
    }
  }
  .home-section-head {
    display: grid;
    gap: 0.75rem;
    max-width: 40rem;
  }
  .home-eyebrow {
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--season-ink);
  }

  /* The little light marks around the book twinkle while the card is hovered. */
  .bento-visit [data-part="marks"] path:first-child {
    transform-origin: 270px 160px;
    transition: transform var(--duration-nav) var(--ease-spring);
  }
  .bento-visit:hover [data-part="marks"] path:first-child {
    transform: scale(1.35) translateY(-4px);
  }
  @media (prefers-reduced-motion: reduce) {
    .home-kicker-dot {
      animation: none;
    }
    .home-title-mark path {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
  .up-list {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
  }
  .up-card {
    display: grid;
    gap: 0.25rem;
    height: 100%;
    padding: 1.25rem;
    border-radius: var(--radius-xl);
    background: var(--surface);
    box-shadow: var(--elevation-1);
    text-decoration: none;
  }
  .up-card time {
    color: var(--primary);
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: capitalize;
  }
  .up-card strong {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.2;
  }
  .up-card span {
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
</style>

<style is:global>
  [data-latest-news][hidden],
  [data-upcoming][hidden],
  [data-sunday][hidden] {
    display: none;
  }
  .ln-list {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
  }
  /* The card's background wraps the photo: a frame all round, a rounded photo (radius = card radius − frame), and a
     gentle zoom inside the photo on hover. */
  .ln-card {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    height: 100%;
    padding: 0.625rem;
    border-radius: var(--radius-xl);
    background: var(--surface);
    box-shadow: var(--elevation-1);
    text-decoration: none;
    transition: transform var(--duration-ui) var(--ease-out);
  }
  .ln-card:hover {
    transform: translateY(-0.25rem);
  }
  .ln-photo {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border-radius: calc(var(--radius-xl) - 0.625rem);
    background: var(--surface-2);
  }
  .ln-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-story, 0.9s) var(--ease-out);
  }
  .ln-card:hover .ln-photo img,
  .ln-card:focus-visible .ln-photo img {
    transform: scale(1.07);
  }
  .ln-body {
    display: grid;
    align-content: start;
    gap: 0.375rem;
    padding: 0.5rem 0.75rem 0.75rem;
  }
  .ln-body time,
  .ln-excerpt {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  .ln-body strong {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.2;
  }
  .ln-all {
    margin-block-start: 1.25rem;
    text-align: center;
    font-weight: 600;
  }
  @media (prefers-reduced-motion: reduce) {
    .ln-card:hover {
      transform: none;
    }
    .ln-photo img,
    .ln-card:hover .ln-photo img {
      transform: none;
      transition: none;
    }
  }
  .up-list {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
  }
  .up-card {
    display: grid;
    gap: 0.25rem;
    height: 100%;
    padding: 1.25rem;
    border-radius: var(--radius-xl);
    background: var(--surface);
    box-shadow: var(--elevation-1);
    text-decoration: none;
  }
  .up-card time {
    color: var(--primary);
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: capitalize;
  }
  .up-card strong {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.2;
  }
  .up-card span {
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }

  /* « Ce dimanche »: season-tinted card, the cherry blossom (flipped, cropped on the right edge) behind the text. */
  /* The whole card sits on two empty cards, centred beneath it, like a deck. */
  .sunday-deck {
    position: relative;
    isolation: isolate;
    margin-block-end: 1.5rem;
  }
  .sunday-deck::before,
  .sunday-deck::after {
    content: '';
    position: absolute;
    z-index: -1;
    height: 100%;
    border-radius: var(--radius-xl);
    background: color-mix(in oklab, var(--season) 12%, var(--surface));
    box-shadow: var(--elevation-1), inset 0 0 0 1.5px color-mix(in oklab, var(--season) 28%, transparent);
  }
  .sunday-deck::before {
    inset-inline: 1.25rem;
    inset-block-start: 0.75rem;
    opacity: 0.8;
  }
  .sunday-deck::after {
    inset-inline: 2.5rem;
    inset-block-start: 1.5rem;
    opacity: 0.55;
  }
  .sunday-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: var(--radius-xl);
    background: color-mix(in oklab, var(--season) 12%, var(--surface));
    box-shadow: var(--elevation-1), inset 0 0 0 1.5px color-mix(in oklab, var(--season) 35%, transparent);
  }
  .sunday-card .sunday-art {
    position: absolute;
    inset-block: -45% -45%;
    inset-inline-end: 5%;
    z-index: -1;
    width: auto;
    height: 190%;
    aspect-ratio: 1;
    transform: scaleX(-1);
    pointer-events: none;
  }
  .sunday-card .sunday-art img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  /* The text side stays calm: a soft veil from the card's colour over the left part of the picture. */
  .sunday-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, color-mix(in oklab, var(--season) 12%, var(--surface)) 38%, transparent 78%);
  }
  .sunday-body {
    display: grid;
    gap: 0.75rem;
    max-width: 38rem;
    padding: clamp(1.5rem, 3.4vw, 2.25rem);
  }
  .sunday-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
  }
  .sunday-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
  }
  .sunday-dot {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--season);
  }
  .sunday-date {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink);
    padding-inline-start: 0.75rem;
    box-shadow: -1.5px 0 0 var(--line-strong);
  }
  .sunday-name {
    font-family: var(--font-display);
    font-size: clamp(var(--text-2xl), 3.6vw, var(--text-3xl, 2rem));
    line-height: 1.1;
  }
  .sunday-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .sunday-chip {
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .sunday-chip-season {
    background: color-mix(in oklab, var(--season) 30%, var(--surface));
  }
  .sunday-chip-supper {
    background: var(--gold-soft, var(--primary-soft));
  }
  .sunday-theme {
    font-family: var(--font-display);
    font-size: var(--text-lg, 1.125rem);
    font-style: italic;
    line-height: 1.25;
    color: var(--ink);
  }
  .sunday-label {
    margin-block-end: 0.375rem;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
