---
/**
 * Internal pages (noindex, excluded from the sitemap): the brand board (and later the UI gallery).
 * Astro ignores files starting with "_", so these paths come from getStaticPaths.
 */
import { locales } from '@eec/i18n'
import Mark from '@eec/ui/astro/Mark.astro'
import BrandColour from '../../components/brand/BrandColour.astro'
import BrandIcons from '../../components/brand/BrandIcons.astro'
import BrandLogo from '../../components/brand/BrandLogo.astro'
import BrandShape from '../../components/brand/BrandShape.astro'
import BrandType from '../../components/brand/BrandType.astro'
import ThemeToggle from '../../components/ThemeToggle.astro'
import Base from '../../layouts/Base.astro'
import { localeOf, useT } from '../../lib/i18n'

export function getStaticPaths() {
  return locales.flatMap((locale) => [{ params: { locale, internal: '_brand' } }])
}

const locale = localeOf(Astro.currentLocale)
const t = useT(locale)
const other = locale === 'fr' ? 'en' : 'fr'
const alternates = Object.fromEntries(locales.map((l) => [l, `/${l}/_brand/`]))
const toc = [
  ['logo', 'brand.logo.title'],
  ['colour', 'brand.colour.title'],
  ['type', 'brand.type.title'],
  ['shape', 'brand.shape.title'],
  ['icons', 'brand.icons.title'],
] as const
---

<Base title={t('brand.title')} noindex alternates={alternates}>
  <header class="sticky top-0 z-10 border-b border-line bg-bg/90 backdrop-blur">
    <div class="mx-auto flex max-w-7xl items-center gap-3 px-4 py-2 md:px-8">
      <Mark variant="mark" class="h-9 w-auto" />
      <p class="me-auto font-display text-lg leading-tight">
        {t('brand.title')}
        <span class="block font-sans text-xs text-ink-muted">{t('brand.status')}</span>
      </p>
      <a
        href={`/${other}/_brand/`}
        hreflang={other}
        lang={other}
        class="inline-flex min-h-11 items-center rounded-md px-3 text-sm font-medium hover:bg-surface-2"
        aria-label={t('common.language.switch_label')}
      >
        {t('common.language.switch_to')}
      </a>
      <ThemeToggle />
    </div>
  </header>

  <main id="main" class="mx-auto max-w-7xl px-4 pb-24 md:px-8">
    <div class="grid gap-4 py-12 md:py-16">
      <p class="inline-flex w-fit items-center gap-2 rounded-xs bg-gold-soft px-2 py-0.5 text-xs font-semibold text-gold-ink">
        {t('common.noindex_note')}
      </p>
      <h1 class="text-4xl">{t('brand.title')}</h1>
      <p class="max-w-[62ch] text-lg text-ink-muted">{t('brand.intro')}</p>
      <nav aria-label={t('brand.toc')} class="mt-2">
        <ul class="flex flex-wrap gap-2" role="list">
          {
            toc.map(([id, key]) => (
              <li>
                <a href={`#${id}`} class="inline-flex min-h-11 items-center rounded-sm border border-line px-4 text-sm font-medium hover:bg-surface-2">
                  {t(key)}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <BrandLogo />
    <BrandColour />
    <BrandType />
    <BrandShape />
    <BrandIcons />
  </main>
</Base>

<style is:global>
  :root {
    --font-fraunces: "Fraunces", "Fraunces Fallback", "Fraunces Fallback Android", Georgia, serif;
    --font-zodiak: "Zodiak", "Zodiak Fallback", Georgia, serif;
    --font-gambetta: "Gambetta", "Gambetta Fallback", Georgia, serif;
  }
  html {
    scroll-behavior: smooth;
  }
</style>
