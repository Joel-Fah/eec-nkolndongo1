---
import { locales } from '@eec/i18n'
/**
 * Internal pages (noindex, excluded from the sitemap, not linked): the living brand guidelines and
 * design-system documentation. Astro ignores files starting with "_", so these paths come from
 * getStaticPaths. Everything new in the design system is documented here.
 */
import Icon from '@eec/ui/astro/Icon.astro'
import Mark from '@eec/ui/astro/Mark.astro'
import BrandColour from '../../components/brand/BrandColour.astro'
import BrandComponents from '../../components/brand/BrandComponents.astro'
import BrandCredits from '../../components/brand/BrandCredits.astro'
import BrandIcons from '../../components/brand/BrandIcons.astro'
import BrandIdentity from '../../components/brand/BrandIdentity.astro'
import BrandLogo from '../../components/brand/BrandLogo.astro'
import BrandMotion from '../../components/brand/BrandMotion.astro'
import BrandPatterns from '../../components/brand/BrandPatterns.astro'
import BrandRules from '../../components/brand/BrandRules.astro'
import BrandShape from '../../components/brand/BrandShape.astro'
import BrandSocial from '../../components/brand/BrandSocial.astro'
import BrandType from '../../components/brand/BrandType.astro'
import BrandVoice from '../../components/brand/BrandVoice.astro'
import ThemeToggle from '../../components/ThemeToggle.astro'
import Base from '../../layouts/Base.astro'
import { localeOf, useT } from '../../lib/i18n'

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale, internal: '_brand' } }))
}

const locale = localeOf(Astro.currentLocale)
const t = useT(locale)
const other = locale === 'fr' ? 'en' : 'fr'
const alternates = Object.fromEntries(locales.map((l) => [l, `/${l}/_brand/`]))
const toc = [
  ['identity', 'brand.nav.identity'],
  ['voice', 'brand.nav.voice'],
  ['logo', 'brand.nav.logo'],
  ['colour', 'brand.nav.colour'],
  ['type', 'brand.nav.type'],
  ['shape', 'brand.nav.shape'],
  ['motion', 'brand.nav.motion'],
  ['icons', 'brand.nav.icons'],
  ['components', 'brand.nav.components'],
  ['patterns', 'brand.nav.patterns'],
  ['social', 'brand.nav.social'],
  ['rules', 'brand.nav.rules'],
  ['credits', 'brand.nav.credits'],
] as const
---

<Base title={t('brand.title')} noindex alternates={alternates}>
  <header class="sticky top-0 z-20 bg-bg/90 shadow-1 backdrop-blur">
    <div class="mx-auto flex max-w-[88rem] items-center gap-3 px-4 py-2 md:px-8">
      <Mark variant="mark" class="h-9 w-auto" />
      <p class="me-auto font-display text-lg leading-tight">
        {t('brand.title')}
        <span class="block font-sans text-xs text-ink-muted">{t('brand.page.status')}</span>
      </p>
      <button type="button" class="brand-search-open" data-brand-search-open aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K">
        <Icon name="search" size={20} />
        <span class="brand-search-open-text">{t('brand.search.open')}</span>
        <kbd class="brand-kbd">Ctrl K</kbd>
      </button>
      <a
        href={`/${other}/_brand/`}
        hreflang={other}
        lang={other}
        class="inline-flex min-h-11 items-center rounded-md px-3 text-sm font-medium hover:bg-surface-2"
        aria-label={t('common.language.switch_label')}
      >
        {t('common.language.switch_to')}
      </a>
      <ThemeToggle />
    </div>
  </header>

  <div class="mx-auto grid max-w-[88rem] gap-10 px-4 md:px-8 lg:grid-cols-[14rem_minmax(0,1fr)]">
    <nav aria-label={t('brand.toc')} class="hidden lg:block">
      <div class="brand-toc" data-toc>
        <p class="toc-title">{t('brand.title')}</p>
        <ul role="list" class="toc-list">
          {
            toc.map(([id, key]) => (
              <li data-toc-item={id}>
                <a href={`#${id}`} class="toc-link">{t(key)}</a>
                <div class="toc-sub"><ul class="toc-sub-list" role="list" /></div>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>

    <main id="main" class="min-w-0 pb-24">
      <div class="grid gap-4 py-12 md:py-16">
        <p class="w-fit rounded-xs bg-gold-soft px-2 py-0.5 text-xs font-semibold text-gold-ink">{t('common.noindex_note')}</p>
        <h1 class="text-4xl">{t('brand.title')}</h1>
        <p class="max-w-[62ch] text-lg text-ink-muted">{t('brand.page.intro')}</p>
        <p class="max-w-[62ch] text-sm text-ink-muted">{t('brand.page.private_note')}</p>
        <nav aria-label={t('brand.toc')} class="lg:hidden">
          <ul class="flex flex-wrap gap-2" role="list">
            {
              toc.map(([id, key]) => (
                <li>
                  <a href={`#${id}`} class="inline-flex min-h-11 items-center rounded-sm bg-surface px-4 text-sm font-medium shadow-1">
                    {t(key)}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      <BrandIdentity />
      <BrandVoice />
      <BrandLogo />
      <BrandColour />
      <BrandType />
      <BrandShape />
      <BrandMotion />
      <BrandIcons />
      <BrandComponents />
      <BrandPatterns />
      <BrandSocial />
      <BrandRules />
      <BrandCredits />
    </main>
  </div>
  <dialog class="dialog brand-search" data-brand-search aria-label={t('brand.search.open')}>
    <div class="brand-search-box">
      <div class="input-wrap">
        <span class="input-icon" aria-hidden="true"><Icon name="search" size={20} /></span>
        <input class="input" data-icon type="search" role="combobox" aria-expanded="true" aria-controls="brand-search-list" aria-autocomplete="list" placeholder={t('brand.search.placeholder')} aria-label={t('brand.search.open')} autocomplete="off" spellcheck="false" data-brand-search-input />
      </div>
      <ul id="brand-search-list" class="brand-search-list" role="listbox" data-brand-search-list />
      <p class="brand-search-empty" data-brand-search-empty hidden>{t('brand.search.empty')}</p>
      <p class="brand-search-hint">{t('brand.search.hint')}</p>
    </div>
  </dialog>
</Base>

<script>
  import { initBrandSearch } from '../../scripts/brand-search'
  import { initBrandToc } from '../../scripts/brand-toc'
  initBrandToc()
  initBrandSearch()
</script>

<style is:global>
  .brand-search-open {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: var(--text-sm);
    color: var(--ink-muted);
    cursor: pointer;
  }
  .brand-search-open:hover {
    background: var(--surface-2);
  }
  .brand-kbd {
    padding: 0.125rem 0.375rem;
    border-radius: var(--radius-xs);
    background: var(--surface-2);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
  }
  @media (max-width: 40rem) {
    .brand-search-open-text,
    .brand-kbd {
      display: none;
    }
  }
  .brand-search {
    width: min(40rem, calc(100vw - 2rem));
    margin-block-start: 10vh;
    padding: 0;
    overflow: visible;
  }
  .brand-search-box {
    display: grid;
    gap: 0.75rem;
    padding: 1rem;
  }
  .brand-search-list {
    display: grid;
    gap: 0.125rem;
    max-height: 50dvh;
    overflow-y: auto;
  }
  .brand-search-item {
    display: grid;
    gap: 0.125rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-md);
    cursor: pointer;
  }
  .brand-search-item[aria-selected="true"] {
    background: var(--primary-soft);
  }
  .brand-search-item small {
    color: var(--ink-muted);
  }
  .brand-search-empty,
  .brand-search-hint {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  .brand-found {
    animation: brand-found 1.6s var(--ease-soft);
  }
  @keyframes brand-found {
    0%,
    60% {
      box-shadow: 0 0 0 4px color-mix(in oklab, var(--gold) 70%, transparent);
    }
  }
  .brand-toc {
    position: sticky;
    inset-block-start: 6.25rem;
    max-height: calc(100dvh - 7.5rem);
    overflow-y: auto;
    padding: 0.75rem;
    border-radius: var(--radius-xl);
    background: var(--surface);
    box-shadow: var(--elevation-1);
  }
  .toc-title {
    max-height: 0;
    margin: 0;
    padding-inline: 0.75rem;
    overflow: hidden;
    opacity: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: 1.2;
    transition:
      max-height var(--duration-nav) var(--ease-soft),
      opacity var(--duration-nav) var(--ease-soft),
      margin var(--duration-nav) var(--ease-soft);
  }
  .brand-toc[data-title] .toc-title {
    max-height: 3rem;
    margin-block: 0.25rem 0.5rem;
    opacity: 1;
  }
  .toc-list {
    display: grid;
    gap: 0.125rem;
  }
  .toc-link,
  .toc-sublink {
    display: flex;
    align-items: center;
    border-radius: var(--radius-md);
    color: var(--ink);
    text-decoration: none;
    transition:
      background-color var(--duration-ui) var(--ease-soft),
      color var(--duration-ui) var(--ease-soft);
  }
  .toc-link {
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    font-size: var(--text-sm);
    font-weight: 500;
  }
  .toc-sublink {
    min-height: 2.25rem;
    padding-inline: 1.5rem 0.75rem;
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }
  .toc-link:hover,
  .toc-sublink:hover {
    background: var(--surface-2);
  }
  .toc-link[aria-current="true"],
  .toc-sublink[aria-current="true"] {
    background: var(--primary-soft);
    color: var(--primary);
    font-weight: 600;
  }
  .toc-sub {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--duration-nav) var(--ease-soft);
  }
  .toc-sub > .toc-sub-list {
    min-height: 0;
    overflow: hidden;
  }
  [data-toc-item][data-active] > .toc-sub {
    grid-template-rows: 1fr;
  }
  [data-toc-item][data-active] > .toc-sub > .toc-sub-list {
    display: grid;
    gap: 0.125rem;
    padding-block: 0.25rem 0.375rem;
  }
  html {
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
