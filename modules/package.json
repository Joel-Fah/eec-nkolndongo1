{
  "name": "@eec/modules",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./registry.ts",
    "./api": "./api.ts",
    "./admin": "./admin.ts",
    "./search": "./search.ts"
  },
  "scripts": {
    "lint": "biome check .",
    "typecheck": "tsc",
    "test": "vitest run",
    "db:seed": "node --env-file-if-exists=../.env.local --dns-result-order=ipv4first cli/seed.ts",
    "bible:seed": "node --env-file-if-exists=../.env.local --dns-result-order=ipv4first cli/seed-bible.ts",
    "content:seed-dev": "node --env-file-if-exists=../.env.local cli/seed-dev-content.ts",
    "grants:report": "node cli/grants-report.ts"
  },
  "dependencies": {
    "@eec/api-kit": "workspace:*",
    "@eec/auth": "workspace:*",
    "@eec/core": "workspace:*",
    "@eec/db": "workspace:*",
    "@eec/module-announcements": "workspace:*",
    "@eec/module-communion": "workspace:*",
    "@eec/module-contact": "workspace:*",
    "@eec/module-departments": "workspace:*",
    "@eec/module-guides": "workspace:*",
    "@eec/module-legal": "workspace:*",
    "@eec/module-liturgy": "workspace:*",
    "@eec/module-media": "workspace:*",
    "@eec/module-events": "workspace:*",
    "@eec/module-members": "workspace:*",
    "@eec/module-news": "workspace:*",
    "@eec/module-sermons": "workspace:*",
    "@eec/module-meditations": "workspace:*",
    "@eec/module-bulletin": "workspace:*",
    "@eec/module-registrations": "workspace:*",
    "@eec/module-campaigns": "workspace:*",
    "@eec/module-sundays": "workspace:*",
    "@eec/module-story": "workspace:*",
    "@eec/module-schedule": "workspace:*",
    "@eec/module-settings": "workspace:*",
    "@eec/modules-kit": "workspace:*",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "react": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "@eec/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
