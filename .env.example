# Copy to `.env.local` (gitignored) — or just run `neon env pull --branch dev --file .env.local`.
# NEVER commit real values and never paste them in chat. Local work always uses the `dev` branch.

# ── Filled by Neon (`neon deploy` / `neon env pull`) ────────────────────────────────────
# Pooled connection (app traffic where a pooler is wanted).
DATABASE_URL=
# Direct, non-pooled connection: migrations, seed, scripts, and Cloudflare Hyperdrive.
DATABASE_URL_UNPOOLED=
# Which Neon branch these values belong to (dev | production).
NEON_BRANCH=
# Object storage (S3-compatible; buckets eec-media and eec-backups, both private).
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Added by hand ───────────────────────────────────────────────────────────────────────
# Session signing secret. Generate once:  openssl rand -base64 32   (a different one per environment)
AUTH_SECRET=
# Pexels API key: the admin's stock-photo tab (Médiathèque) and the curation scripts. Dev: .env.local. Production (later):
# a Worker secret. The live site itself never calls Pexels.
PEXELS_API_KEY=
# The single origin the site is served from. Local gateway (later: the workers.dev URL).
APP_ORIGIN=http://localhost:8080

# Google sign-in for members (Google Cloud Console → Credentials → OAuth client, type "Web application").
# Authorized redirect URIs: http://localhost:8080/api/auth/callback/google and, later, https://<site>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the admin lives. Default: admin (→ /admin/). Pick something less obvious in production so nobody lands
# there by accident. « gestion », « gestion/ », « /gestion » and « /gestion/ » all mean the same thing.
# Read at build time (admin app) and at runtime (API links, dev gateway); set it as a Worker var too.
ADMIN_PATH=admin

# Media library bucket (default eec-media). Neon's buckets belong to a branch: dev has its own.
MEDIA_BUCKET=eec-media
# Backups: the PUBLIC age key (age1…). The private key stays offline with the person in charge, never here or in CI.
BACKUP_AGE_RECIPIENT=
# Build-time switch: 1 = launched (indexable). Anything else = « noindex » everywhere plus a ribbon.
SITE_INDEXABLE=0
