# Copy to `.env.local` (gitignored) — or just run `neon env pull --branch dev --file .env.local`.
# NEVER commit real values and never paste them in chat. Local work always uses the `dev` branch.

# ── Filled by Neon (`neon deploy` / `neon env pull`) ────────────────────────────────────
# Pooled connection (app traffic where a pooler is wanted).
DATABASE_URL=
# Direct, non-pooled connection: migrations, seed, scripts, and Cloudflare Hyperdrive.
DATABASE_URL_UNPOOLED=
# Which Neon branch these values belong to (dev | production).
NEON_BRANCH=
# Object storage (S3-compatible; buckets eec-media and eec-backups, both private).
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Added by hand ───────────────────────────────────────────────────────────────────────
# Session signing secret. Generate once:  openssl rand -base64 32   (a different one per environment)
AUTH_SECRET=
# Pexels API key (placeholder photo curation only).
PEXELS_API_KEY=
# The single origin the site is served from. Local gateway (later: the workers.dev URL).
APP_ORIGIN=http://localhost:8080
